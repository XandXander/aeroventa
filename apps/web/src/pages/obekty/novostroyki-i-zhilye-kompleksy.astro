---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ObjectDetailPage from '@/components/pages/ObjectDetailPage.astro';
import type { ContentRecord } from '@/lib/types';

const content: ContentRecord = {
  path:'/obekty/novostroyki-i-zhilye-kompleksy/',
  title:'Вентиляция новостроек и жилых комплексов — AEROVENTA',
  h1:'Монтаж вентиляции в новостройках и жилых комплексах',
  content_type:'landing',
  business_role:'CORE_VENTILATION',
  status:'fixture_stub',
  robots_index:false,
  robots_follow:true,
  sitemap_include:false,
  knowledge_allowed:true,
  ai_origin:false,
  seo_title:'Монтаж вентиляции в новостройках и жилых комплексах — AEROVENTA',
  seo_description:'Монтаж вентиляции в новостройках и жилых комплексах: работа по проекту, последовательность по корпусам, координация со смежными подрядчиками и контроль качества монтажа.',
  excerpt:'',
  body_html:'',
  body_html_safety_status:'not_applicable',
  owner_approved_at:null,
};

const constraints = [
  ['01','Повторяемый объём','Одна и та же ошибка на повторяемом узле быстро масштабируется. Поэтому важна фиксация решения до тиражирования.'],
  ['02','Последовательность по корпусам','Готовность помещений, потолков и смежных работ влияет на то, где бригада реально может работать без простоев.'],
  ['03','Логистика','Материалы, подъём, хранение и перемещение между секциями/домами становятся частью монтажной организации.'],
  ['04','Усиление команды','Большой график требует не просто “больше людей”, а управляемого усиления без потери контроля качества и изменений.'],
];

const drivers = [
  'Проект, спецификация и повторяемость узлов',
  'Количество корпусов / секций / повторяемых зон',
  'Готовность фронта работ по каждому участку',
  'Объём воздуховодов и оборудования',
  'Высота, доступ и подъём материалов',
  'Последовательность со смежными работами',
  'Сроки и допустимое параллельное выполнение',
  'Количество и влияние проектных изменений',
];

const questions = [
  'Какие исходные данные нужны для расчёта большого повторяемого объёма?',
  'Как фиксировать изменения, чтобы не размножить ошибку?',
  'Что влияет на срок кроме количества монтажников?',
  'Что должно быть согласовано до начала работ по корпусу?',
  'Какие участки стоит принимать до закрытия?',
];
---

<BaseLayout content={content}>
  <ObjectDetailPage
    content={content}
    eyebrow="Новостройки и жилые комплексы"
    lede="Повторяемый объём требует управляемого монтажа, понятной последовательности и контроля изменений по корпусам и участкам. Ошибки типовых узлов необходимо выявлять до их повторения на других участках."
    constraints={constraints}
    drivers={drivers}
    evidence={[]}
    questions={questions}
    proofTitle=""
    visualVariant="residential"
    heroMedia={{ src:'/evidence/residential/owner-modern-building-20261009.webp', alt:'Архитектурная иллюстрация современного жилого комплекса, не фотография выполненного объекта AEROVENTA', caption:'Архитектурная иллюстрация / не фотография выполненного объекта' }}
  />
</BaseLayout>
