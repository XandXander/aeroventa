---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { ContentRecord } from '@/lib/types';

const content: ContentRecord = {
  path: '/obekty/',
  title: 'Объекты — AEROVENTA',
  h1: 'Вентиляция под конкретный объект',
  content_type: 'landing',
  business_role: 'CORE_SERVICE_HUB',
  status: 'fixture_stub',
  robots_index: false,
  robots_follow: true,
  sitemap_include: false,
  knowledge_allowed: true,
  ai_origin: false,
  seo_title: 'Монтаж вентиляции по типу объекта — AEROVENTA',
  seo_description: 'Монтаж вентиляции для ресторанов и кафе, новостроек, производства, квартир, домов, складов и коммерческих помещений. Особенности объектов, фотографии и выполненные работы AEROVENTA.',
  excerpt: '',
  body_html: '',
  body_html_safety_status: 'not_applicable',
  owner_approved_at: null,
};

const objects = [
  {
    id:'production', index:'01', title:'Производство',
    text:'Режим предприятия, проект, оборудование и доступ к монтажным зонам.',
    proof:'НТФФ «Полисан» — фармацевтическое предприятие.',
    image:'/evidence/polisan/owner-cover-v43.webp',
    imageAlt:'Реальный производственный объект НТФФ Полисан', href:'/obekty/proizvodstvo/'
  },
  {
    id:'restaurants', index:'02', title:'Рестораны и кафе',
    text:'Назначение помещений, проектная документация и стадии монтажа.',
    proof:'Леонтьевский Мыс + кафе на Римского-Корсакова, 3.',
    image:'/evidence/leont/owner-cover-v43.webp',
    imageAlt:'Здание ЖК Леонтьевский Мыс, где расположен ресторанный объект', href:'/obekty/restorany-i-kafe/'
  },
  {
    id:'newbuilds', index:'03', title:'Новостройки и жилые комплексы',
    text:'Работа по корпусам, повторяющийся объём и контроль исполнения.',
    proof:'ЖК «Аквилон» · Янино: реальный жилой объект с монтажными фотографиями.',
    image:'/evidence/owner-portfolio/akvilon-yanino/cover.webp',
    imageAlt:'Фотография жилого корпуса комплекса «Аквилон» в Янино', href:'/obekty/novostroyki/'
  },
  {
    id:'private', index:'04', title:'Квартиры и дома',
    text:'Шум, пространство, отделка, потолки и аккуратная прокладка трасс.',
    proof:'Квартира на Маршала Жукова — монтаж приточно-вытяжной вентиляции.',
    image:'/evidence/zhukov/owner-cover-v43.webp',
    imageAlt:'Жилой дом с квартирным объектом AEROVENTA на Маршала Жукова', href:'/obekty/kvartiry-i-doma/'
  },
  {
    id:'warehouses', index:'05', title:'Магазины и склады',
    text:'Высота помещений, условия доступа и график работ.',
    proof:'Складской объект в Разбегаево: монтажные фотографии и вид здания.',
    image:'/evidence/warehouses/avers-razbegaevo/01.webp',
    imageAlt:'Складской объект в Разбегаево',
    href:'/obekty/magaziny-i-sklady/'
  },
  {
    id:'commercial', index:'06', title:'Офисы и коммерческие помещения',
    text:'Планировка, доступ к монтажным зонам, график работ и проектная документация.',
    proof:'Апарт-отель и коворкинг на Бумажном · Санкт-Петербург.',
    image:'/evidence/owner-portfolio/apart-hotel/cover.webp',
    imageAlt:'Интерьер апарт-отеля и коворкинга на Бумажном',
    href:'/obekty/ofisy-i-kommerciya/'
  },
];
---

<BaseLayout content={content}>
  <article class="objects-hub av-page av-object-index">
    <div class="av-object-index-opening">
    <header class="av-shell av-object-index__intro"><div><p class="av-kicker">Монтаж по типу объекта</p><h1>Вентиляция под конкретный объект</h1></div><div><p class="av-lead">У квартиры, ресторана и производства — разные условия монтажа.</p><p>Выберите свой тип объекта: покажем выполненные работы и данные, которые нужны для обсуждения задачи.</p><p class="av-geo">Санкт-Петербург и Ленинградская область · Москва · Карелия</p></div></header>
    <section class="av-shell av-object-index__grid" aria-label="Типы объектов">{objects.slice(0,2).map(item=><a href={item.href} class="av-object-index__item"><figure><img src={item.image} alt={item.imageAlt} width="800" height="500" loading="eager" decoding="async"/></figure><div><span>{item.index}</span><h2>{item.title}</h2><p>{item.text}</p><b>Условия и выполненные работы ↗</b></div></a>)}</section>
    </div>
    <section class="av-shell av-object-index__grid" aria-label="Типы объектов">{objects.slice(2).map(item=><a href={item.href} class="av-object-index__item"><figure><img src={item.image} alt={item.imageAlt} width="800" height="500" loading="lazy" decoding="async"/></figure><div><span>{item.index}</span><h2>{item.title}</h2><p>{item.text}</p><b>Условия и выполненные работы ↗</b></div></a>)}</section>
    <section class="av-close"><div class="av-shell av-close__grid"><div><p class="av-kicker">Ваш объект</p><h2>Есть задача по вентиляции?</h2></div><a href="/contact/" class="button button--primary" data-contact-open data-source="objects_hub">Обсудить объект →</a></div></section>
  </article>
</BaseLayout>
