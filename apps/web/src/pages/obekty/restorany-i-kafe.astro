---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ObjectDetailPage from '@/components/pages/ObjectDetailPage.astro';
import type { ContentRecord } from '@/lib/types';

const content: ContentRecord = {
  path:'/obekty/restorany-i-kafe/',
  title:'Вентиляция ресторанов и кафе — AEROVENTA',
  h1:'Монтаж вентиляции в ресторанах и кафе',
  content_type:'landing',
  business_role:'CORE_VENTILATION',
  status:'fixture_stub',
  robots_index:false,
  robots_follow:true,
  sitemap_include:false,
  knowledge_allowed:true,
  ai_origin:false,
  seo_title:'Монтаж вентиляции ресторанов и кафе в СПб — AEROVENTA',
  seo_description:'Монтаж систем вентиляции в ресторанах и кафе: работа по проекту, координация трасс и оборудования, реальные объекты AEROVENTA в Санкт-Петербурге.',
  excerpt:'',
  body_html:'',
  body_html_safety_status:'not_applicable',
  owner_approved_at:null,
};

const constraints = [
  ['01','Кухня и зал — не одна зона','Монтажный состав работ зависит от того, какие помещения и узлы обслуживает система; не сводим объект к одному общему “воздухообмену ресторана”.'],
  ['02','Трассы и потолки','Расположение оборудования и воздуховодов связано с интерьером, потолками, конструкциями и другими подрядчиками.'],
  ['03','Стадия отделки','Чем позже меняется трасса или точка подключения, тем выше риск переделок и повреждения готовой отделки.'],
  ['04','Доступ и режим работ','На действующем или почти готовом объекте важны окна работ, защита поверхностей, складирование и маршрут заноса оборудования.'],
];

const drivers = [
  'Наличие и полнота проекта / спецификации',
  'Состав и количество вентиляционного оборудования',
  'Длины, сечения и фактические трассы',
  'Высота, потолки и доступ к месту монтажа',
  'Текущая стадия отделки',
  'Интерфейсы со смежными подрядчиками',
  'Рабочие окна и ограничения действующего объекта',
  'Необходимые проходки и смежные работы',
];

const evidence = [
  {title:'Ресторан в ЖК «Леонтьевский Мыс»',meta:'Санкт-Петербург',detail:'Приточно-вытяжная вентиляция + оборудование. Исторический источник: 2 недели.',href:'/blog/detail/restoran-v-zhk-leontevskiy-mys/',image:'/evidence/leont/duct-installation-01.jpg',imageAlt:'Ресторан Леонтьевский Мыс — фрагмент монтажа вентиляции'},
  {title:'Кафе на Римского-Корсакова, 3',meta:'Санкт-Петербург',detail:'Приточно-вытяжная вентиляция + оборудование. Исторический источник: 200 м², 5 дней.',href:'/blog/detail/kafe-rimskogo-korsakova-3/',image:'/evidence/cafe/duct-installation-01.jpg',imageAlt:'Кафе на Римского-Корсакова — фрагмент вентиляционной трассы'},
];

const questions = [
  'Что прислать для предварительного расчёта?',
  'Что должно быть решено до выхода монтажников?',
  'Как правильно сравнивать две сметы?',
  'Что делать, если проект конфликтует с реальным объектом?',
  'Что меняется, если отделка уже началась?',
];
---

<BaseLayout content={content}>
  <ObjectDetailPage
    content={content}
    eyebrow="Рестораны и кафе"
    lede="Сначала разбираем помещения, трассы, существующий проект и ограничения объекта. Затем определяем реальный состав монтажных работ — без универсальной схемы «для общепита»."
    constraints={constraints}
    drivers={drivers}
    evidence={evidence}
    questions={questions}
    proofTitle="Два реальных ресторанных объекта — вместо типовой картинки."
    visualVariant="restaurants"
    heroMedia={{ src:'/evidence/leont/duct-installation-02.jpg', alt:'Реальная монтажная фотография — ресторан в ЖК «Леонтьевский Мыс»', caption:'Ресторан в ЖК «Леонтьевский Мыс» / Монтажная фотография' }}
  />
</BaseLayout>
