---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ObjectDetailPage from '@/components/pages/ObjectDetailPage.astro';
import type { ContentRecord } from '@/lib/types';

const content: ContentRecord = {
  path:'/obekty/restorany-i-kafe/',
  title:'Вентиляция ресторанов и кафе — AEROVENTA',
  h1:'Монтаж вентиляции в ресторанах и кафе',
  content_type:'landing',
  business_role:'CORE_VENTILATION',
  status:'fixture_stub',
  robots_index:false,
  robots_follow:true,
  sitemap_include:false,
  knowledge_allowed:true,
  ai_origin:false,
  seo_title:'Монтаж вентиляции ресторанов и кафе в СПб — AEROVENTA',
  seo_description:'Монтаж систем вентиляции в ресторанах и кафе: работа по проекту, координация трасс и оборудования, реальные объекты AEROVENTA в Санкт-Петербурге.',
  excerpt:'',
  body_html:'',
  body_html_safety_status:'not_applicable',
  owner_approved_at:null,
};

const constraints = [
  ['01','Назначение помещений','Состав монтажа определяется проектными решениями для кухни, зала и вспомогательных помещений.'],
  ['02','Трассы и потолки','Размещение оборудования и воздуховодов согласуют с потолками, конструкциями и другими инженерными системами.'],
  ['03','Стадия отделки','Стадию отделки учитываем при выборе порядка монтажа, согласовании проходок и доступа к трассам.'],
  ['04','Доступ и режим работ','На действующем или почти готовом объекте важны окна работ, защита поверхностей, складирование и маршрут заноса оборудования.'],
];

const drivers = [
  'Наличие и полнота проекта / спецификации',
  'Места установки, масса и способы крепления оборудования',
  'Длины, сечения и фактические трассы',
  'Высота, потолки и доступ к месту монтажа',
  'Текущая стадия отделки',
  'Согласование трасс со смежными работами',
  'Рабочий график и особенности действующего объекта',
  'Необходимые проходки и смежные работы',
];

const evidence = [
  {title:'Ресторан в ЖК «Леонтьевский Мыс»',meta:'Санкт-Петербург',detail:'Приточно-вытяжная вентиляция + оборудование. Монтаж · 2 недели.',href:'/blog/detail/restoran-v-zhk-leontevskiy-mys/',image:'/evidence/leont/owner-cover-v43.webp',imageAlt:'Ресторан в ЖК «Леонтьевский Мыс» — фотография объекта'},
  {title:'Кафе на Римского-Корсакова, 3',meta:'Санкт-Петербург',detail:'Приточно-вытяжная вентиляция + оборудование. Площадь · 200 м², монтаж · 5 дней.',href:'/blog/detail/kafe-rimskogo-korsakova-3/',image:'/evidence/cafe/owner-cover-v43.webp',imageAlt:'Кафе на Римского-Корсакова, 3 — фотография объекта'},
];

const questions = [
  'Что прислать для предварительного расчёта?',
  'Что должно быть решено до выхода монтажников?',
  'Как правильно сравнивать две сметы?',
  'Что делать, если проект конфликтует с реальным объектом?',
  'Что меняется, если отделка уже началась?',
];
---

<BaseLayout content={content}>
  <ObjectDetailPage
    content={content}
    eyebrow="Рестораны и кафе"
    lede="Для ресторана или кафе учитываем планировку кухни и зала, оборудование, проект и стадию отделки. По этим данным определяем состав монтажных работ."
    constraints={constraints}
    drivers={drivers}
    evidence={evidence}
    questions={questions}
    proofTitle="Вентиляция ресторанов и кафе: выполненные работы"
    visualVariant="restaurants"
    heroMedia={{ src:'/evidence/leont/owner-cover-v43.webp', alt:'Архитектурный вид ЖК «Леонтьевский Мыс», где расположен ресторан из портфолио AEROVENTA', caption:'ЖК «Леонтьевский Мыс» · архитектурный контекст ресторана' }}
  />
</BaseLayout>
