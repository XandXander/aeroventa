---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getStaticPageContent } from '@/lib/content-source';
import ObjectDetailPage from '@/components/pages/ObjectDetailPage.astro';
import sourcePhotos from '../../../../../migration/owner-category-source-media-2026-10-26.json';
import type { ContentRecord } from '@/lib/types';
const baselineContent: ContentRecord = {
 path:'/obekty/ofisy-i-kommerciya/',title:'Монтаж вентиляции офисов и коммерческих помещений — AEROVENTA',h1:'Монтаж вентиляции офисов и коммерческих помещений',
 content_type:'landing',business_role:'CORE_SERVICE_HUB',status:'fixture_stub',
 robots_index:false,robots_follow:true,sitemap_include:false,knowledge_allowed:true,ai_origin:false,
 seo_title:'Монтаж вентиляции офисов и коммерческих помещений — AEROVENTA',seo_description:'Офисы, коворкинги и коммерческие объекты. Реальные фотографии выполненных объектов AEROVENTA.',
 excerpt:'',body_html:'',body_html_safety_status:'not_applicable',owner_approved_at:null
};
const constraints:[string,string,string][] = [["01","Интерьер","Крепления и трассы согласовывают с архитектурой."],["02","График","Условия доступа определяются режимом помещения."],["03","Смежные сети","Потолки и инженерные системы должны быть согласованы."],["04","Обслуживание","Доступ к оборудованию предусматривается заранее."]];
const fitness=sourcePhotos.objects.find(item=>item.slug==='fitness-spb'),office=sourcePhotos.objects.find(item=>item.slug==='leont-office');
if(!fitness||fitness.gallery.length!==5||!office||office.gallery.length!==15)throw Error('Owner fitness and Leont office albums must remain complete');
const evidence = [
 {title:'Фитнес-студия СПб',meta:'Фитнес-студия · Санкт-Петербург',detail:'Интерьер студии и фотографии вентиляционных коммуникаций.',href:'#object-photo-dialog',image:fitness.cover,imageAlt:'Интерьер фитнес-студии в Санкт-Петербурге',gallery:fitness.gallery},
 {title:'Офис в Леонтьевском Мысе',meta:'Офис · Санкт-Петербург',detail:'Здание, помещения офиса и фотографии инженерных коммуникаций.',href:'#object-photo-dialog',image:office.cover,imageAlt:'Здание, в котором расположен офис в Леонтьевском Мысе',gallery:office.gallery}
];
const drivers = ['Рабочая проектная документация и спецификация','Монтажные зоны и условия доступа','Стадия объекта и смежные инженерные системы','Оборудование, трассы и рабочие сроки'];
const questions = ['Какие документы передать для расчёта монтажа?','Что согласовать до начала работ?','Какие ограничения объекта влияют на организацию монтажа?'];
const content = await getStaticPageContent(baselineContent.path, baselineContent);
---
<BaseLayout content={content}>
 <ObjectDetailPage content={content} eyebrow="Офисы и коммерция"
  lede="Здесь важны не только трассы и оборудование, но и точная интеграция системы в пространство и отделку." constraints={constraints} drivers={drivers} evidence={evidence} questions={questions}
  proofTitle="Коммерческие объекты и инженерные системы"
  heroMedia={{src:'/evidence/owner-portfolio/apart-hotel/cover.webp',alt:'Реальный интерьер апарт-отеля и коворкинга',caption:'Апарт-отель и коворкинг · Санкт-Петербург',href:'/portfolio/obekt/apart-hotel/'}}/>
</BaseLayout>
