---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ObjectDetailPage from '@/components/pages/ObjectDetailPage.astro';
import type { ContentRecord } from '@/lib/types';
const content: ContentRecord = {
 path:'/obekty/proizvodstvo/',title:'Монтаж вентиляции на производственных объектах — AEROVENTA',h1:'Монтаж вентиляции на производственных объектах',
 content_type:'landing',business_role:'CORE_SERVICE_HUB',status:'fixture_stub',
 robots_index:false,robots_follow:true,sitemap_include:false,knowledge_allowed:true,ai_origin:false,
 seo_title:'Монтаж вентиляции на производственных объектах — AEROVENTA',seo_description:'Производственные системы вентиляции. Полисан и промышленный объект «Химпром».',
 excerpt:'',body_html:'',body_html_safety_status:'not_applicable',owner_approved_at:null
};
const constraints:[string,string,string][] = [["01","Режим производства","Очередность работ учитывает условия технологических участков."],["02","Трассы","Рабочие чертежи и спецификация определяют состав."],["03","Доступ","Монтажные зоны и оборудование согласовывают заранее."],["04","Сроки","Работы координируют со смежными подрядчиками."]];
const evidence = [
 {title:'Химпром',meta:'Промышленный объект · Санкт-Петербург',detail:'Фотографии производственного помещения и инженерных коммуникаций.',href:'/portfolio/obekt/himprom/',image:'/evidence/owner-portfolio/himprom/03.webp',imageAlt:'Производственное помещение объекта «Химпром»'},
 {title:'Новатех',meta:'Производственный объект · Московская область',detail:'Фотографии площадки, оборудования и монтажных узлов.',href:'/portfolio/obekt/novatech/',image:'/evidence/owner-portfolio/novatech/cover.webp',imageAlt:'Производственная площадка «Новатех»'}
];
const drivers = ['Рабочая проектная документация и спецификация','Монтажные зоны и условия доступа','Стадия объекта и смежные инженерные системы','Оборудование, трассы и рабочие сроки'];
const questions = ['Какие документы передать для расчёта монтажа?','Что согласовать до начала работ?','Какие ограничения объекта влияют на организацию монтажа?'];
---
<BaseLayout content={content}>
 <ObjectDetailPage content={content} eyebrow="Производственные объекты"
  lede="Монтаж по проекту с учётом рабочего режима площадки, доступа к оборудованию и требований смежных систем." constraints={constraints} drivers={drivers} evidence={evidence} questions={questions}
  proofTitle="Вентиляция на производственных площадках"
  heroMedia={{src:'/evidence/polisan/owner-cover-v43.webp',nativeWidth:1600,nativeHeight:903,alt:'Здание НТФФ «Полисан» в Санкт-Петербурге',caption:'НТФФ «Полисан» · фармацевтическое производство',href:'/blog/detail/ntff-polisan/'}}/>
</BaseLayout>
