---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LeadCTA from '@/components/LeadCTA.astro';
import { getAllContent } from '@/lib/content-source';
import type { ContentRecord } from '@/lib/types';

export async function getStaticPaths() {
  const all = await getAllContent();
  return all
    .filter((item) => item.path !== '/')
    .map((item) => ({
      params: { path: item.path.replace(/^\//, '').replace(/\/$/, '') },
      props: { content: item },
    }));
}

interface Props { content: ContentRecord; }
const { content } = Astro.props;
const fixture = content.status === 'fixture_stub';
const partnerDrilling = content.lead_intent === 'DRILLING_PARTNER';
---
<BaseLayout content={content}>
  <article class="page">
    <div class="container prose">
      <h1>{content.h1}</h1>
      {fixture && <div class="notice"><strong>Implementation fixture:</strong> исходный/новый контент ещё не прошёл миграцию и Owner approval. Эта сборка noindex.</div>}
      <Fragment set:html={content.body_html} />
      <LeadCTA intent={partnerDrilling ? 'DRILLING_PARTNER' : 'VENTILATION_PROJECT'} />
    </div>
  </article>
</BaseLayout>
