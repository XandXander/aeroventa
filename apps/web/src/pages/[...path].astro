---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageRenderer from '@/components/PageRenderer.astro';
import { getAllContent } from '@/lib/content-source';
import type { ContentRecord } from '@/lib/types';

export async function getStaticPaths() {
  const all = await getAllContent();
  return all
    .filter((item) => item.path !== '/')
    .map((item) => ({
      params: { path: item.path.replace(/^\//, '').replace(/\/$/, '') },
      props: { content: item },
    }));
}

interface Props { content: ContentRecord; }
const { content } = Astro.props;

const overrides: Record<string, Partial<ContentRecord>> = {
  '/montazh-ventiliacii/': {
    h1: 'Монтаж вентиляции в Санкт-Петербурге и Ленинградской области',
    seo_title: 'Монтаж вентиляции в Санкт-Петербурге и Ленинградской области — AEROVENTA',
    seo_description: 'Монтаж систем вентиляции для квартир, домов, ресторанов, коммерческих, производственных и крупных объектов. Работа по проекту или первичная оценка исходных данных, реальные кейсы AEROVENTA.',
  },
  '/services/': {
    h1: 'Что мы делаем по вентиляции',
    seo_title: 'Работы по вентиляции — AEROVENTA',
    seo_description: 'Монтаж вентиляции по готовому проекту, монтаж воздуховодов и оборудования, работа с объектами без проекта и координация смежных проходок.',
  },
  '/portfolio/': {
    h1: 'Реальные объекты и выполненные работы',
    seo_title: 'Объекты и проекты AEROVENTA — монтаж вентиляции',
    seo_description: 'Реальные объекты AEROVENTA: жилые комплексы, рестораны, производство, квартиры и работа в Карелии. Задачи, scope и подтверждённые исторические факты.',
  },
  '/faq/': {
    h1: 'Что важно решить до монтажа вентиляции',
    seo_title: 'Что важно решить до монтажа вентиляции — AEROVENTA',
    seo_description: 'Инженерные вопросы до расчёта, выбора системы, начала монтажа, сравнения смет и приёмки вентиляции. Конкретные ответы без шаблонного FAQ.',
  },
  '/about/': {
    h1: 'AEROVENTA — команда по монтажу вентиляции',
    seo_title: 'О компании AEROVENTA — монтаж вентиляции',
    seo_description: 'AEROVENTA — команда по монтажу вентиляции: личный контроль, усиление профильными специалистами под масштаб объекта, реальные проекты в Санкт-Петербурге, Ленобласти и Карелии.',
    schema_type: 'AboutPage',
  },
  '/contact/': {
    h1: 'Связаться с AEROVENTA',
    seo_title: 'Контакты AEROVENTA — монтаж вентиляции',
    seo_description: 'Связаться с AEROVENTA по монтажу вентиляции. Санкт-Петербург и Ленинградская область — основная зона работы; берём объекты в Москве и Карелии. Отправить проект или описать задачу.',
    schema_type: 'ContactPage',
  },
  '/blog/': {
    h1: 'Практика',
    seo_title: 'Практика AEROVENTA — инженерные материалы и реальные объекты',
    seo_description: 'Практические материалы AEROVENTA: инженерные вопросы, опыт с площадки и реальные объекты. Конкретные задачи вместо корпоративного блога.',
    schema_type: 'WebPage',
  },
  '/blog/poleznye-stati/': {
    h1: 'Практические материалы',
    seo_title: 'Практические материалы по вентиляции и смежным работам — AEROVENTA',
    seo_description: 'Практические разборы AEROVENTA: реальные полевые задачи, факторы стоимости, подготовка исходных данных и инженерные решения без SEO-шаблонов.',
    schema_type: 'WebPage',
  },
  '/blog/istorii-proektov/': {
    h1: 'Истории объектов',
    seo_title: 'Истории объектов AEROVENTA — реальные проекты вентиляции',
    seo_description: 'Истории реальных объектов AEROVENTA: жилые комплексы, ресторан, производство, квартира, кафе и работа в Карелии. Ссылки на канонические кейсы.',
    schema_type: 'WebPage',
  },
  '/blog/detail/kak-vytashchit-zastryavshuyu-koronku-iz-betona/': {
    h1: 'Как вытащить застрявшую алмазную коронку из бетона',
    seo_title: 'Как вытащить застрявшую алмазную коронку из бетона — причины и порядок действий',
    seo_description: 'Почему алмазная коронка заклинивает в бетоне, что делать сначала, когда нужен штатный съёмник или обратный молоток и какие ошибки могут повредить оборудование. Практический опыт AEROVENTA.',
    schema_type: 'Article',
  },
  '/blog/detail/almaznoe-burenie-v-styazhke-pod-stoyaki-otopleniya/': {
    h1: 'Алмазное бурение отверстий в стяжке под стояки отопления',
    seo_title: 'Алмазное бурение в стяжке под стояки отопления — реальный пример работ',
    seo_description: 'Как выполнялись отверстия под стояки отопления через стяжку, утепляющий слой и перекрытие на реальном объекте: разметка, крепление установки, защита отделки и работа с армирующей сеткой.',
    schema_type: 'Article',
  },
  '/blog/detail/stoimost-almaznogo-bureniya-kak-rasschitat-tsenu/': {
    h1: 'От чего зависит стоимость алмазного бурения',
    seo_title: 'Стоимость алмазного бурения: от чего зависит цена и что нужно для расчёта',
    seo_description: 'Диаметр, глубина, материал, армирование, доступ, высота, защита отделки и объём работ: какие данные реально влияют на стоимость алмазного бурения и что прислать для расчёта.',
    schema_type: 'Article',
  },
  '/blog/detail/gorizontalnoe-almaznoe-burenie/': {
    h1: 'Алмазное бурение стены под вентиляцию',
    seo_title: 'Алмазное бурение стены под вентиляцию — что учесть до отверстия',
    seo_description: 'Что нужно проверить перед отверстием под воздуховод: диаметр, толщина и материал стены, трасса, коммуникации, доступ и защита отделки. Реальный исторический пример AEROVENTA.',
    schema_type: 'Article',
  },
};

const pageContent: ContentRecord = {
  ...content,
  ...(overrides[content.path] ?? {}),
};
---
<BaseLayout content={pageContent}>
  <PageRenderer content={pageContent} />
</BaseLayout>
