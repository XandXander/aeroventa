---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageRenderer from '@/components/PageRenderer.astro';
import { getAllContent } from '@/lib/content-source';
import type { ContentRecord } from '@/lib/types';
import legacySources from '../../../../migration/legacy-page-source-index.json';

export async function getStaticPaths() {
  const all = await getAllContent();
  return all
    .filter((item) => item.path !== '/')
    .map((item) => ({
      params: { path: item.path.replace(/^\//, '').replace(/\/$/, '') },
      props: { content: item },
    }));
}

interface Props { content: ContentRecord; }
const { content } = Astro.props;

const overrides: Record<string, Partial<ContentRecord>> = {
