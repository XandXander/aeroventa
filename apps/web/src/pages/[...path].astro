    schema_type: 'Article',
  },
};

// SEO source lock: the retained article URL, H1 and title remain linked to the legacy primary index.
// Historical on-page procedures and prices are NOT restored by this metadata-only safeguard.
const legacyArticle = content.path.startsWith('/blog/detail/')
  ? legacySources.find(row => row.path === content.path && row.status === 200)
  : undefined;
if (content.path.startsWith('/blog/detail/') && (!legacyArticle?.h1 || !legacyArticle?.title)) {
  throw new Error(`Legacy indexed heading/title evidence missing for ${content.path}`);
}
// Approved CMS metadata must not be silently overwritten by historical source
// overrides. All existing fixture / draft-preview pages keep their locked output.
const approvedCmsContent = ['production', 'incremental'].includes(import.meta.env.AEROVENTA_RELEASE_MODE)
  && content.status === 'published' && Boolean(content.owner_approved_at);
const pageContent: ContentRecord = {
  ...content,
  ...(!approvedCmsContent ? (overrides[content.path] ?? {}) : {}),
  ...(!approvedCmsContent && legacyArticle ? { h1: legacyArticle.h1, seo_title: legacyArticle.title } : {}),
  // Owner J-07 authorises this public editorial correction; preserve legacy source bytes and URL.
  ...(!approvedCmsContent && content.path === '/blog/detail/ntff-polisan/' ? {
    h1: 'НТФФ «Полисан»',
    title: 'НТФФ «Полисан» — монтаж вентиляции | AEROVENTA',
    seo_title: 'НТФФ «Полисан» — монтаж вентиляции | AEROVENTA',
    og_title: 'НТФФ «Полисан» — монтаж вентиляции | AEROVENTA',
  } : {}),
};
---
<BaseLayout content={pageContent}>
  <PageRenderer content={pageContent} />
</BaseLayout>
