---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getByPath } from '@/lib/content-source';

const content = await getByPath('/');
if (!content) throw new Error('Home content is missing');

const page = {
  ...content,
  h1: 'Инженерная вентиляция без лишнего.',
  seo_title: 'Монтаж вентиляции в СПб и Ленобласти — AEROVENTA',
  seo_description: 'AEROVENTA — монтаж вентиляции для квартир, домов, ресторанов, коммерческих, производственных и крупных объектов. Санкт-Петербург и Ленинградская область; берём объекты в Москве и Карелии.',
};

const objects = [
  ['01', 'Квартиры / дома', '/obekty/#private'],
  ['02', 'Коттеджи / бани', '/obekty/#private'],
  ['03', 'Рестораны / кафе', '/obekty/restorany-i-kafe/'],
  ['04', 'Магазины / склады', '/obekty/#warehouses'],
  ['05', 'Производства', '/obekty/#production'],
  ['06', 'Новостройки', '/obekty/novostroyki-i-zhilye-kompleksy/'],
];

const questions = [
  'Можно ли понять бюджет без проекта?',
  'Как сравнивать две сметы на вентиляцию?',
  'Что должно быть решено до выхода монтажников?',
  'Что делать, если проект не совпадает с реальным объектом?',
  'Что проверить до закрытия потолков?',
];
---

<BaseLayout content={page}>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-shell home-hero__grid">
      <div class="home-hero__copy">
        <p class="home-kicker">Монтаж вентиляции под ключ</p>
        <h1 id="home-title">Инженерная вентиляция без лишнего.</h1>
        <p class="home-lede">
          От квартиры и дома до ресторана, склада и производства. Работаем по готовому проекту.
          Если проекта нет — определяем, какие исходные данные нужны для корректной сметы и монтажа.
        </p>
        <p class="home-geo">Санкт-Петербург · Ленинградская область · Москва · Карелия</p>
        <div class="home-actions" aria-label="Основные действия">
          <a class="button button--primary" href="/obekt-bez-gotovogo-proekta/" data-aeroventa-event="primary_cta">Получить ориентир стоимости <span aria-hidden="true">→</span></a>
          <a class="button button--ghost" href="/montazh-po-proektu/">Есть проект — запросить смету</a>
        </div>
      </div>

      <figure class="hero-engineering">
        <img
          class="hero-engineering__photo"
          src="/evidence/hero/engineering-ductwork.jpg"
          width="1280"
          height="533"
          alt="Металлические воздуховоды в инженерном пространстве"
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero-engineering__veil" aria-hidden="true"></div>
        <svg class="hero-engineering__overlay" viewBox="0 0 734 551" aria-hidden="true" focusable="false">
          <path class="hero-airflow-path hero-airflow-path--supply" d="M212 334 C184 360 157 391 126 426" />
          <path class="hero-airflow-tick hero-airflow-tick--supply" d="M171 376 l-9 2 3-8 M148 402 l-9 2 3-8" />
          <circle class="hero-airflow-node hero-airflow-node--supply" cx="212" cy="334" r="3" />

          <path class="hero-airflow-path hero-airflow-path--exhaust" d="M526 414 C551 388 570 357 589 323" />
          <path class="hero-airflow-tick hero-airflow-tick--exhaust" d="M552 382 l9-1 -3 8 M570 353 l9-1 -3 8" />
          <circle class="hero-airflow-node hero-airflow-node--exhaust" cx="526" cy="414" r="3" />
        </svg>
        <div class="hero-engineering__label hero-engineering__label--supply">
          <span>ПРИТОК</span><small>SUPPLY · схема потока</small>
        </div>
        <div class="hero-engineering__label hero-engineering__label--exhaust">
          <span>ВЫТЯЖКА</span><small>EXHAUST · схема потока</small>
        </div>
        <div class="hero-engineering__frame" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </div>
        <figcaption class="hero-engineering__evidence">
          <strong>РЕАЛЬНЫЙ МОНТАЖ · СХЕМА ПОТОКА</strong>
          <span class="sr-only">Реальная фотография смонтированных воздуховодов на объекте AEROVENTA. Цветные линии — схематическая визуализация приточного и вытяжного направления, а не исполнительная схема объекта.</span>
        </figcaption>
      </figure>
    </div>

    <nav class="object-ribbon home-shell" aria-label="Типы объектов">
      {objects.map(([number, label, href]) => (
        <a href={href} class="object-ribbon__item">
          <span class="object-ribbon__number">{number}</span>
          <span>{label}</span>
        </a>
      ))}
    </nav>
  </section>

  <section class="home-section home-solution" id="process" aria-labelledby="solution-title">
    <div class="home-shell solution-grid">
      <div class="section-copy">
        <p class="section-index">01 / Продуманное решение</p>
        <h2 id="solution-title">Система под объект, а не «по шаблону».</h2>
        <p>
          Состав монтажа определяем по задаче и условиям объекта. Учитываем реальные трассы,
          сечения, оборудование, доступ и требования — без избыточных решений и скрытого усложнения.
        </p>
        <div class="engagement-index engagement-index--compact">
          <a href="/montazh-po-proektu/">
            <span>01</span>
            <div><strong>Готовая проектная документация</strong><p>Проверим комплект, уточним объём работ и подготовим смету на монтаж.</p></div>
            <b aria-hidden="true">→</b>
          </a>
          <a href="/obekt-bez-gotovogo-proekta/">
            <span>02</span>
            <div><strong>Исходные данные ещё формируются</strong><p>Определим, какие данные нужны, чтобы корректно оценить монтаж.</p></div>
            <b aria-hidden="true">→</b>
          </a>
        </div>
      </div>

      <div class="solution-diagram" aria-hidden="true">
        <svg viewBox="0 0 680 420">
          <defs>
            <linearGradient id="solution-metal" x1="0" x2="1">
              <stop offset="0" stop-color="#bfc8ce"/>
              <stop offset=".48" stop-color="#eef1f3"/>
              <stop offset="1" stop-color="#a8b3bb"/>
            </linearGradient>
          </defs>

          <g class="solution-floor">
            <path d="M54 330 L232 212 H622 L468 330 Z"/>
            <path d="M104 330 L268 212 M168 330 L308 212 M238 330 L352 212 M310 330 L396 212 M385 330 L444 212 M460 330 L492 212 M536 330 L544 212"/>
            <path d="M92 305 H500 M128 278 H536 M166 251 H574 M205 225 H611"/>
          </g>

          <g class="solution-system solution-system--supply">
            <path class="solution-duct-outline" d="M82 92 H316 V198 H250"/>
            <path class="solution-duct" d="M82 92 H316 V198 H250"/>
            <path class="solution-flow" d="M82 92 H316 V198 H250"/>
            <path class="solution-tick" d="M192 86 l8 6 -8 6 M310 146 l6 8 6-8"/>
            <circle class="solution-anchor" cx="82" cy="92" r="5"/>
          </g>

          <g class="solution-system solution-system--exhaust">
            <path class="solution-duct-outline" d="M430 138 H600 V254 H532"/>
            <path class="solution-duct" d="M430 138 H600 V254 H532"/>
            <path class="solution-flow" d="M430 138 H600 V254 H532"/>
            <path class="solution-tick" d="M540 132 l-8 6 8 6 M594 207 l6-8 6 8"/>
            <circle class="solution-anchor" cx="430" cy="138" r="5"/>
          </g>

          <g class="solution-terminal">
            <rect x="204" y="201" width="92" height="38" rx="2"/>
            <path d="M216 213 H284 M216 221 H284 M216 229 H284"/>
          </g>
          <g class="solution-terminal">
            <rect x="486" y="257" width="92" height="38" rx="2"/>
            <path d="M498 269 H566 M498 277 H566 M498 285 H566"/>
          </g>

          <text class="solution-label solution-label--supply" x="82" y="68">Подача</text>
          <text class="solution-label solution-label--exhaust" x="430" y="114">Вытяжка</text>
          <text class="solution-room-label" x="222" y="372">Помещение</text>
          <text class="solution-room-label" x="474" y="372">Помещение</text>
        </svg>
      </div>
    </div>

    <div class="home-shell process-strip" aria-label="Этапы работы">
      <div><b>01</b><span>Задача</span></div>
      <div><b>02</b><span>Исходные данные</span></div>
      <div><b>03</b><span>Монтаж</span></div>
      <div><b>04</b><span>Результат</span></div>
    </div>
  </section>

  <section class="case-feature" aria-labelledby="case-title">
    <div class="home-shell case-dossier">
      <header class="case-dossier__intro">
        <p class="section-index section-index--orange">02 / Реализованный объект</p>
        <h2 id="case-title">7 PARK</h2>
        <p class="case-feature__subtitle">Павловск · жилой квартал</p>
        <p class="case-dossier__statement">
          Монтаж приточно-вытяжной вентиляции в семи домах. Ниже — подтверждённые границы работ, период и локация; без неподтверждённых характеристик.
        </p>
      </header>

      <figure class="case-dossier__primary">
        <img src="/evidence/7park/object-exterior-day.jpg" width="800" height="450" loading="lazy" decoding="async" alt="Жилой квартал 7 PARK в Павловске, дневной вид" />
        <figcaption><span>Объект</span><strong>7 PARK · Павловск</strong></figcaption>
      </figure>

      <dl class="case-dossier__facts case-dossier__facts--primary">
        <div><dt>Система</dt><dd>Приточно-вытяжная вентиляция</dd></div>
        <div><dt>Период</dt><dd>18.11.2020 — 10.12.2020</dd></div>
        <div><dt>Роль AEROVENTA</dt><dd>Монтаж</dd></div>
      </dl>

      <figure class="case-dossier__secondary">
        <img src="/evidence/7park/duct-route.jpg" width="735" height="487" loading="lazy" decoding="async" alt="Смонтированный воздуховод на объекте 7 PARK" />
        <figcaption><span>Монтаж</span><strong>Фрагмент работ на объекте 7 PARK</strong></figcaption>
      </figure>

      <dl class="case-dossier__facts case-dossier__facts--secondary">
        <div><dt>Объём</dt><dd>7 домов</dd></div>
        <div><dt>Локация</dt><dd>Павловск, Ленинградская область</dd></div>
      </dl>

      <a class="case-dossier__cta" href="/blog/detail/kak-my-sdali-7-domov/">Смотреть объект <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="home-section" id="objects" aria-labelledby="objects-title">
    <div class="home-shell">
      <div class="section-heading">
        <div>
          <p class="section-index">03 / Под конкретный объект</p>
          <h2 id="objects-title">Разные объекты — разные ограничения.</h2>
        </div>
        <a href="/obekty/">Смотреть все типы объектов →</a>
      </div>

      <div class="object-grid">
        <a class="object-link" href="/obekty/#production"><span>01</span><h3>Производство</h3><p>Проект, действующий режим, трассы, доступ и границы состава монтажных работ.</p></a>
        <a class="object-link" href="/obekty/restorany-i-kafe/"><span>02</span><h3>Рестораны и кафе</h3><p>Кухня, зал, оборудование, потолки и координация с отделкой.</p></a>
        <a class="object-link" href="/obekty/novostroyki-i-zhilye-kompleksy/"><span>03</span><h3>Новостройки</h3><p>Повторяемый объём, график по корпусам и управляемое усиление команды.</p></a>
        <a class="object-link" href="/obekty/#private"><span>04</span><h3>Квартиры и дома</h3><p>Шум, пространство, отделка и аккуратная прокладка трасс.</p></a>
        <a class="object-link" href="/obekty/#warehouses"><span>05</span><h3>Склады</h3><p>Высота, доступ, эксплуатационный режим и логистика монтажа.</p></a>
        <a class="object-link" href="/obekty/#commercial"><span>06</span><h3>Офисы и коммерция</h3><p>Стадия отделки, потолки, сроки открытия и смежные подрядчики.</p></a>
      </div>
    </div>
  </section>

  <section class="home-section decision-preview" aria-labelledby="decisions-title">
    <div class="home-shell decision-preview__grid">
      <div class="section-copy">
        <p class="section-index">04 / До монтажа</p>
        <h2 id="decisions-title">Что важно решить до монтажа вентиляции</h2>
        <p>
          Здесь собраны вопросы, которые влияют на смету, подготовку и монтаж:
          что можно оценить сейчас, какие данные действительно нужны и где обычно возникают риски.
        </p>
        <a class="button button--ghost" href="/faq/">Разобрать вопросы по объекту →</a>
      </div>
      <div class="question-list">
        {questions.map((question, index) => (
          <a href="/faq/"><span>{String(index + 1).padStart(2, '0')}</span>{question}<b aria-hidden="true">→</b></a>
        ))}
      </div>
    </div>
  </section>

  <section class="conversion-close" aria-labelledby="close-title">
    <div class="home-shell">
      <p class="section-index section-index--orange">05 / Следующий шаг</p>
      <h2 id="close-title">Продолжите с той стадии, на которой находится объект сейчас.</h2>
      <div class="engagement-index engagement-index--dark engagement-index--close">
        <a href="/montazh-po-proektu/">
          <span>01</span>
          <div><strong>Есть готовый проект</strong><p>Передать комплект и запросить смету на монтаж.</p></div>
          <b aria-hidden="true">→</b>
        </a>
        <a href="/obekt-bez-gotovogo-proekta/">
          <span>02</span>
          <div><strong>Проекта пока нет</strong><p>Понять, какие данные нужны до корректной сметы.</p></div>
          <b aria-hidden="true">→</b>
        </a>
      </div>
      <div class="conversion-close__assist" aria-label="Помощь с выбором следующего шага">
        <button class="button button--ghost" type="button" data-consultant-open data-source="home_close">Разобрать задачу с консультантом</button>
        <button class="button button--ghost" type="button" data-contact-open data-source="home_close">Обсудить объект</button>
      </div>
    </div>
  </section>
</BaseLayout>
