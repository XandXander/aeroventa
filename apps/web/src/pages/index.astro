---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getByPath } from '@/lib/content-source';
const content = await getByPath('/');
if (!content) throw new Error('Home content is missing');
const fixture = content.status === 'fixture_stub';
---
<BaseLayout content={content}>
  <section class="hero">
    <div class="container">
      <p><strong>Основное направление</strong></p>
      <h1>Монтаж вентиляции для квартир, бизнеса и сложных объектов</h1>
      <p>Проектируем практичную реализацию, выполняем монтаж и решаем нестандартные инженерные задачи в Санкт-Петербурге и Ленинградской области.</p>
      <p><a class="cta" href="/montazh-ventiliacii/">Обсудить вентиляцию</a></p>
      {fixture && <div class="notice"><strong>Implementation fixture:</strong> production-контент ещё не мигрирован; страница принудительно noindex.</div>}
    </div>
  </section>
</BaseLayout>
