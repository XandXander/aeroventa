---
import { SITE } from '@/lib/site';
const tel = SITE.phone.replace(/[^+\d]/g, '');
---

<div class="airflow-trace-ui" aria-hidden="true">
  <div class="airflow-entry-trace" data-airflow-entry>
    <div class="airflow-entry-trace__inner">
      <svg viewBox="0 0 1200 54" preserveAspectRatio="none" role="presentation">
        <path class="airflow-entry-trace__duct" d="M0 28 H260 V16 H510 V38 H760 V22 H1015 V28 H1200" pathLength="100" />
        <path class="airflow-entry-trace__pulse" d="M0 28 H260 V16 H510 V38 H760 V22 H1015 V28 H1200" pathLength="100" />
      </svg>
      <div class="airflow-entry-trace__steps">
        <span>01 Задача</span>
        <span>02 Исходные данные</span>
        <span>03 Монтаж</span>
        <span>04 Результат</span>
      </div>
    </div>
  </div>

  <div class="airflow-header-trace" data-airflow-header-trace>
    <span class="airflow-header-trace__route airflow-header-trace__route--supply">
      <i></i>
    </span>
    <span class="airflow-header-trace__route airflow-header-trace__route--exhaust">
      <i></i>
    </span>
  </div>
</div>

<nav class="mobile-contact-dock" data-mobile-contact-dock aria-label="Быстрый контакт">
  <a href={`tel:${tel}`} class="mobile-contact-dock__call">Позвонить</a>
  <a href="/montazh-po-proektu/" class="mobile-contact-dock__project">Передать проект <span aria-hidden="true">→</span></a>
</nav>

<script is:inline>
(() => {
  const root = document.documentElement;
  const header = document.querySelector('.site-header');
  const entry = document.querySelector('[data-airflow-entry]');
  const mobileDock = document.querySelector('[data-mobile-contact-dock]');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Non-blocking identity cue on first real document view. It never masks content.
  // Request PULSE below remains correlated with actual form submission.
  if (entry) {
    let alreadyShown = false;
    try {
      alreadyShown = sessionStorage.getItem('aeroventa-entry-shown') === '1';
      if (!alreadyShown && !prefersReduced) sessionStorage.setItem('aeroventa-entry-shown','1');
    } catch { /* private-storage denied */ }
    if (prefersReduced || alreadyShown) entry.remove();
    else {
      entry.classList.add('is-running');
      entry.addEventListener('animationend', (event) => {
        if (event.target === entry && event.animationName === 'airflow-entry-fade') entry.remove();
      });
    }
  }
  // AirflowTracePulse renders before PremiumExperience. Wait for the form DOM:
  // binding before DOMContentLoaded silently misses all submission states.
  const bindRequestPulse = () => {
    const pendingForms = [...document.querySelectorAll('form[data-contact-form]')];
    const reflectProcessing = () => {
      const processing = pendingForms.some(form => form.getAttribute('data-submitting') === 'true');
      root.toggleAttribute('data-airflow-processing', processing);
    };
    if (pendingForms.length) {
      const observer = new MutationObserver(reflectProcessing);
      pendingForms.forEach(form => observer.observe(form, {attributes:true,attributeFilter:['data-submitting']}));
      reflectProcessing();
    }
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindRequestPulse, {once:true});
  } else bindRequestPulse();

  // BaseLayout places this component before <main>. Initialize after parsing
  // the page content, otherwise the observer receives zero section nodes.
  const bindSectionTrace = () => {
    const sections = [...document.querySelectorAll('main > section, main article > section')]
      .filter((section) => !section.hasAttribute('data-airflow-ignore'));

    sections.forEach((section, index) => {
      section.classList.add('airflow-trace-section');
      section.style.setProperty('--airflow-trace-index', String(index));
    });

    if (prefersReduced) {
      sections.forEach((section) => section.classList.add('is-airflow-active'));
    } else if ('IntersectionObserver' in window) {
      let lastPulseAt = 0;
      const observer = new IntersectionObserver((entries) => {
        const candidates = entries
          .filter((entry) => entry.isIntersecting && !entry.target.classList.contains('is-airflow-active'))
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        if (!candidates.length) return;

        const now = performance.now();
        if (now - lastPulseAt < 280) return;

        const target = candidates[0].target;
        target.classList.add('is-airflow-active');
        lastPulseAt = now;
        observer.unobserve(target);
      }, { threshold: [0.22, 0.42], rootMargin: '0px 0px -12% 0px' });

      sections.forEach((section) => observer.observe(section));
    } else {
      sections.forEach((section) => section.classList.add('is-airflow-active'));
    }

  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindSectionTrace, {once:true});
  } else bindSectionTrace();

  // Do not cover first-fold object routes with a fixed consultant launcher.
  // Discovery is deferred until the entire page has rendered.
  let entryBoundary = null;
  let ticking = false;
  const updateScrollState = () => {
    const y = window.scrollY || 0;
    const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
    const progress = Math.min(1, Math.max(0, y / max));
    root.style.setProperty('--airflow-scroll', String(progress));

    if (header) header.classList.toggle('is-compact', y > 28);
    if (entryBoundary) {
      root.classList.toggle('is-past-first-fold', entryBoundary.getBoundingClientRect().bottom < 80);
    }
    if (mobileDock) mobileDock.classList.toggle('is-visible', y > Math.min(280, window.innerHeight * 0.42));
    ticking = false;
  };
  const onScroll = () => {
    if (!ticking) {
      requestAnimationFrame(updateScrollState);
      ticking = true;
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('DOMContentLoaded', () => {
    entryBoundary = document.querySelector('.home-hero--owner-airflow .object-ribbon, .services-hero__routes, .about-hero');
    updateScrollState();
  }, {once:true});
  updateScrollState();
})();
</script>
