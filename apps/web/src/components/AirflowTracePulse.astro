---
---
<div class="airflow-trace-ui" aria-hidden="true">
  <div class="airflow-entry-trace" data-airflow-entry data-mode="full">
    <div class="airflow-entry-trace__inner">
      <svg viewBox="0 0 1200 74" preserveAspectRatio="none" role="presentation" aria-hidden="true">
        <path class="airflow-entry-trace__duct airflow-entry-trace__duct--supply" d="M10 18 H250 V31 H520 V18 H812 V31 H1155" pathLength="100"/>
        <path class="airflow-entry-trace__duct airflow-entry-trace__duct--exhaust" d="M1155 52 H920 V40 H650 V52 H355 V40 H10" pathLength="100"/>
        <path class="airflow-entry-trace__pulse airflow-entry-trace__pulse--supply" d="M10 18 H250 V31 H520 V18 H812 V31 H1155" pathLength="100"/>
        <path class="airflow-entry-trace__pulse airflow-entry-trace__pulse--exhaust" d="M1155 52 H920 V40 H650 V52 H355 V40 H10" pathLength="100"/>
        <circle class="airflow-entry-trace__end airflow-entry-trace__end--supply" cx="1155" cy="31" r="4"/>
        <circle class="airflow-entry-trace__end airflow-entry-trace__end--exhaust" cx="10" cy="40" r="4"/>
      </svg>
      <div class="airflow-entry-trace__steps"><span>01 Задача</span><span>02 Исходные данные</span><span>03 Монтаж</span><span>04 Результат</span></div>
    </div>
  </div>
  <div class="airflow-header-trace" data-airflow-header-trace>
    <span class="airflow-header-trace__route airflow-header-trace__route--supply"><i></i></span>
    <span class="airflow-header-trace__route airflow-header-trace__route--exhaust"><i></i></span>
  </div>
</div>
<script is:inline>
(() => {
  const root = document.documentElement;
  const header = document.querySelector('.site-header');
  const entry = document.querySelector('[data-airflow-entry]');
  const entryHost = entry?.parentNode;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  // Entry cue is independent from website readiness. The document is usable throughout.
  // Two separate routes convey supply and extract in opposite directions; never connected.
  const playEntry = (repeat = false) => {
    if (!entry || !entryHost) return;
    if (reduced.matches) { entry.remove(); return; }
    if (!entry.isConnected) entryHost.prepend(entry);
    entry.classList.remove('is-running');
    entry.dataset.mode = repeat ? 'short' : 'full';
    // A new animation frame establishes the initial geometry before animation.
    requestAnimationFrame(() => requestAnimationFrame(() => {
      if (entry.isConnected && !reduced.matches) entry.classList.add('is-running');
    }));
  };
  let firstInSession = true;
  try {
    firstInSession = sessionStorage.getItem('aeroventa-entry-shown') !== '1';
    sessionStorage.setItem('aeroventa-entry-shown','1');
  } catch { /* browser storage denial must not hide identity */ }
  entry?.addEventListener('animationend', event => {
    if (event.target === entry && event.animationName === 'airflow-entry-fade') {
      entry.classList.remove('is-running');
      entry.remove();
    }
  });
  playEntry(!firstInSession);
  reduced.addEventListener?.('change', () => { if (reduced.matches) entry?.remove(); });
  // Back/Forward cache reuses the document rather than running page scripts again.
  window.addEventListener('pageshow', event => {
    if (event.persisted) { playEntry(true); requestAnimationFrame(updateScrollState); }
  });
  const bindRequestPulse = () => {
    const pendingForms = [...document.querySelectorAll('form[data-contact-form], form[data-project-form]')];
    const reflect = () => root.toggleAttribute('data-airflow-processing',
      pendingForms.some(form => form.dataset.submitting === 'true'));
    if (pendingForms.length) {
      const observer = new MutationObserver(reflect);
      pendingForms.forEach(form => observer.observe(form,{attributes:true,attributeFilter:['data-submitting']}));
    }
    reflect();
    // PULSE is never claimed for the synchronous public-content consultant.
    // That guide has no asynchronous operation; handoff begins only at actual form POST.
  };
  const bindSectionTrace = () => {
    const sections = [...document.querySelectorAll('main > section, main article > section')]
      .filter(section => !section.hasAttribute('data-airflow-ignore'));
    sections.forEach((section,index) => {
      section.classList.add('airflow-trace-section');
      section.style.setProperty('--airflow-trace-index',String(index));
    });
    if (reduced.matches || !('IntersectionObserver' in window)) {
      sections.forEach(section => section.classList.add('is-airflow-active'));
      return;
    }
    let lastPulseAt=-Infinity;
    const observer = new IntersectionObserver((entries)=>{
      const now=performance.now();
      if (now-lastPulseAt<280)return;
      const candidate=entries.filter(e=>e.isIntersecting&&!e.target.classList.contains('is-airflow-active'))
        .sort((a,b)=>b.intersectionRatio-a.intersectionRatio)[0];
      if (!candidate)return;
      candidate.target.classList.add('is-airflow-active');
      observer.unobserve(candidate.target);
      lastPulseAt=now;
    },{threshold:[.22,.42],rootMargin:'0px 0px -12% 0px'});
    sections.forEach(section=>observer.observe(section));
  };
  if (document.readyState==='loading') {
    document.addEventListener('DOMContentLoaded',()=>{bindRequestPulse();bindSectionTrace();entryBoundary=document.querySelector('.home-hero--owner-airflow .object-ribbon, [data-first-fold-boundary]');updateScrollState();},{once:true});
  } else {bindRequestPulse();bindSectionTrace();}
  let entryBoundary=null;
  let ticking=false;
  const updateScrollState=()=>{
    const y=window.scrollY||0;
    const max=Math.max(1,document.documentElement.scrollHeight-innerHeight);
    root.style.setProperty('--airflow-scroll',String(Math.min(1,Math.max(0,y/max))));
    if(header) header.classList.toggle('is-compact',y>28);
    if(entryBoundary)root.classList.toggle('is-past-first-fold',entryBoundary.getBoundingClientRect().bottom<80);
    ticking=false;
  };
  window.addEventListener('scroll',()=>{if(!ticking){ticking=true;requestAnimationFrame(updateScrollState);}},{passive:true});
  if(document.readyState!=='loading'){entryBoundary=document.querySelector('.home-hero--owner-airflow .object-ribbon, [data-first-fold-boundary]');}
  updateScrollState();
})();
</script>