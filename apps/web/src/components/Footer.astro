---
import { SITE } from '@/lib/site';
const year = new Date().getFullYear();
const tel = SITE.phone.replace(/[^+\d]/g, '');
---
<footer class="site-footer">
  <div class="home-shell footer-grid">
    <div class="footer-brand">
      <a href="/" class="footer-brand__name" aria-label="AEROVENTA — главная">
        <img class="brand-mark-locked brand-mark-locked--footer" src="/brand/aeroventa-mark.svg" width="82" height="57" alt="" aria-hidden="true" />
        <span class="baseline-wordmark"><span class="brand-wordmark-tail">EROVENTA</span></span>
      </a>
      <p>{SITE.primaryBusiness} для частных, коммерческих и производственных объектов.</p>
      <p class="footer-geo"><strong>Основная зона:</strong> {SITE.primaryServiceArea}<br /><strong>Также берём объекты:</strong> {SITE.additionalServiceAreas.join(' · ')}</p>
    </div>

    <div class="footer-contact">
      <span>Связаться по объекту</span>
      <a class="footer-phone" href={`tel:${tel}`}>{SITE.phone}</a>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <button class="footer-consultant" type="button" data-contact-open data-source="footer">Обсудить задачу</button>
      <a class="footer-project" href="/montazh-po-proektu/">Передать проект →</a>
    </div>

    <nav class="footer-nav" aria-label="Навигация в подвале">
      <div>
        <strong>Работы</strong>
        <a href="/montazh-ventiliacii/">Монтаж вентиляции</a>
        <a href="/services/">Услуги</a>
        <a href="/obekty/">Объекты</a>
      </div>
      <div>
        <strong>Доказательства</strong>
        <a href="/portfolio/">Реальные объекты</a>
        <a href="/blog/">Статьи</a>
        <a href="/faq/">Вопросы до монтажа</a>
      </div>
      <div>
        <strong>Компания</strong>
        <a href="/about/">О AEROVENTA</a>
        <a href="/contact/">Контакты</a>
        <a href="/privacy/">Обработка персональных данных</a>
      </div>
    </nav>
  </div>
  <div class="home-shell footer-bottom">
    <span>© {year} AEROVENTA</span>
    <span>Санкт-Петербург · Ленинградская область · Москва · Республика Карелия</span>
  </div>
</footer>
