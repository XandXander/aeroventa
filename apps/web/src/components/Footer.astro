---
import { SITE } from '@/lib/site';
const year = new Date().getFullYear();
const tel = SITE.phone.replace(/[^+\d]/g, '');
---
<footer class="site-footer">
  <div class="home-shell footer-grid">
    <div class="footer-brand">
      <a href="/" class="footer-brand__name" aria-label="AEROVENTA — главная">
        <img class="brand-mark-locked brand-mark-locked--footer" src="/brand/aeroventa-mark.svg" width="82" height="57" alt="" aria-hidden="true" />
        <span class="baseline-wordmark"><span class="brand-wordmark-tail">EROVENTA</span></span>
      </a>
      <p>{SITE.primaryBusiness} для частных, коммерческих и производственных объектов.</p>
      <p class="footer-geo"><strong>Основная зона:</strong> {SITE.primaryServiceArea}<br /><strong>Также берём объекты:</strong> {SITE.additionalServiceAreas.join(' · ')}</p>
    </div>

    <div class="footer-contact">
      <span>Связаться по объекту</span>
      <a class="footer-phone" href={`tel:${tel}`}>{SITE.phone}</a>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>

    <nav class="footer-nav" aria-label="Навигация в подвале">
      <a href="/services/">Услуги</a>
      <a href="/portfolio/">Наши работы</a>
      <a href="/about/">О компании</a>
      <a href="/privacy/">Конфиденциальность</a>
    </nav>
  </div>
  <div class="home-shell footer-bottom">
    <span>© {year} AEROVENTA</span>
  </div>
</footer>
