// Source-locked project directories, no client-side listing and no fabricated photographs.
// Every imported original in the dedicated archive directory becomes a gallery frame.
const sourceSlugs = new Set(['apart-hotel','eurospar-vo','eurospar-sestroretsk','college-obvodny','novatech','akvilon-yanino','himprom','sport-komendantskiy']);
const ownerGallery = (slug: string): string[] => {
  if (!sourceSlugs.has(slug)) return [];
  let names: string[] = [];
  try { names = readdirSync(resolve('apps/web/public/evidence/owner-portfolio', slug)); }
  catch { try { names = readdirSync(resolve('public/evidence/owner-portfolio', slug)); } catch { return []; } }
  const valid = names.filter(n => /^(?:cover|0[2-9]|[1-9][0-9]|gallery-[0-9]{2,3})\.(?:webp|jpe?g|png)$/i.test(n));
  valid.sort((a,b) => (a === 'cover.webp' ? -1 : b === 'cover.webp' ? 1 : a.localeCompare(b,undefined,{numeric:true})));
  return [...new Set(valid)].map(n => '/evidence/owner-portfolio/' + slug + '/' + n);
};
const gallerySlugFor = (image: string): string => image.split('/')[3] || '';
// Photo selection is fail-closed: all seven sports / six Neva originals must
// be physically present and SHA256-identical before the extended galleries publish.
// Until transferred, the existing verified media remain visible without broken links.
const curatedSource = {
  sport: [
    ['curated-01.webp','df500175caf94701964d354a1e92da3e32dcb7f73dba40f2ecd423976e3e4d53'], // 2022-09-15 11-14-01.JPG
    ['curated-02.webp','4a503b340ca5072c7d4b140412f5dbe73c0494f00b9b9d47ad0e26bd50861b67'], // 2022-08-17 15-58-18.JPG
    ['curated-03.webp','bb53c7e0100bbf99d91c049cceea9bb055e4137e26b7d2bc457d8c4dc6826999'], // 2022-09-12 14-20-22.JPG
    ['curated-04.webp','854131397bed13b0da0dc2ac7b84f85b0887eb73b4cbc958d0ace5ed58f749fb'], // 2022-09-15 09-56-35.JPG
    ['curated-05.webp','f2d235ccaf4270964ea578c13e43b9a21100a3b69deefb9204ff604ad8968b71'], // 2022-08-24 11-54-38.JPG
    ['curated-06.webp','b42391310cb20c5fba587a159ed0fc6825b7188bea48f8190e9d41216819262d'], // photo_5226735321473556566_y.jpg
    ['curated-07.webp','d9ea8c8a9d9771b0ec87c28f81d8159d5fb259e18aa1cb9c1efe503ae07d4afa'], // 2022-09-12 14-20-07.JPG
  ],
  neva: [
    ['curated-01.webp','3e277a403209126b14e4a2e64389c744dc5d8234d5875fc523118a6f6fd06320'], // photo_5222735321473556574_y.webp
    ['curated-02.webp','e54f90ecec5747a7a930ed6ad7d95493bbbec7949588e3131d3a030e66b7695b'], // photo_5226735321473556571_y.png
    ['curated-03.webp','38163a2a7dfdf3415dbe1d3c2682785b5ea1285c65e981af670e73baa97efa39'], // photo_5226735321473556576_y.png
    ['curated-04.webp','e574fa2d3c8c31c9a885b02ca16189dffd32de67110983bbf11cf1d1902b4a81'], // photo_5226735321473556544_y.jpg
    ['curated-05.webp','fc8b4990985c8d4e107790aa1b276b21f37c0ec21ee3c80e670bca9f8727d359'], // photo_5226735321473556574_y.png
    ['curated-06.webp','91ebc5f2bccb2f9f2bba2b2b63967c83f26063b5977141ddb6678b113ac1f3c4'], // photo_5226735321473556575_y.png
  ]
} as const;
function checkedCuratedPhotos(group:'sport'|'neva'): string[] {
  const folder=group==='sport'?'evidence/owner-portfolio/sport-komendantskiy':'evidence/residential/neva';
  const items=curatedSource[group];
  const locate=(name:string)=>[
    resolve('apps/web/public',folder,name),
    resolve('public',folder,name)
  ].find(existsSync);
  const found=items.map(([name])=>locate(name));
  if(found.every(p=>!p))return [];
  if(found.some(p=>!p))throw new Error('Curated '+group+' photos: incomplete source set');
  for(let i=0;i<items.length;i++){
    const [,expectedSha]=items[i];
    const actual=createHash('sha256').update(readFileSync(found[i]!)).digest('hex');
    if(actual!==expectedSha)throw new Error('Curated '+group+' photo integrity mismatch: '+items[i][0]);
  }
  return items.map(([name])=>'/'+folder+'/'+name);
}
const addedSportPhotos=checkedCuratedPhotos('sport');
const addedNevaPhotos=checkedCuratedPhotos('neva');
if(addedNevaPhotos.length!==6)throw new Error('Owner Neva case requires six integrity-checked engineering photographs');
const archiveCases = newOwnerCases.map(item => ({
  ...item,
  photos: item.index==='14'
    ? [item.cover,...addedNevaPhotos]
    : sourceSlugs.has(gallerySlugFor(item.cover)) ? ownerGallery(gallerySlugFor(item.cover)) : item.photos
}));
