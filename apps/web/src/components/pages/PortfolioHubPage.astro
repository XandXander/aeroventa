---
import type { ContentRecord } from '@/lib/types';
import { readdirSync } from 'node:fs';
import { resolve } from 'node:path';
interface Props { content: ContentRecord; fixture: boolean; }
const { content } = Astro.props;

const cases = [
  { index:'01', title:'7 PARK', image:'/evidence/7park/object-exterior-day.jpg', location:'Павловск, Санкт-Петербург', scope:'7 домов · монтаж приточно-вытяжной вентиляции', detail:'18.11.2020 — 10.12.2020', href:'/blog/detail/kak-my-sdali-7-domov/', kind:'Новостройки' },
  { index:'02', title:'Ресторан в ЖК «Леонтьевский Мыс»', image:'/evidence/leont/owner-cover-v43.webp', location:'Санкт-Петербург', scope:'Ресторан · приточно-вытяжная вентиляция + оборудование', detail:'Исторический срок: 2 недели', href:'/blog/detail/restoran-v-zhk-leontevskiy-mys/', kind:'Рестораны' },
  { index:'03', title:'НТФФ «Полисан»', image:'/evidence/polisan/owner-cover-v43.webp', location:'Санкт-Петербург, ул. Салова, 72', scope:'Фармацевтический объект · вентиляция + оборудование', detail:'Исторический период: 06.2017 — 06.2018', href:'/blog/detail/ntff-polisan/', kind:'Производство' },
  { index:'04', title:'Квартира на Маршала Жукова', image:'/evidence/zhukov/owner-cover-v43.webp', location:'Санкт-Петербург', scope:'Квартира · приточно-вытяжная вентиляция', detail:'Исторический источник: ~100 м.п., 5 дней', href:'/blog/detail/kvartira-na-zhukova/', kind:'Квартиры' },
  { index:'05', title:'PONSSE — Питкяранта', image:'/evidence/karelia/owner-cover-v43.webp', location:'Республика Карелия', scope:'Сервисно-образовательный центр · вентиляция + оборудование', detail:'Исторический срок: 2 недели', href:'/blog/detail/montazh-ventilyatsii-v-karelii/', kind:'Сервисно-образовательный центр' },
  { index:'06', title:'Кафе на Римского-Корсакова, 3', image:'/evidence/cafe/owner-cover-v43.webp', location:'Санкт-Петербург', scope:'Кафе · приточно-вытяжная вентиляция + оборудование', detail:'Исторический источник: 200 м², 5 дней', href:'/blog/detail/kafe-rimskogo-korsakova-3/', kind:'Рестораны' }
];

// Seven distinct Owner-archive objects, photo backed; no fabricated scope or URLs.
const newOwnerCases = [
  {
    "index": "07",
    "title": "Апарт-отель и коворкинг · Бумажный",
    "kind": "Апарт-отель и коворкинг",
    "location": "Санкт-Петербург",
    "cover": "/evidence/owner-portfolio/apart-hotel/cover.webp",
    "photos": [
      "/evidence/owner-portfolio/apart-hotel/cover.webp",
      "/evidence/owner-portfolio/apart-hotel/02.webp",
      "/evidence/owner-portfolio/apart-hotel/03.webp"
    ]
  },
  {
    "index": "08",
    "title": "EUROSPAR · Васильевский остров",
    "kind": "Торговый объект",
    "location": "Санкт-Петербург",
    "cover": "/evidence/owner-portfolio/eurospar-vo/cover.webp",
    "photos": [
      "/evidence/owner-portfolio/eurospar-vo/cover.webp",
      "/evidence/owner-portfolio/eurospar-vo/02.webp",
      "/evidence/owner-portfolio/eurospar-vo/03.webp"
    ]
  },
  {
    "index": "09",
    "title": "EUROSPAR · Сестрорецк",
    "kind": "Торговый объект",
    "location": "Сестрорецк",
    "cover": "/evidence/owner-portfolio/eurospar-sestroretsk/03.webp",
    "photos": [
      "/evidence/owner-portfolio/eurospar-sestroretsk/cover.webp",
      "/evidence/owner-portfolio/eurospar-sestroretsk/02.webp",
      "/evidence/owner-portfolio/eurospar-sestroretsk/03.webp"
    ]
  },
  {
    "index": "10",
    "title": "Колледж туризма и гостиничного сервиса",
    "kind": "Образовательный объект",
    "location": "Санкт-Петербург",
    "cover": "/evidence/owner-portfolio/college-obvodny/cover.webp",
    "photos": [
      "/evidence/owner-portfolio/college-obvodny/cover.webp",
      "/evidence/owner-portfolio/college-obvodny/02.webp",
      "/evidence/owner-portfolio/college-obvodny/03.webp"
    ]
  },
  {
    "index": "11",
    "title": "Новатех",
    "kind": "Производственный объект",
    "location": "Московская область",
    "cover": "/evidence/owner-portfolio/novatech/03.webp",
    "photos": [
      "/evidence/owner-portfolio/novatech/cover.webp",
      "/evidence/owner-portfolio/novatech/02.webp",
      "/evidence/owner-portfolio/novatech/03.webp"
    ]
  },
  {
    "index": "12",
    "title": "Жилой комплекс «Аквилон» · Янино",
    "kind": "Жилой комплекс",
    "location": "Янино, Ленинградская область",
    "cover": "/evidence/owner-portfolio/akvilon-yanino/cover.webp",
    "photos": [
      "/evidence/owner-portfolio/akvilon-yanino/cover.webp",
      "/evidence/owner-portfolio/akvilon-yanino/02.webp",
      "/evidence/owner-portfolio/akvilon-yanino/03.webp"
    ]
  },
  {
    "index": "13",
    "title": "Химпром",
    "kind": "Промышленный объект",
    "location": "Санкт-Петербург",
    "cover": "/evidence/owner-portfolio/himprom/03.webp",
    "photos": [
      "/evidence/owner-portfolio/himprom/cover.webp",
      "/evidence/owner-portfolio/himprom/02.webp",
      "/evidence/owner-portfolio/himprom/03.webp"
    ]
  }
];
// Source-locked project directories, no client-side listing and no fabricated photographs.
// Every imported original in the dedicated archive directory becomes a gallery frame.
const sourceSlugs = new Set(['apart-hotel','eurospar-vo','eurospar-sestroretsk','college-obvodny','novatech','akvilon-yanino','himprom','sport-komendantskiy']);
const ownerGallery = (slug: string): string[] => {
  if (!sourceSlugs.has(slug)) return [];
  let names: string[] = [];
  try { names = readdirSync(resolve('apps/web/public/evidence/owner-portfolio', slug)); }
  catch { try { names = readdirSync(resolve('public/evidence/owner-portfolio', slug)); } catch { return []; } }
  const valid = names.filter(n => /^(?:cover|0[2-9]|[1-9][0-9]|gallery-[0-9]{2,3})\.(?:webp|jpe?g|png)$/i.test(n));
  valid.sort((a,b) => (a === 'cover.webp' ? -1 : b === 'cover.webp' ? 1 : a.localeCompare(b,undefined,{numeric:true})));
  return [...new Set(valid)].map(n => '/evidence/owner-portfolio/' + slug + '/' + n);
};
const gallerySlugFor = (image: string): string => image.split('/')[3] || '';
const archiveCases = newOwnerCases.map(item => ({ ...item, photos: ownerGallery(gallerySlugFor(item.cover)) }));
const sportPhotos = ownerGallery('sport-komendantskiy');
---

<article class="portfolio-hub">
  <header class="portfolio-hero">
    <div class="home-shell portfolio-hero__grid">
      <div class="portfolio-hero__copy">
        <p class="home-kicker">Выполненные работы AEROVENTA</p>
        <h1>Наши работы</h1>
        <p class="portfolio-hero__lede">Реальные объекты, фотографии, задачи и результаты монтажа — от квартиры и ресторана до жилого квартала и производства.</p>
      </div>
      <div class="portfolio-hero__mosaic" aria-label="Три подлинных объекта AEROVENTA">
        <figure>
          <img src="/evidence/owner-portfolio/apart-hotel/cover.webp" width="1200" height="800" alt="Апарт-отель и коворкинг на Бумажном — оригинальная фотография интерьера и открытых инженерных систем" loading="eager" decoding="async"/>
          <figcaption>Апарт-отель / коворкинг · Бумажный</figcaption>
        </figure>
        <figure>
          <img src="/evidence/polisan/owner-cover-v43.webp" width="1600" height="903" alt="НТФФ Полисан — фармацевтический объект" loading="eager" decoding="async"/>
          <figcaption>Полисан · производство</figcaption>
        </figure>
        <figure>
          <img src="/evidence/leont/owner-cover-v43.webp" width="1349" height="744" alt="ЖК Леонтьевский Мыс — ресторанный объект" loading="eager" decoding="async"/>
          <figcaption>Леонтьевский Мыс · ресторан</figcaption>
        </figure>
      </div>
    </div>
  </header>

  <section class="portfolio-feature" aria-labelledby="featured-case-title">
    <div class="home-shell portfolio-feature__grid">
      <div>
        <p class="section-index section-index--orange">01 / Крупный повторяемый объём</p>
        <h2 id="featured-case-title">7 PARK</h2>
        <p class="portfolio-feature__sub">Павловск · 7 домов · приточно-вытяжная вентиляция</p>
        <a class="button button--case" href="/blog/detail/kak-my-sdali-7-domov/">Открыть кейс →</a>
      </div>
      <figure class="portfolio-feature__visual portfolio-feature__visual--photo">
        <img src="/evidence/7park/object-exterior-day.jpg" alt="Жилые дома квартала 7 PARK в Павловске" width="800" height="450" loading="lazy" />
        <figcaption>7 PARK · жилой квартал в Павловске</figcaption>
      </figure>
      <dl class="case-facts">
        <div><dt>Объём</dt><dd>7 домов</dd></div>
        <div><dt>Период</dt><dd>18.11.2020 — 10.12.2020</dd></div>
        <div><dt>Локация</dt><dd>Павловск, Санкт-Петербург</dd></div>
        <div><dt>Роль</dt><dd>Монтаж приточно-вытяжной вентиляции</dd></div>
      </dl>
    </div>
  </section>

  <section class="home-section portfolio-list" aria-labelledby="cases-title">
    <div class="home-shell">
      <div class="section-heading">
        <div>
          <p class="section-index">02 / Сравнить по объекту</p>
          <h2 id="cases-title">Объекты разного масштаба</h2>
        </div>
      </div>
      <div class="portfolio-archive__intro">
        <p class="section-index">Архив компании</p>
        <h3>Объекты в фотографиях</h3>
        <p>Подлинные фотографии объектов, без неподтверждённых объёмов, сроков или перечней выполненных работ. Документированные кейсы представлены выше.</p>
      </div>
      <div class="portfolio-grid">
        {cases.filter((item) => item.index !== '01').map((item) => (
          <a href={item.href} class="portfolio-card">
            <div class="portfolio-card__media"><img src={item.image} width="800" height="520" alt={`Реальные фотографии работ: ${item.title}`} loading="lazy" decoding="async" /></div>
            <div class="portfolio-card__body">
            <div class="portfolio-card__top"><span>{item.index}</span><b>{item.kind}</b></div>
            <div>
              <p>{item.location}</p>
              <h3>{item.title}</h3>
              <strong>{item.scope}</strong>
            </div>
            <div class="portfolio-card__bottom">
              <span>{item.detail}</span><b>Смотреть работы →</b>
            </div>
            </div>
          </a>
        ))}
        {archiveCases.map(item => (
          <button type="button" id={`owner-${item.index}`} class="portfolio-card portfolio-card--archive" data-archive-open
            data-gallery-images={JSON.stringify(item.photos)} data-gallery-title={item.title}
            aria-haspopup="dialog" aria-controls="portfolio-archive-viewer"
            aria-label={`Открыть фотографии: ${item.title}`}>
            <div class="portfolio-card__media"><img src={item.cover} width="1200" height="800" loading="lazy" decoding="async" alt={`Фотография объекта: ${item.title}`}/></div>
            <div class="portfolio-card__body">
              <div class="portfolio-card__top"><span>{item.index}</span><b>{item.kind}</b></div>
              <div><p>{item.location}</p><h3>{item.title}</h3></div>
              <div class="portfolio-card__bottom"><span>Исходный фотоархив объекта</span><b>Смотреть фотографии →</b></div>
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>


  <!-- Source provenance: КОНТЕНТ.zip / СПОРТКОМПЛЕКС КОМЕНДАНТСКИЙ.
       Architectural exterior corroborated with publicly pictured Centre on
       Яхтенная 39; extent of AEROVENTA works remains source-unconfirmed. -->
  <section class="portfolio-sport" aria-labelledby="portfolio-sport-title">
    <div class="home-shell portfolio-sport__inner">
      <div class="portfolio-sport__intro">
        <p class="section-index">03 / Спортивный объект</p>
        <h2 id="portfolio-sport-title">Центр адаптивного спорта</h2>
        <p>Санкт-Петербург · Яхтенная, 39. Архивные фотографии монтажа инженерных систем спортивного комплекса.</p>
        <button type="button" class="portfolio-sport__gallery-link" data-archive-open
          data-gallery-title="Центр адаптивного спорта"
          data-gallery-images={JSON.stringify(sportPhotos)}
          aria-haspopup="dialog" aria-controls="portfolio-archive-viewer">
          Смотреть фотографии объекта <span aria-hidden="true">↗</span>
        </button>
      </div>
      <div class="portfolio-sport__photography">
        <figure class="portfolio-sport__photo portfolio-sport__photo--large">
          <img src="/evidence/owner-portfolio/sport-komendantskiy/cover.webp" width="937" height="428" loading="lazy" decoding="async"
            alt="Здание Центра адаптивного спорта из исходного фотоархива"/>
        </figure>
        <figure class="portfolio-sport__photo portfolio-sport__photo--detail">
          <img src="/evidence/owner-portfolio/sport-komendantskiy/02.webp" width="1200" height="900" loading="lazy" decoding="async"
            alt="Инженерные системы Центра адаптивного спорта во время монтажа"/>
        </figure>
      </div>
    </div>
  </section>

  <dialog id="portfolio-archive-viewer" class="portfolio-archive-viewer" aria-label="Фотодокументация объекта">
    <div class="portfolio-archive-viewer__top">
      <strong data-gallery-title></strong>
      <button type="button" data-gallery-close aria-label="Закрыть просмотр">×</button>
    </div>
    <div class="portfolio-archive-viewer__stage" tabindex="0"><img data-gallery-photo src="/evidence/owner-portfolio/apart-hotel/cover.webp" width="1200" height="800" loading="lazy" alt="Фотография объекта"/></div>
    <div class="portfolio-archive-viewer__nav" aria-label="Навигация по фотографиям">
      <button type="button" data-gallery-prev aria-label="Предыдущая фотография">‹</button>
      <span>Фотодокументация объекта</span>
      <button type="button" data-gallery-next aria-label="Следующая фотография">›</button>
    </div>
  </dialog>

  <section class="conversion-close" aria-labelledby="portfolio-close-title">
    <div class="home-shell">
      <p class="section-index section-index--orange">04 / Ваш объект</p>
      <h2 id="portfolio-close-title">Расскажите о вашем объекте.</h2>
      <p class="portfolio-close-copy">Пришлите проект или описание задачи. Уточним состав работ, исходные данные и следующий шаг.</p>
      <div class="home-actions">
        <a class="button button--light" href="/montazh-po-proektu/">Передать проект →</a>
        <a class="button button--light" href="/contact/" data-contact-open data-source="portfolio_close" aria-haspopup="dialog">Обсудить объект →</a>
      </div>
    </div>
  </section>
</article>

<script>
  const dialog=document.querySelector<HTMLDialogElement>('#portfolio-archive-viewer');
  if (dialog) {
    const image=dialog.querySelector<HTMLImageElement>('[data-gallery-photo]');
    const stage=dialog.querySelector<HTMLElement>('.portfolio-archive-viewer__stage');
    const title=dialog.querySelector<HTMLElement>('[data-gallery-title]');
    const close=dialog.querySelector<HTMLButtonElement>('[data-gallery-close]');
    let photos:string[]=[];
    let index=0, zoom=1;
    let opener:HTMLElement|null=null;
    // The only visible controls are arrows and close. Zoom uses touch pinch,
    // double click/tap, Ctrl+wheel or + / - / 0 keys.
    const setZoom=(value:number)=>{
      if(!stage||!image)return;
      zoom=Math.max(1,Math.min(4,Math.round(value*100)/100));
      if(zoom===1){
        dialog.classList.remove('is-zoomed');
        image.style.removeProperty('width');
        stage.scrollTo({left:0,top:0});
      } else {
        const ratio=image.naturalWidth>0&&image.naturalHeight>0?image.naturalWidth/image.naturalHeight:1.4;
        const base=Math.min(stage.clientWidth-24,(stage.clientHeight-16)*ratio,image.naturalWidth||1800);
        image.style.width=Math.round(Math.max(100,base)*zoom)+'px';
        dialog.classList.add('is-zoomed');
      }
      dialog.dataset.zoom=String(zoom);
    };
    const show=(n:number)=>{
      if(!photos.length||!image)return;
      index=(n+photos.length)%photos.length;
      setZoom(1);
      image.src=photos[index];
      image.alt=(title?.textContent||'Объект')+' — фотография '+(index+1);
    };
    for(const button of document.querySelectorAll<HTMLElement>('[data-archive-open]')){
      button.addEventListener('click',()=>{
        try{
          const value=JSON.parse(button.dataset.galleryImages||'[]');
          const safe=/^\/evidence\/owner-portfolio\/(?:apart-hotel|eurospar-vo|eurospar-sestroretsk|college-obvodny|novatech|akvilon-yanino|himprom|sport-komendantskiy)\/(?:cover|[0-9]{2,3}|gallery-[0-9]{2,3})\.(?:webp|jpe?g|png)$/i;
          if(!Array.isArray(value)||!value.length||!value.every((v:unknown)=>typeof v==='string'&&safe.test(v)))return;
          photos=value;opener=button;
          if(title)title.textContent=button.dataset.galleryTitle||'Объект';
          show(0);dialog.showModal();close?.focus({preventScroll:true});
        }catch{return;}
      });
    }
    close?.addEventListener('click',()=>dialog.close());
    dialog.querySelector('[data-gallery-prev]')?.addEventListener('click',()=>show(index-1));
    dialog.querySelector('[data-gallery-next]')?.addEventListener('click',()=>show(index+1));
    stage?.addEventListener('dblclick',e=>{e.preventDefault();setZoom(zoom>1?1:2);});
    stage?.addEventListener('wheel',e=>{if(!e.ctrlKey)return;e.preventDefault();setZoom(zoom*(e.deltaY<0?1.15:1/1.15));},{passive:false});
    let pinchStart=0, pinchZoom=1;
    const distance=(a:Touch,b:Touch)=>Math.hypot(a.clientX-b.clientX,a.clientY-b.clientY);
    stage?.addEventListener('touchstart',e=>{
      if(e.touches.length===2){pinchStart=distance(e.touches[0],e.touches[1]);pinchZoom=zoom;e.preventDefault();}
    },{passive:false});
    stage?.addEventListener('touchmove',e=>{
      if(e.touches.length===2&&pinchStart>0){setZoom(pinchZoom*distance(e.touches[0],e.touches[1])/pinchStart);e.preventDefault();}
    },{passive:false});
    stage?.addEventListener('touchend',e=>{if(e.touches.length<2)pinchStart=0;},{passive:true});
    dialog.addEventListener('keydown',e=>{
      if(e.key==='ArrowLeft'){e.preventDefault();show(index-1);}
      if(e.key==='ArrowRight'){e.preventDefault();show(index+1);}
      if(e.key==='+'||e.key==='='){e.preventDefault();setZoom(zoom+.35);}
      if(e.key==='-'||e.key==='_'){e.preventDefault();setZoom(zoom-.35);}
      if(e.key==='0'){e.preventDefault();setZoom(1);}
      // Escape is handled natively by <dialog>, preserving focus and semantics.
    });
    let x:number|null=null;
    stage?.addEventListener('touchstart',e=>{if(e.touches.length===1)x=e.touches[0].clientX;},{passive:true});
    stage?.addEventListener('touchend',e=>{
      if(x===null||zoom>1||e.changedTouches.length!==1)return;
      const end=e.changedTouches[0].clientX;
      if(Math.abs(end-x)>65)show(index+(end<x?1:-1));x=null;
    },{passive:true});
    dialog.addEventListener('close',()=>{
      setZoom(1);if(image)image.removeAttribute('src');
      photos=[];opener?.focus({preventScroll:true});opener=null;
    });
  }
</script>

<style>
/* Photography leads; typography and evidence are deliberately restrained. */
.portfolio-hero{padding:clamp(38px,5vw,74px) 0 clamp(34px,4vw,60px)}
.portfolio-hero__grid{align-items:center;gap:clamp(24px,5vw,80px)}
.portfolio-hero h1{font-size:clamp(2.45rem,4.55vw,5rem);line-height:1.03;letter-spacing:-.044em;max-width:17ch;text-wrap:balance}
.portfolio-hero__lede{font-size:clamp(1rem,1.35vw,1.2rem);line-height:1.52;max-width:48ch}
.portfolio-grid{gap:clamp(16px,2vw,28px)}
.portfolio-card__media{aspect-ratio:1.5}
.portfolio-card__media img{filter:none}
.portfolio-card h3{font-size:clamp(1.23rem,1.65vw,1.75rem);line-height:1.18;letter-spacing:-.025em}
.portfolio-feature__visual img{object-fit:cover}
@media(max-width:760px){.portfolio-hero{padding:36px 0 38px}.portfolio-hero h1{font-size:clamp(2rem,8vw,3.2rem);max-width:none}.portfolio-hero__grid{gap:18px}.portfolio-grid{gap:20px}}

/* Owner 2026-10-15: dedicated photographic sports feature, not a 13th card. */
.portfolio-sport{padding-block:clamp(60px,7vw,112px);background:#e9eef0;color:#193447}
.portfolio-sport__inner{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr);align-items:center;gap:clamp(30px,4vw,75px)}
