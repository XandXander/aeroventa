---
import type { ContentRecord } from '@/lib/types';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
interface Props { content: ContentRecord; fixture: boolean; }

// Owner-confirmed team photography. Older technical shots are kept as historical assets,
// but are never silently substituted into the public team HERO.
const assetExists = (src: string) => ['apps/web/public' + src, 'public' + src].some(p => existsSync(resolve(p)));
// Exact Owner-mapped individual portraits. Show no guessed name/face association if the
// source asset has not yet been committed. No remote URL or invented substitute is used.
const ownerTeam = [
  { name:'Евгений Панов', role:'Технический директор', src:'/evidence/team/owner-evgeniy-panov-20261015.webp' },
  { name:'Александр Тарасов', role:'Операционный директор', src:'/evidence/team/owner-aleksandr-tarasov-20261013.webp' },
  { name:'Денис Иванов', role:'Руководитель проектов', src:'/evidence/team/owner-denis-ivanov-20261013.webp' },
  { name:'Александр Шаламов', role:'Инженер-проектировщик', src:'/evidence/team/owner-aleksandr-shalamov-20261013.webp' },
];
const teamGroupSrc = '/evidence/team/owner-team-group-20261015.webp';
const hasOwnerGroup = assetExists(teamGroupSrc);
const hasAllOwnerPortraits = ownerTeam.every(({src}) => assetExists(src));
// Fail closed: the site must not fall back to old installation photos or mismatched portraits.
if (!hasOwnerGroup || !hasAllOwnerPortraits) {
  throw new Error('Owner team photography incomplete — approved group and all four exact portraits required');
}

---
<article class="about-premium av-page av-about">
  <header class="av-hero av-hero--about"><div class="av-shell av-hero__grid">
    <div class="av-hero__title"><p class="av-kicker">Люди AEROVENTA</p><h1>Команда, которая ведёт ваш объект</h1></div>
    <figure class="av-hero__image"><img src={teamGroupSrc} alt="Четыре участника команды AEROVENTA на фоне вентиляционного оборудования" width="1024" height="768" loading="eager" decoding="async" fetchpriority="high"/><figcaption>Команда AEROVENTA · монтаж вентиляции</figcaption></figure>
    <div class="av-hero__body"><p class="av-lead">Технические решения и организация работ — с участием постоянного ядра команды.</p><p>Ведём монтаж и координацию на площадке. Если объём или график требуют усиления, подключаем проверенных профильных специалистов.</p><p class="av-geo">Санкт-Петербург и Ленинградская область · Москва · Карелия</p><a class="av-link" href="/portfolio/">Посмотреть выполненные работы →</a></div>
  </div></header>
  <section class="av-section av-people" aria-labelledby="about-team-title"><div class="av-shell"><div class="av-heading"><div><p class="av-kicker">Личная ответственность</p><h2 id="about-team-title">Кто работает с вашей задачей</h2></div><p>У технических и организационных вопросов есть ответственные специалисты.</p></div><div class="av-portraits">{ownerTeam.map(person=><figure><img src={person.src} alt={`${person.name} — ${person.role}`} width="720" height="960" loading="lazy" decoding="async"/><figcaption><strong>{person.name}</strong><span>{person.role}</span></figcaption></figure>)}</div></div></section>
  <section class="av-section av-about-method" aria-labelledby="about-method-title"><div class="av-shell av-about-method__grid"><div><p class="av-kicker">Как устроена работа</p><h2 id="about-method-title">Сначала разобраться.<br/>Затем смонтировать.</h2><dl class="av-register"><div><dt>Понять задачу</dt><dd>Назначение системы, документация и фактические условия площадки.</dd></div><div><dt>Согласовать объём</dt><dd>Состав сметы, последовательность работ и взаимодействие со смежными подрядчиками.</dd></div><div><dt>Работать по согласованному решению</dt><dd>Уточнять изменения до монтажа, сохраняя техническую координацию объекта.</dd></div></dl></div><figure><a href="/blog/detail/montazh-ventilyatsii-v-karelii/"><img src="/evidence/karelia/archive/img-8193.webp" width="1280" height="960" loading="lazy" decoding="async" alt="Вентиляционные трассы под перекрытием сервисного центра PONSSE"/></a><figcaption>PONSSE · потолочные трассы <a href="/blog/detail/montazh-ventilyatsii-v-karelii/">Работы на объекте ↗</a></figcaption></figure></div></section>
  <section class="av-close"><div class="av-shell av-close__grid"><div><p class="av-kicker">Начнём с разговора</p><h2>Расскажите о вашем объекте</h2></div><a class="button button--primary" href="/contact/" data-contact-open data-source="about_close" aria-haspopup="dialog">Связаться с командой →</a></div></section>
</article>
