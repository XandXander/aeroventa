---
import type { ContentRecord } from '@/lib/types';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
interface Props { content: ContentRecord; fixture: boolean; }
const { content } = Astro.props;

// Owner-authored installation images; never emit absent asset URLs in the published HTML.
const teamPhotoChoices = [
  { src:'/evidence/team/img_5958.webp', alt:'Два специалиста монтажной команды AEROVENTA на объекте', caption:'Монтажная команда · архив AEROVENTA' },
  { src:'/evidence/team/img_5971.webp', alt:'Специалист выполняет проходку в строительной конструкции', caption:'Работа с оборудованием на объекте' },
  { src:'/evidence/team/img_4168.webp', alt:'Монтажник инженерных систем в рабочей одежде и каске', caption:'Опыт непосредственной работы с инженерными системами' }
];
const teamPhotos = teamPhotoChoices.filter(({src}) =>
  ['apps/web/public' + src, 'public' + src].some(p => existsSync(resolve(p)))
);

const timeline = [
  { year:'2017–2018', title:'НТФФ «Полисан»', text:'Монтаж приточно-вытяжной вентиляции и оборудования на фармацевтическом объекте.', href:'/blog/detail/ntff-polisan/' },
  { year:'2019', title:'Квартира на Маршала Жукова', text:'Приточно-вытяжная вентиляция в жилом объекте — доказательство, что работа не ограничивается крупным B2B.', href:'/blog/detail/kvartira-na-zhukova/' },
  { year:'2020', title:'7 PARK', text:'Семь домов в Павловске. Подтверждённый исторический период интенсивных работ: 18.11.2020–10.12.2020.', href:'/blog/detail/kak-my-sdali-7-domov/' },
  { year:'2021', title:'ЖК «Леонтьевский Мыс»', text:'Ресторан: монтаж приточно-вытяжной вентиляции и оборудования.', href:'/blog/detail/restoran-v-zhk-leontevskiy-mys/' },
  { year:'2022', title:'Питкяранта / Карелия', text:'Сервисно-образовательный центр: монтаж вентиляции и оборудования.', href:'/blog/detail/montazh-ventilyatsii-v-karelii/' },
];
---

<article class="about-premium">
  <header class="about-hero">
    <div class="home-shell about-hero__grid">
      <div>
        <p class="home-kicker">О AEROVENTA</p>
        <h1>AEROVENTA — команда по монтажу вентиляции</h1>
      </div>
      <div>
        <p class="about-hero__lede">
          Постоянное ядро команды держит технический и организационный контроль объекта.
          Когда объём или график требуют усиления, подключаем проверенных профильных специалистов.
        </p>
        <p class="home-geo">Работаем в Санкт-Петербурге и Ленинградской области. Берём объекты в Москве и Карелии.</p>
        <div class="home-actions">
          <a class="button button--primary" href="/portfolio/">Посмотреть реальные объекты →</a>
          <a class="button button--ghost" href="/contact/">Связаться</a>
        </div>
      </div>
    </div>
  </header>

  <section class="about-proof home-section" aria-labelledby="about-proof-title">
    <div class="home-shell">
      <div class="section-heading">
        <div>
          <p class="section-index section-index--orange">Фактическая работа</p>
          <h2 id="about-proof-title">Вентиляция, которую можно увидеть на объектах.</h2>
        </div>
        <a href="/portfolio/">Все шесть объектов →</a>
      </div>
      <div class="about-proof__grid">
        <a href="/blog/detail/kak-my-sdali-7-domov/">
          <img src="/evidence/7park/duct-route.jpg" alt="Воздуховоды, смонтированные на объекте 7 PARK в Павловске" width="800" height="600" loading="lazy" decoding="async"/>
          <span><small>Павловск · семь домов</small><strong>7 PARK</strong><em>Монтаж и история работ ↗</em></span>
        </a>
        <a href="/blog/detail/ntff-polisan/">
          <img src="/evidence/polisan/owner-cover-v43.webp" alt="Монтаж вентиляции на фармацевтическом объекте НТФФ «Полисан»" width="800" height="520" loading="lazy" decoding="async"/>
          <span><small>Производственный объект</small><strong>НТФФ «Полисан»</strong><em>Фотографии и факты ↗</em></span>
        </a>
        <a href="/blog/detail/montazh-ventilyatsii-v-karelii/">
          <img src="/evidence/karelia/owner-cover-v43.webp" alt="Монтажная фотодокументация объекта PONSSE в Питкяранте" width="800" height="520" loading="lazy" decoding="async"/>
          <span><small>Питкяранта · Карелия</small><strong>PONSSE</strong><em>Работы и оригинал письма ↗</em></span>
        </a>
      </div>
    </div>
  </section>
  <section class="about-principle" aria-labelledby="about-principle-title">
    <div class="home-shell about-principle__grid">
      <div>
        <p class="section-index section-index--orange">01 / Как работаем</p>
        <h2 id="about-principle-title">Без лишнего — это не про “дешевле любой ценой”.</h2>
      </div>
      <div class="about-principle__body">
        <p>Сначала понимаем, что действительно требуется объекту и что входит в нашу работу.</p>
        <p>Не добавляем сложность только потому, что её можно продать. Существенный элемент системы должен иметь понятную функцию.</p>
        <p>Если проект конфликтует с реальным объектом, не превращаем это в незаметное изменение “по месту”: проблему нужно зафиксировать и согласовать.</p>
        <p>Состав сметы и исключения должны быть понятны до начала работ, а не появляться постфактум.</p>
      </div>
    </div>
  </section>

  <section class="home-section about-team" aria-labelledby="about-team-title">
    <div class="home-shell">
      <div class="about-team__intro">
        <div>
          <p class="section-index section-index--orange">02 / Люди и работа</p>
          <h2 id="about-team-title">Работаем на объекте сами. За результат отвечаем лично.</h2>
        </div>
        <div class="about-team__statement">
          <p>Постоянное ядро команды ведёт монтаж и техническую координацию. При большом объёме усиливаем состав проверенными монтажниками, не передавая управление работами случайной бригаде.</p>
          <p>Реальные фотографии специалистов и монтажных работ — из архива AEROVENTA.</p>
        </div>
      </div>
      {teamPhotos.length > 0 && (
        <div class="about-team__photos">
          {teamPhotos.map((photo, index) => (
            <figure class={index === 0 ? 'about-team__photo about-team__photo--lead' : 'about-team__photo'}>
              <img src={photo.src} alt={photo.alt} width={index===2?600:980} height={index===2?800:735} loading="lazy" decoding="async" />
              <figcaption>{photo.caption}</figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="about-history" aria-labelledby="about-history-title">
    <div class="home-shell">
      <div class="section-heading">
        <div>
          <p class="section-index section-index--orange">03 / Опыт через объекты</p>
          <h2 id="about-history-title">Наш опыт — в реализованных объектах.</h2>
        </div>
        <a href="/portfolio/">Все объекты →</a>
      </div>
      <div class="about-timeline">
        {timeline.map((item) => (
          <a href={item.href}>
            <span>{item.year}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <b>Открыть кейс →</b>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="conversion-close" aria-labelledby="about-close-title">
    <div class="home-shell">
      <p class="section-index section-index--orange">04 / Обсудить объект</p>
      <h2 id="about-close-title">Монтаж вентиляции начинается с вашей задачи.</h2>
      <div class="home-actions">
        <a class="button button--light" href="/montazh-po-proektu/">Передать проект →</a>
        <a class="button button--light" href="/obekt-bez-gotovogo-proekta/">Обсудить задачу</a>
      </div>
    </div>
  </section>
</article>

<style>
.about-proof__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(12px,2vw,24px)}
.about-proof__grid a{background:#193144;display:flex;flex-direction:column;color:#fff;text-decoration:none;min-width:0}
.about-proof__grid img{display:block;width:100%;height:auto;aspect-ratio:1.42;object-fit:cover}
.about-proof__grid span{display:flex;flex-direction:column;align-items:start;gap:9px;padding:clamp(16px,2vw,27px)}
.about-proof__grid small{font-size:.75rem;letter-spacing:.06em;color:#b5cbd7}
.about-proof__grid strong{font-size:clamp(1.25rem,2vw,1.9rem)}
.about-proof__grid em{font-style:normal;color:#f2a477;font-size:.85rem}
.about-proof__grid a:focus-visible{outline:3px solid #e98c43;outline-offset:3px}
@media(max-width:760px){.about-proof__grid{grid-template-columns:1fr}.about-proof__grid img{aspect-ratio:1.65}}

.about-team{background:#eaf0f3;border-top:1px solid #dae4e9;}
.about-team__intro{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.72fr);gap:clamp(24px,6vw,90px);align-items:end;margin-bottom:clamp(26px,4.3vw,62px);}
.about-team__intro h2{font-size:clamp(2.05rem,4vw,4.6rem);letter-spacing:-.047em;line-height:1.075;max-width:18ch;text-wrap:balance;}
.about-team__statement{max-width:54ch;font-size:clamp(1rem,1.3vw,1.15rem);line-height:1.7;color:#314a5a;}
.about-team__statement p+p{margin-top:17px;}
.about-team__photos{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:clamp(10px,1.45vw,22px);}
.about-team__photo{margin:0;background:#fff;min-width:0;}
.about-team__photo img{display:block;width:100%;height:auto;aspect-ratio:.94;object-fit:cover;object-position:center;}
.about-team__photo--lead img{aspect-ratio:1.3;}
.about-team__photo figcaption{padding:13px 16px;font-size:.82rem;line-height:1.45;color:#435a69;}
@media(max-width:960px){.about-team__intro{grid-template-columns:1fr;}.about-team__photos{grid-template-columns:1fr 1fr;}.about-team__photo--lead{grid-column:1/-1;}.about-team__photo--lead img{aspect-ratio:1.7;}}
@media(max-width:760px){.about-team__photos{grid-template-columns:1fr;}.about-team__photo--lead{grid-column:auto;}.about-team__photo img,.about-team__photo--lead img{aspect-ratio:1.35;}.about-team__intro h2{font-size:clamp(1.9rem,9vw,3.2rem);}}

</style>