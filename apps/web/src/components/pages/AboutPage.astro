---
import type { ContentRecord } from '@/lib/types';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
interface Props { content: ContentRecord; fixture: boolean; }
const { content } = Astro.props;

// Owner-confirmed team photography. Older technical shots are kept as historical assets,
// but are never silently substituted into the public team HERO.
const assetExists = (src: string) => ['apps/web/public' + src, 'public' + src].some(p => existsSync(resolve(p)));
// Exact Owner-mapped individual portraits. Show no guessed name/face association if the
// source asset has not yet been committed. No remote URL or invented substitute is used.
const ownerTeam = [
  { name:'Евгений Панов', role:'Технический директор', src:'/evidence/team/owner-evgeniy-panov-20261015.webp' },
  { name:'Александр Тарасов', role:'Операционный директор', src:'/evidence/team/owner-aleksandr-tarasov-20261013.webp' },
  { name:'Денис Иванов', role:'Руководитель проектов', src:'/evidence/team/owner-denis-ivanov-20261013.webp' },
  { name:'Александр Шаламов', role:'Инженер-проектировщик', src:'/evidence/team/owner-aleksandr-shalamov-20261013.webp' },
];
const teamGroupSrc = '/evidence/team/owner-team-group-20261015.webp';
const hasOwnerGroup = assetExists(teamGroupSrc);
const hasAllOwnerPortraits = ownerTeam.every(({src}) => assetExists(src));
// Fail closed: the site must not fall back to old installation photos or mismatched portraits.
if (!hasOwnerGroup || !hasAllOwnerPortraits) {
  throw new Error('Owner team photography incomplete — approved group and all four exact portraits required');
}

const timeline = [
  { year:'2017–2018', title:'НТФФ «Полисан»', text:'Монтаж приточно-вытяжной вентиляции и оборудования на фармацевтическом объекте.', href:'/blog/detail/ntff-polisan/' },
  { year:'2019', title:'Квартира на Маршала Жукова', text:'Приточно-вытяжная вентиляция в жилом объекте — доказательство, что работа не ограничивается крупным B2B.', href:'/blog/detail/kvartira-na-zhukova/' },
  { year:'2020', title:'7 PARK', text:'Семь домов в Павловске. Период работ: 18.11.2020–10.12.2020.', href:'/blog/detail/kak-my-sdali-7-domov/' },
  { year:'2021', title:'ЖК «Леонтьевский Мыс»', text:'Ресторан: монтаж приточно-вытяжной вентиляции и оборудования.', href:'/blog/detail/restoran-v-zhk-leontevskiy-mys/' },
  { year:'2022', title:'Питкяранта / Карелия', text:'Сервисно-образовательный центр: монтаж вентиляции и оборудования.', href:'/blog/detail/montazh-ventilyatsii-v-karelii/' },
];
---

<article class="about-premium">
  <header class="about-hero">
    <div class="home-shell about-hero__grid about-hero__grid--editorial">
      <div class="about-hero__introduction">
        <p class="home-kicker">О AEROVENTA</p>
        <h1>AEROVENTA — команда по монтажу вентиляции</h1>
      </div>
      <figure class="about-hero__team about-hero__team--group">
        <img src={teamGroupSrc} alt="Четыре участника команды AEROVENTA на фоне вентиляционного оборудования" width="1024" height="768" loading="eager" decoding="async" fetchpriority="high" />
        <figcaption>Команда AEROVENTA · монтаж вентиляции</figcaption>
      </figure>
      <div class="about-hero__continuation">
        <p class="about-hero__lede">Постоянное ядро команды держит технический и организационный контроль объекта. Когда объём или график требуют усиления, подключаем проверенных профильных специалистов.</p>
        <p class="home-geo">Работаем в Санкт-Петербурге и Ленинградской области. Берём объекты в Москве и Карелии.</p>
        <div class="home-actions">
          <a class="button button--primary" href="/portfolio/">Посмотреть объекты →</a>
          <a class="button button--ghost" href="/contact/" data-consultant-open data-source="about_inline" aria-haspopup="dialog" aria-controls="aeroventa-consultant-dialog">Задать вопрос по вентиляции</a>
        </div>
      </div>
    </div>
  </header>

  <section class="about-principle" aria-labelledby="about-principle-title">
    <div class="home-shell about-principle__grid">
      <div>
        <p class="section-index section-index--orange">01 / Как работаем</p>
        <h2 id="about-principle-title">Сначала разобраться. Затем смонтировать.</h2>
      </div>
      <div class="about-principle__body">
        <p>Сначала понимаем, что действительно требуется объекту и что входит в нашу работу.</p>
        <p>Состав и расположение оборудования определяем по назначению системы, проекту и условиям объекта.</p>
        <p>Если проект требует уточнения на площадке, согласовываем техническое решение до монтажа.</p>
        <p>Состав сметы и исключения должны быть понятны до начала работ, а не появляться постфактум.</p>
      </div>
    </div>
  </section>

  <section class="home-section about-team" aria-labelledby="about-team-title">
    <div class="home-shell">
      <div class="about-team__intro">
        <div>
          <p class="section-index section-index--orange">02 / Люди и работа</p>
          <h2 id="about-team-title">Работаем на объекте сами. За результат отвечаем лично.</h2>
        </div>
        <div class="about-team__statement">
          <p>Постоянное ядро команды ведёт монтаж и техническую координацию. При большом объёме усиливаем состав проверенными монтажниками, сохраняя техническую координацию объекта.</p>
          <p>У каждого направления работ есть ответственный специалист.</p>
        </div>
      </div>
      {hasAllOwnerPortraits ? (
        <div class="about-team__photos about-team__photos--owners">
          {ownerTeam.map(person => (
            <figure class:list={["about-team__photo", person.name === "Евгений Панов" && "about-team__photo--lead"]}>
              <img src={person.src} alt={`${person.name} — ${person.role}`} width="720" height="960" loading="lazy" decoding="async" />
              <figcaption><strong>{person.name}</strong><span>{person.role}</span></figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <div class="about-team__verified-names" aria-label="Состав команды AEROVENTA">
          {ownerTeam.map(person => <div><strong>{person.name}</strong><span>{person.role}</span></div>)}
        </div>
      )}
    </div>
  </section>

  <section class="about-case-highlight" aria-labelledby="about-case-highlight-title">
    <div class="home-shell about-case-highlight__grid">
      <figure>
        <img src="/evidence/7park/object-exterior-day.jpg" alt="Жилой квартал 7 PARK в Павловске: реальный объект AEROVENTA" width="800" height="450" loading="lazy" decoding="async"/>
        <figcaption>7 PARK · Павловск · семь домов</figcaption>
      </figure>
      <div>
        <p class="section-index">03 / Опыт на объектах</p>
        <h2 id="about-case-highlight-title">От частных помещений до жилых кварталов</h2>
        <p>В 7 PARK команда выполняла монтаж приточно-вытяжной вентиляции в семи домах. В кейсе — объект, трассы и сведения о выполненных работах.</p>
        <a href="/blog/detail/kak-my-sdali-7-domov/">Посмотреть 7 PARK ↗</a>
        <a href="/portfolio/">Наши работы →</a>
      </div>
    </div>
  </section>
  <section class="conversion-close" aria-labelledby="about-close-title">
    <div class="home-shell">
      <p class="section-index section-index--orange">04 / Обсудить объект</p>
      <h2 id="about-close-title">Монтаж вентиляции начинается с вашей задачи.</h2>
      <div class="home-actions">
        <button type="button" class="button button--light" data-project-open data-source="about_project">Передать проект →</button>
        <a class="button button--light" href="/contact/" data-contact-open data-source="about_close" aria-haspopup="dialog">Обсудить задачу</a>
      </div>
    </div>
  </section>
</article>

<style>
.about-proof__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(12px,2vw,24px)}
.about-proof__grid a{background:#193144;display:flex;flex-direction:column;color:#fff;text-decoration:none;min-width:0}
.about-proof__grid img{display:block;width:100%;height:auto;aspect-ratio:1.42;object-fit:cover}
.about-proof__grid span{display:flex;flex-direction:column;align-items:start;gap:9px;padding:clamp(16px,2vw,27px)}
.about-proof__grid small{font-size:.75rem;letter-spacing:.06em;color:#b5cbd7}
.about-proof__grid strong{font-size:clamp(1.25rem,2vw,1.9rem)}
.about-proof__grid em{font-style:normal;color:#f2a477;font-size:.85rem}
.about-proof__grid a:focus-visible{outline:3px solid #e98c43;outline-offset:3px}
@media(max-width:760px){.about-proof__grid{grid-template-columns:1fr}.about-proof__grid img{aspect-ratio:1.65}}

.about-team{background:#eaf0f3;border-top:1px solid #dae4e9;}
.about-team__intro{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.72fr);gap:clamp(24px,6vw,90px);align-items:end;margin-bottom:clamp(26px,4.3vw,62px);}
.about-team__intro h2{font-size:clamp(2.05rem,4vw,4.6rem);letter-spacing:-.047em;line-height:1.075;max-width:18ch;text-wrap:balance;}
.about-team__statement{max-width:54ch;font-size:clamp(1rem,1.3vw,1.15rem);line-height:1.7;color:#314a5a;}
.about-team__statement p+p{margin-top:17px;}
.about-team__photos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(10px,1.45vw,22px);}
.about-team__photo{margin:0;background:#fff;min-width:0;}
.about-team__photo img{display:block;width:100%;height:auto;aspect-ratio:3/4;object-fit:contain;object-position:center;}
.about-team__photo--lead img{aspect-ratio:3/4;}
.about-team__photo figcaption{padding:13px 16px;font-size:.82rem;line-height:1.45;color:#435a69;}
@media(max-width:960px){.about-team__intro{grid-template-columns:1fr;}.about-team__photos{grid-template-columns:repeat(2,minmax(0,1fr));}.about-team__photo:last-child{grid-column:1/-1;justify-self:center;width:min(100%,420px);}}
@media(max-width:760px){.about-team__photos{grid-template-columns:1fr;}.about-team__photo:last-child{grid-column:auto;width:100%;}.about-team__photo img{aspect-ratio:3/4;}.about-team__intro h2{font-size:clamp(1.9rem,9vw,3.2rem);}}


/* The four credited people remain grouped together; no guessed photo/name link. */
.about-team__photos--owners{grid-template-columns:repeat(4,minmax(0,1fr))}
.about-team__photos--owners .about-team__photo{background:transparent}
.about-team__photos--owners .about-team__photo img{aspect-ratio:3/4;object-fit:cover}
.about-team__photos--owners figcaption{padding:16px 0 0;display:grid;gap:3px}
.about-team__photos--owners figcaption strong{font-weight:650;color:#153044;font-size:1rem}
.about-team__photos--owners figcaption span{font-size:.85rem;line-height:1.5}
.about-team__verified-names{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(16px,2vw,32px);border-top:1px solid #b9ccd5}
.about-team__verified-names>div{padding-top:18px;display:grid;align-content:start;gap:8px}
.about-team__verified-names strong{font-size:clamp(1rem,1.3vw,1.25rem);line-height:1.3}
.about-team__verified-names span{font-size:.9rem;line-height:1.4;color:#4c6571}
.about-hero__team--group img{object-fit:contain;aspect-ratio:4/3;width:100%;height:auto}
@media(max-width:360px){
  /* 320 px: reserve an editorial photographic stage rather than crop or distort four people.
     Image remains fully visible at its natural 4:3 proportion, centered on the quiet backdrop. */
  .about-premium .about-hero__team--group img{
    display:block;
    width:100%;
    height:clamp(250px,78vw,280px);
    aspect-ratio:auto;
    object-fit:contain;
    object-position:center;
    background:#e7edf0;
  }
}
@media(max-width:960px){.about-team__photos--owners,.about-team__verified-names{grid-template-columns:repeat(2,minmax(0,1fr))}.about-team__photos--owners .about-team__photo:last-child{grid-column:auto;justify-self:auto;width:auto}}
@media(max-width:520px){.about-team__photos--owners,.about-team__verified-names{grid-template-columns:1fr 1fr;gap:20px 12px}.about-team__verified-names{gap:24px 16px}.about-team__photos--owners figcaption strong{font-size:.92rem}}

/* Owner photo first; copy and actions stay in the same editorial fold. */
.about-premium .about-hero{background:#f3f6f6;padding:clamp(27px,4.3vw,66px) 0}
.about-premium .about-hero__grid--editorial{display:grid;grid-template-columns:minmax(0,.86fr) minmax(0,1.14fr);gap:clamp(28px,4.6vw,86px);align-items:center}
.about-hero__introduction{min-width:0;display:flex;flex-direction:column;align-items:flex-start}
.about-hero__introduction h1{margin:clamp(14px,1.4vw,22px) 0 clamp(20px,3vw,43px);max-width:18ch;font-size:clamp(2.55rem,4.1vw,4.4rem);line-height:1.08;font-weight:530;letter-spacing:-.038em;text-wrap:balance}
.about-premium .about-hero__introduction .about-hero__lede{margin:0;max-width:51ch;font-size:clamp(1rem,1.25vw,1.15rem);line-height:1.64}
.about-hero__introduction .home-geo{margin:clamp(14px,1.8vw,25px) 0 0}
.about-hero__introduction .home-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:clamp(19px,2.4vw,35px)}
.about-premium .about-hero__team--group{align-self:center;margin:0;min-width:0}
.about-premium .about-hero__team--group img{display:block;aspect-ratio:4/3;object-fit:contain;max-height:none;width:100%;height:auto;background:#e5eced}
.about-premium .about-hero__team--group figcaption{font-size:.77rem;line-height:1.45;padding-top:12px;color:#526a74}
.about-team__intro h2{max-width:21ch;font-size:clamp(2rem,3.35vw,3.6rem);line-height:1.12;font-weight:560}
@media(max-width:960px){
 .about-premium .about-hero__grid--editorial{grid-template-columns:1fr;gap:clamp(22px,4vw,38px)}
 .about-hero__introduction h1{max-width:24ch;font-size:clamp(2.25rem,5.7vw,3.75rem)}
 .about-premium .about-hero__team--group img{max-height:none}
}
@media(max-width:760px){
 .about-premium .about-hero{padding:24px 0 30px}
 .about-hero__introduction h1{font-size:clamp(2.1rem,8vw,3.2rem);max-width:18ch;margin:15px 0 21px}
 .about-hero__introduction .home-actions{margin-top:20px}
 .about-premium .about-hero__team--group img{max-width:100%;height:auto}
}


/* Final first fold: the group portrait follows the headline before mobile supporting copy. */
.about-premium .about-hero__grid--editorial{grid-template-rows:auto auto;align-items:start}
.about-premium .about-hero__introduction{grid-column:1;grid-row:1;align-self:end}
.about-premium .about-hero__continuation{grid-column:1;grid-row:2;min-width:0;align-self:start;display:flex;flex-direction:column;align-items:flex-start}
.about-premium .about-hero__continuation .about-hero__lede{margin:0;max-width:51ch;font-size:clamp(1rem,1.25vw,1.15rem);line-height:1.64}
.about-premium .about-hero__continuation .home-geo{margin:clamp(14px,1.8vw,25px) 0 0}
.about-premium .about-hero__continuation .home-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:clamp(19px,2.4vw,35px)}
.about-premium .about-hero__grid--editorial>.about-hero__team{grid-column:2;grid-row:1/span 2;align-self:center}
@media(max-width:960px){
 .about-premium .about-hero__grid--editorial{grid-template-columns:1fr;grid-template-rows:auto auto auto;gap:18px}
 .about-premium .about-hero__introduction{grid-column:1;grid-row:1}
 .about-premium .about-hero__grid--editorial>.about-hero__team{grid-column:1;grid-row:2;align-self:start}
 .about-premium .about-hero__continuation{grid-column:1;grid-row:3}
}
@media(max-width:760px){
 .about-premium .about-hero__grid--editorial{gap:15px}
 .about-premium .about-hero__introduction h1{margin:13px 0 6px;max-width:20ch;font-size:clamp(2.02rem,7.8vw,3.15rem)}
 .about-premium .about-hero__team--group img{width:100%;height:clamp(260px,78vw,390px);aspect-ratio:auto;object-fit:contain;max-height:none}
 .about-premium .about-hero__continuation{padding-top:4px}
 .about-premium .about-hero__continuation .about-hero__lede{font-size:.96rem;line-height:1.6}
}

</style>