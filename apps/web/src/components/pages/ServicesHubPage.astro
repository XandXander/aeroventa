---
import type { ContentRecord } from '@/lib/types';
interface Props { content: ContentRecord; fixture: boolean; }
const directions = [
  ['Производство','Режим предприятия, оборудование и монтажные зоны.','/obekty/proizvodstvo/','/evidence/polisan/owner-cover-v43.webp','НТФФ «Полисан» · Санкт-Петербург'],
  ['Рестораны и кафе','Кухня, зал и согласование с отделочными работами.','/obekty/restorany-i-kafe/','/evidence/cafe/owner-interior-v43.webp','Кафе · Римского-Корсакова, 3'],
  ['Новостройки','Работы по корпусам и повторяемый монтажный объём.','/obekty/novostroyki/','/evidence/owner-portfolio/akvilon-yanino/cover.webp','ЖК «Аквилон» · Янино'],
  ['Квартиры и дома','Пространство для трасс, уровень шума и стадия отделки.','/obekty/kvartiry-i-doma/','/evidence/zhukov/owner-cover-v43.webp','Квартира · Маршала Жукова'],
  ['Склады','Высота помещений, доступ и график проведения работ.','/obekty/sklady/','/evidence/warehouses/farm-spb/01.webp','Фармацевтический склад · Санкт-Петербург'],
  ['Офисы и коммерция','План помещений и доступ к инженерным системам.','/obekty/ofisy-i-kommerciya/','/evidence/owner-portfolio/apart-hotel/cover.webp','Апарт-отель и коворкинг · Бумажный'],
];
---
<article class="hub-page av-page av-services">
  <header class="av-hero av-hero--services">
    <div class="av-shell av-hero__grid">
      <div class="av-hero__title"><p class="av-kicker">Услуги и возможности</p><h1>Что мы делаем по вентиляции</h1></div>
      <figure class="av-hero__image"><img src="/evidence/hero/project-not-ready-owner-concept-1672.webp" width="1672" height="941" loading="eager" fetchpriority="high" decoding="async" alt="Художественная архитектурная визуализация: голубая схема вентиляции в панорамном интерьере" /></figure>
      <div class="av-hero__body"><p class="av-lead">Монтируем системы вентиляции в жилых, коммерческих и производственных зданиях.</p><p>Работаем по готовому проекту. Если документации пока нет — уточняем задачу и данные, необходимые для оценки монтажа.</p><p class="av-geo">Санкт-Петербург и Ленинградская область · Москва · Карелия</p><a class="button button--primary" href="/contact/" data-contact-open data-source="services_hero" aria-haspopup="dialog">Обсудить задачу →</a></div>
    </div>
  </header>
  <nav class="av-shell av-routes" data-first-fold-boundary aria-label="Ключевые направления работ">
      <a href="/montazh-ventiliacii/"><span>01 / Состав работ</span><strong>Монтаж вентиляции</strong><b aria-hidden="true">↗</b></a>
      <a href="/montazh-po-proektu/"><span>02 / Документация готова</span><strong>Монтаж по проекту</strong><b aria-hidden="true">↗</b></a>
      <a href="/obekt-bez-gotovogo-proekta/"><span>03 / На стадии задачи</span><strong>Объект без проекта</strong><b aria-hidden="true">↗</b></a>
    </nav>
  <section class="av-section av-scope" aria-labelledby="services-competence-title">
    <div class="av-shell av-scope__grid">
      <figure class="av-scope__photo"><a href="/blog/detail/montazh-ventilyatsii-v-karelii/"><img src="/evidence/karelia/owner-cover-v43.webp" width="1280" height="960" loading="lazy" decoding="async" alt="Здание сервисно-образовательного центра PONSSE" /></a><figcaption>PONSSE · Питкяранта <a href="/blog/detail/montazh-ventilyatsii-v-karelii/">Смотреть работы ↗</a></figcaption></figure>
      <div class="av-scope__copy"><p class="av-kicker">Монтаж и оборудование</p><h2 id="services-competence-title">От трассы воздуховода до установки оборудования</h2><p>Монтируем воздуховоды, фасонные элементы, крепления и вентиляционное оборудование. Учитываем проект, назначение помещений и доступ к месту работ.</p><dl class="av-register"><div><dt>Перед началом</dt><dd>Сверяем документацию с условиями площадки и уточняем состав сметы.</dd></div><div><dt>На объекте</dt><dd>Согласовываем последовательность монтажа со смежными работами.</dd></div><div><dt>Для большого объёма</dt><dd>Усиливаем постоянную команду проверенными профильными специалистами.</dd></div></dl><a class="av-link" href="/montazh-ventiliacii/">Подробнее о монтажных работах →</a></div>
      <aside class="av-scope__note"><strong>Дополнительные работы</strong><p>Проектирование, пусконаладку, балансировку и автоматику согласовываем по задаче конкретного объекта. При необходимости проходок привлекаем профильных исполнителей алмазного бурения.</p></aside>
    </div>
  </section>
  <section class="av-section av-directions" aria-labelledby="services-directions-title">
    <div class="av-shell"><div class="av-heading"><div><p class="av-kicker">Разные объекты — разные условия</p><h2 id="services-directions-title">Где мы работаем</h2></div><a class="av-link" href="/portfolio/">Выполненные объекты →</a></div><div class="av-directions__grid">{directions.map(([title,text,href,image,caption])=><a class="av-direction" href={href}><div class="av-direction__image"><img src={image} alt={caption} width="800" height="600" loading="lazy" decoding="async"/><span>{caption}</span></div><div class="av-direction__copy"><h3>{title}</h3><p>{text}</p><b aria-hidden="true">↗</b></div></a>)}</div></div>
  </section>
  <section class="av-close"><div class="av-shell av-close__grid"><div><p class="av-kicker">Ваш объект</p><h2>Обсудим задачу по вентиляции</h2></div><a class="button button--primary" href="/contact/" data-contact-open data-source="services_final" aria-haspopup="dialog">Связаться с командой →</a></div></section>
</article>
