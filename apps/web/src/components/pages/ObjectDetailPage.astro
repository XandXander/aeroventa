---
import type { ContentRecord } from '@/lib/types';

interface EvidenceItem {
  title: string;
  meta: string;
  detail: string;
  href: string;
  image?: string;
  imageAlt?: string;
}

interface Props {
  content: ContentRecord;
  eyebrow: string;
  lede: string;
  constraints: Array<[string,string,string]>;
  drivers: string[];
  evidence: EvidenceItem[];
  questions: string[];
  proofTitle: string;
  visualVariant?: 'residential' | 'restaurants';
  heroMedia?: { src: string; alt: string; caption: string };
  secondaryMedia?: { src: string; alt: string; caption: string };
}

const { content, eyebrow, lede, constraints, drivers, evidence, questions, proofTitle, visualVariant, heroMedia, secondaryMedia } = Astro.props;
---

<article class:list={['object-detail', visualVariant && `object-detail--${visualVariant}`]}>
  <header class="object-detail__hero">
    <div class="home-shell object-detail__hero-grid">
      <div>
        <p class="home-kicker">{eyebrow}</p>
        <h1>{content.h1}</h1>
      </div>
      <div>
        <p class="object-detail__lede">{lede}</p>
        <p class="home-geo">Санкт-Петербург · Ленинградская область · Москва · Карелия</p>
        <div class="home-actions">
          <a class="button button--primary" href="/montazh-po-proektu/">Монтаж по готовому проекту →</a>
          <a class="button button--ghost" href="/obekt-bez-gotovogo-proekta/">Подготовка исходных данных</a>
        </div>
      </div>
      {heroMedia && (
        <figure class="object-detail__hero-media">
          <img src={heroMedia.src} alt={heroMedia.alt} width="800" height="450" fetchpriority="high" />
          {heroMedia.caption && <figcaption>{heroMedia.caption}</figcaption>}
        </figure>
      )}
    </div>
  </header>

  <section class="object-evidence" aria-labelledby="object-evidence-title">
    <div class="home-shell">
      <p class="section-index section-index--orange">01 / Реальные объекты</p>
      <h2 id="object-evidence-title">{proofTitle}</h2>
      <div class="object-evidence__grid">
        {evidence.map((item) => (
          <a href={item.href}>
            {item.image && <img class="object-evidence__photo" src={item.image} alt={item.imageAlt || item.title} width="800" height="450" loading="lazy" />}
            <span>{item.meta}</span>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
            <b>Открыть кейс →</b>
          </a>
        ))}
      </div>
      {secondaryMedia && (
        <figure class="object-evidence__installation">
          <img src={secondaryMedia.src} alt={secondaryMedia.alt} width="600" height="600" loading="lazy" />
          <figcaption>{secondaryMedia.caption}</figcaption>
        </figure>
      )}
    </div>
  </section>

  <section class="home-section object-constraints" aria-labelledby="object-constraints-title">
    <div class="home-shell">
      <p class="section-index">02 / Что меняет монтаж</p>
      <h2 id="object-constraints-title">Ограничения объекта важнее типового названия системы.</h2>
      <div class="object-constraints__grid">
        {constraints.map(([number,title,text]) => (
          <article><span>{number}</span><h3>{title}</h3><p>{text}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="object-drivers" aria-labelledby="object-drivers-title">
    <div class="home-shell object-drivers__grid">
      <div>
        <p class="section-index section-index--orange">03 / Стоимость и срок</p>
        <h2 id="object-drivers-title">Что реально двигает монтажный объём.</h2>
        <p>Не публикуем универсальную ставку «за м²»: одинаковая площадь не означает одинаковые трассы, оборудование и условия работ.</p>
      </div>
      <div class="driver-list">
        {drivers.map((item,index) => <div><span>{String(index+1).padStart(2,'0')}</span><strong>{item}</strong></div>)}
      </div>
    </div>
  </section>

  <section class="home-section object-questions" aria-labelledby="object-questions-title">
    <div class="home-shell object-questions__grid">
      <div>
        <p class="section-index">04 / До монтажа</p>
        <h2 id="object-questions-title">Вопросы, которые лучше закрыть до выхода бригады.</h2>
        <a href="/faq/">Все инженерные вопросы →</a>
      </div>
      <div class="question-list">
        {questions.map((question,index) => (
          <a href="/faq/"><span>{String(index+1).padStart(2,'0')}</span>{question}<b aria-hidden="true">→</b></a>
        ))}
      </div>
    </div>
  </section>

  <section class="conversion-close" aria-labelledby="object-close-title">
    <div class="home-shell">
      <p class="section-index section-index--orange">05 / Следующий шаг</p>
      <h2 id="object-close-title">Пришлите то, что уже есть. Не нужно сначала собирать идеальный пакет.</h2>
      <div class="engagement-index engagement-index--dark engagement-index--close">
        <a href="/montazh-po-proektu/">
          <span>01</span>
          <div><strong>Готовая проектная документация</strong><p>Перейти к монтажному объёму, вопросам исполнения и коммерческому предложению.</p></div>
          <b aria-hidden="true">→</b>
        </a>
        <a href="/obekt-bez-gotovogo-proekta/">
          <span>02</span>
          <div><strong>Исходные данные ещё формируются</strong><p>Определить, что требуется до технически корректной оценки монтажа.</p></div>
          <b aria-hidden="true">→</b>
        </a>
      </div>
    </div>
  </section>
</article>
