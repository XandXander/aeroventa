---
import type { ContentRecord } from '@/lib/types';
interface Props { content: ContentRecord; fixture: boolean; }
const chapters = [
  {
    "id": "estimate",
    "index": "01",
    "title": "До расчёта",
    "questions": [
      [
        "Можно ли понять стоимость монтажа без проекта?",
        "Для предварительного обсуждения подойдут план, фотографии и описание задачи. Смету готовят по достаточному набору исходных данных: составу системы, оборудованию, трассам и условиям монтажа."
      ],
      [
        "Что прислать для предварительной оценки?",
        "Тип объекта, адрес, текущую стадию и описание требуемых работ. При наличии приложите рабочие чертежи, спецификацию, план и фотографии. Недостающие данные уточним после просмотра материалов."
      ],
      [
        "Когда достаточно плана, а когда нужен проект?",
        "План помогает обсудить задачу и понять, какие данные нужны дальше. Проект задаёт техническое решение: систему, оборудование, трассы и узлы. Необходимость проектного этапа уточняют до согласования монтажных работ."
      ],
      [
        "От чего зависит стоимость монтажа кроме площади?",
        "Площадь — один из исходных параметров. На объём монтажа также влияют длина и сечения воздуховодов, оборудование, высота, доступ и стадия отделки. Для сравнения предложений нужен одинаковый состав работ."
      ],
      [
        "Можно ли оценить объект, если он ещё строится?",
        "Да, если есть планы и известно назначение помещений. Для расчёта дополнительно уточняют строительную готовность, фактические размеры, доступ и последовательность работ на площадке."
      ]
    ]
  },
  {
    "id": "system",
    "index": "02",
    "title": "Выбор системы",
    "questions": [
      [
        "Как определить необходимый состав системы?",
        "У оборудования и элементов системы должна быть понятная функция, связанная с задачей объекта. Состав системы и необходимость дополнительных решений рассматривают по проекту и исходным данным."
      ],
      [
        "Почему два предложения на один объект могут сильно отличаться?",
        "Предложения могут включать разные системы, оборудование, объёмы монтажа и дополнительные работы. Сначала сопоставляют эти позиции, затем итоговую стоимость."
      ],
      [
        "От чего зависит размер воздуховодов и сколько места они займут?",
        "Сечения воздуховодов связаны с расходом воздуха, схемой системы и условиями прокладки. Требуемое пространство уточняют по проекту, включая крепления, изоляцию и доступ к оборудованию."
      ],
      [
        "Откуда появляется шум и когда о нём думать?",
        "На шум влияют оборудование, скорость воздуха, вибрация, расположение воздухораспределителей и монтаж. Акустические требования и условия размещения учитывают при выборе решений, до отделки помещений."
      ],
      [
        "Можно ли использовать существующие шахты, воздуховоды или оборудование?",
        "Возможность использования проверяют по состоянию, назначению и характеристикам существующих элементов. Для решения нужны сведения о системе и её фактическое обследование в необходимом для задачи объёме."
      ]
    ]
  },
  {
    "id": "start",
    "index": "03",
    "title": "Подготовка монтажа",
    "questions": [
      [
        "Что должно быть решено до выхода монтажников?",
        "Состав работ, рабочие решения, расположение трасс и оборудования, доступ, последовательность и порядок согласования изменений. Эти сведения позволяют организовать выход монтажников на площадку."
      ],
      [
        "Что меняется, если чистовая отделка уже начата?",
        "Уточняют доступ к трассам, защиту отделки, допустимые зоны работ и расположение проходок. Последовательность монтажа согласовывают с текущим состоянием помещений и смежными работами."
      ],
      [
        "Что делать, если проект расходится с условиями объекта?",
        "Уточнить расхождение по документации и на площадке. Техническое решение и изменение затронутых работ согласовать с ответственными участниками до выполнения монтажа."
      ],
      [
        "Как вентиляция увязывается с электрикой, водой, потолками и конструкциями?",
        "Взаимное расположение систем проверяют по документации и фактическим условиям. Важно согласовать места пересечений, проходки, крепления и доступ для монтажа и обслуживания."
      ],
      [
        "Какие условия объекта сильнее всего влияют на монтаж?",
        "Высота, доступ к рабочим зонам, состояние отделки, режим действующего здания и готовность смежных работ. Также учитывают доставку, хранение и перемещение материалов внутри объекта."
      ]
    ]
  },
  {
    "id": "scope",
    "index": "04",
    "title": "Смета и состав работ",
    "questions": [
      [
        "Как правильно сравнивать две сметы?",
        "Сопоставить состав системы, объёмы, оборудование, включённые и отдельно согласуемые работы. Затем проверить условия доступа, сроки и состав документов, предусмотренных договором."
      ],
      [
        "Что проверить в предложениях с разной ценой?",
        "Итог зависит от включённого состава работ. Если в предложениях учтены разные объёмы, оборудование или условия, сначала нужно привести их к сопоставимому перечню."
      ],
      [
        "Что часто остаётся за рамками одной итоговой цифры?",
        "Возможные отдельные позиции — оборудование, проходки, электрика, автоматика, пусконаладка, документация и организация доступа. Их наличие и объём проверяют в конкретном предложении."
      ],
      [
        "Что должно быть зафиксировано до начала работ?",
        "Состав работ, исходная документация, условия площадки, порядок взаимодействия, согласования изменений и приёмки. Дополнительные работы и документы также фиксируют по договорённости."
      ],
      [
        "Как согласовывать изменения, если на объекте выяснилось новое?",
        "Зафиксировать новые условия, определить затронутые работы и согласовать техническое решение. Если меняются объём, стоимость или последовательность монтажа, это отражают в договорённостях."
      ]
    ]
  },
  {
    "id": "work",
    "index": "05",
    "title": "Во время работ",
    "questions": [
      [
        "Можно ли монтировать вентиляцию на действующем объекте?",
        "Это зависит от назначения здания и допустимого режима работ. До начала согласовывают время, доступ, шумные и пыльные операции, требования к безопасности и сохранности помещений."
      ],
      [
        "Можно ли вести монтаж поэтапно?",
        "Да, когда система и организация площадки позволяют разделить работы. Этапы, доступ, материалы и проверку скрываемых участков согласовывают заранее."
      ],
      [
        "Что фиксировать до зашивки потолков и шахт?",
        "Расположение трасс, соединения, крепления и доступ к обслуживаемым элементам. Способ фиксации и состав проверок определяют для конкретного объекта и согласованного объёма работ."
      ],
      [
        "Кто принимает технические решения по ходу монтажа?",
        "Ответственные участники определяются проектом и договорённостями по объекту. Возникающие изменения согласовываются с ними до выполнения соответствующего участка монтажа."
      ],
      [
        "Как согласовать узел, который нельзя смонтировать по чертежу?",
        "Зафиксировать условия площадки и согласовать выполнимое техническое решение с ответственными участниками. Изменение трассы или узла должно учитываться в документации и составе работ в необходимом объёме."
      ]
    ]
  },
  {
    "id": "acceptance",
    "index": "06",
    "title": "Приёмка",
    "questions": [
      [
        "Что проверить до закрытия потолков и шахт?",
        "Соответствие согласованному решению, соединения, крепления и доступ к обслуживанию. Перечень проверок зависит от системы, проекта и этапа работ."
      ],
      [
        "Какие элементы должны остаться доступными после отделки?",
        "Оборудование и элементы, для которых предусмотрены обслуживание, регулировка или замена. Зоны доступа определяют по проекту и требованиям конкретного оборудования до завершения отделки."
      ],
      [
        "Как проверяют результат работы вентиляции?",
        "Проверяют критерии, предусмотренные проектом и согласованным составом работ. Это могут быть направления и режимы работы, настройки и измерения. Пусконаладку и балансировку согласовывают отдельно."
      ],
      [
        "Какие документы или данные должны остаться у заказчика?",
        "Состав зависит от проекта и договора: рабочая документация с изменениями, паспорта оборудования, акты, исполнительные материалы и результаты наладки — в предусмотренном для объекта объёме."
      ],
      [
        "Когда работу можно считать завершённой?",
        "После выполнения согласованного объёма и приёмки по установленным для объекта критериям. Порядок проверки результата, документы и оставшиеся вопросы фиксируют в договорённостях."
      ]
    ]
  }
];
---
<article class="faq-hub av-page av-faq">
  <header class="av-shell av-faq__intro"><p class="av-kicker">Вопросы заказчика</p><h1>Что важно решить до монтажа вентиляции</h1><p class="av-lead">Как подготовить исходные данные, сравнить сметы и согласовать работы. 30 ответов — от первого обращения до приёмки.</p></header>
  <nav class="av-shell av-faq__topics" aria-label="Разделы вопросов">{chapters.map(chapter=><button type="button" data-faq-chapter={chapter.id}><span>{chapter.index}</span>{chapter.title}<b aria-hidden="true">↓</b></button>)}</nav>
  <div class="av-faq__body">{chapters.map((chapter,chapterIndex)=><section class="av-faq__chapter" id={chapter.id} aria-labelledby={chapter.id+'-title'}><header><span>{chapter.index}</span><h2 id={chapter.id+'-title'} tabindex="-1">{chapter.title}</h2></header><div class="faq-question-list">{chapter.questions.map(([question,answer],index)=><details class="faq-question" open={chapterIndex===0&&index===0}><summary><span>{String(index+1).padStart(2,'0')}</span><strong>{question}</strong><b aria-hidden="true">+</b></summary><div class="faq-question__answer"><p>{answer}</p></div></details>)}</div></section>)}</div>
  <section class="av-close"><div class="av-shell av-close__grid"><div><p class="av-kicker">Ваш объект</p><h2>Уточним вашу задачу</h2><p>Пришлите описание, документацию или фотографии объекта.</p></div><button class="button button--primary" type="button" data-contact-open data-source="faq_close">Задать вопрос →</button></div></section>
</article>
<script>
for (const control of document.querySelectorAll<HTMLButtonElement>('[data-faq-chapter]')) {
  control.addEventListener('click', () => {
    const section = document.getElementById(control.dataset.faqChapter || '');
    const heading = section?.querySelector<HTMLElement>('h2');
    heading?.focus({preventScroll:true});
    section?.scrollIntoView({block:'start',behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});
  });
}
</script>
