---
import type { ContentRecord } from '@/lib/types';

interface Props { content: ContentRecord; fixture: boolean; }
const { content } = Astro.props;

type ArticleSpec = {
  kicker: string;
  signal: string;
  lede: string;
  sourceNote: string;
  verdictTitle: string;
  verdict: string;
  sections: Array<{
    index: string;
    title: string;
    copy?: string;
    items?: string[];
    note?: string;
  }>;
  historicalTitle: string;
  historicalText: string;
  related: Array<[string,string,string]>;
  ctaTitle: string;
  ctaText: string;
};

const specs: Record<string, ArticleSpec> = {
  '/blog/detail/kak-vytashchit-zastryavshuyu-koronku-iz-betona/': {
    kicker: 'Практика / исторический опыт',
    signal: 'Одна из самых читаемых архивных страниц AEROVENTA',
    lede: 'Если алмазную коронку заклинило, первое действие — не пытаться «додавить» машину. Снять нагрузку, остановить привод и понять причину. Чем дольше установка работает в заклинивании, тем выше риск повредить коронку, крепление или саму машину.',
    sourceNote: 'Материал восстановлен из старой статьи AEROVENTA и обновлён так, чтобы отделить реальный полевой опыт от устаревших приёмов. Конкретная процедура производителя всегда имеет приоритет.',
    verdictTitle: 'Сначала остановить. Потом разбираться с причиной.',
    verdict: 'Заклинивание — не сигнал добавить усилие. Безопасный порядок начинается с остановки привода, снятия нагрузки и проверки причины. Перед повторным запуском коронка должна двигаться свободно, а установка — оставаться надёжно закреплённой.',
    sections: [
      { index:'01', title:'Почему коронку может заклинить', copy:'Причина не всегда одна. На практике сопротивление может резко измениться из-за материала, фрагмента керна или условий самого процесса.', items:[
        'Фрагмент керна или отколовшийся кусок материала заклинивает внутри реза.',
        'Арматура или металлический фрагмент меняет характер сопротивления.',
        'Недостаточный отвод шлама / охлаждение ухудшает работу коронки.',
        'Смещение оси или установки создаёт боковую нагрузку.',
        'Коронка или оснастка не соответствует фактическому материалу/состоянию.'
      ]},
      { index:'02', title:'Что делать сначала', copy:'Не универсальная «интернет-инструкция», а безопасная последовательность решений.', items:[
        'Снять давление и остановить привод.',
        'Отключить установку в соответствии с процедурой конкретной модели.',
        'Проверить, можно ли освободить вращение без нагрузки на мотор.',
        'Определить видимую причину заклинивания, если это возможно.',
        'Использовать штатный способ освобождения / подходящий extractor, предусмотренный для задачи.',
        'Перед запуском убедиться, что коронка снова движется свободно и установка закреплена.'
      ], note:'Для проходных отверстий отдельно контролируют и защищают противоположную сторону. Руководство производителя важнее универсального совета.'},
      { index:'03', title:'Когда нужен специальный съёмник', copy:'Штатный extractor / обратный молоток создаёт контролируемое осевое усилие и позволяет работать с коронкой, не превращая привод установки в ударный инструмент.', items:[
        'Подходит, когда обычное освобождение не помогает.',
        'Предпочтительнее случайных ударов по оборудованию.',
        'Конкретный инструмент и порядок зависят от системы и производителя.'
      ]},
      { index:'04', title:'Как снизить вероятность повторения', items:[
        'Надёжно закреплять и сохранять геометрию установки.',
        'Подбирать коронку под фактический материал.',
        'Следить за охлаждением и удалением шлама там, где это требуется системой.',
        'Не продолжать давить при резком изменении сопротивления.',
        'Учитывать арматуру, состояние керна и противоположную сторону проходки.'
      ]}
    ],
    historicalTitle: 'Полевой приём из старой статьи — сохраняем как историю, не как рекомендацию.',
    historicalText: 'В старой версии материала AEROVENTA подробно описывалось самодельное приспособление из стяжной шпильки и гайки — так выходили из ситуации до появления штатного съёмника. Этот фрагмент остаётся частью реального опыта, но не современной пошаговой рекомендацией: сегодня правильнее опираться на процедуру производителя и подходящий extractor.',
    related:[
      ['Алмазное бурение: текущая модель','/almaznoe-burenie/','Отдельные буровые заявки сейчас относятся к партнёрскому/смежному исполнению.'],
      ['От чего зависит цена бурения','/blog/detail/stoimost-almaznogo-bureniya-kak-rasschitat-tsenu/','Разобрать факторы цены без старого прайса.'],
      ['Отверстие под вентиляцию','/blog/detail/gorizontalnoe-almaznoe-burenie/','Когда проходка является частью вентиляционной задачи.']
    ],
    ctaTitle:'Нужно отверстие именно под вентиляцию?',
    ctaText:'Опишите стену или перекрытие, толщину, предполагаемый диаметр и задачу. По вентиляционной части определим следующий шаг; отдельное бурение при необходимости координируется как смежная работа.'
  },

  '/blog/detail/almaznoe-burenie-v-styazhke-pod-stoyaki-otopleniya/': {
    kicker:'Практика / реальный исторический объект',
    signal:'Статья до сих пор сохраняет поисковый спрос',
    lede:'Через перекрытие часто приходится проходить не один однородный слой. В старой статье AEROVENTA зафиксирован объект, где отверстия под стояки отопления проходили через стяжку, минеральную вату и бетон при уже выполненной части отделки.',
    sourceNote:'Все размеры ниже относятся к конкретному историческому объекту и не являются универсальной конструкцией пола.',
    verdictTitle:'Слоистость перекрытия и состояние отделки меняют организацию работ.',
    verdict:'В таком узле важно не только выбрать диаметр. Нужно понимать, во что крепится стойка, что находится под стяжкой, как защитить готовые поверхности и что происходит на противоположной стороне проходки.',
    sections:[
      { index:'01', title:'Что было на объекте', items:[
        'Общая толщина описанной в статье конструкции — около 290 мм на конкретном участке.',
        'Слои: стяжка, минеральная вата и бетонное перекрытие.',
        'Стяжка на этом объекте описывалась как примерно 4–5 см.',
        'Рядом уже были стены, закрытые гипсокартоном.',
        'Нужно было выполнить пару проходок под подающий и обратный стояк отопления.'
      ]},
      { index:'02', title:'Почему крепление установки было отдельной задачей', copy:'Стойка должна передавать усилие в основание, которое способно его удерживать. Тонкую стяжку нельзя автоматически считать несущим бетоном.', items:[
        'На историческом объекте применили сквозное крепление как решение конкретной конструкции.',
        'Это не означает, что один и тот же способ подходит любому перекрытию.',
        'Для проходного бурения отдельно защищают людей и рабочую зону на противоположной стороне.'
      ]},
      { index:'03', title:'Разметка и защита готовой поверхности', items:[
        'До появления воды и шлама важно зафиксировать ось/точку проходки.',
        'Готовые стены и отделку нужно защищать от воды и загрязнения.',
        'Обычная разметка может стать плохо читаемой в мокрой зоне — это учитывают заранее.'
      ]},
      { index:'04', title:'Армирующая сетка и изменение сопротивления', copy:'Армирование в стяжке меняет характер проходки. Правильная реакция — внимание к изменившемуся сопротивлению, а не “додавить любой ценой”.'},
      { index:'05', title:'Что прислать для нормальной оценки похожей задачи', items:[
        'Толщину и состав перекрытия, если они известны.',
        'Количество и диаметры отверстий.',
        'Чертёж / точки проходок.',
        'Фото готовой отделки рядом.',
        'Доступ с обеих сторон.',
        'Ограничения по воде, электричеству и времени работ.'
      ]}
    ],
    historicalTitle:'Что из старого материала не переносим.',
    historicalText:'Не возвращаем формулировку о «приоритетном направлении», старый рекламный призыв и универсальные утверждения про конкретный анкер. AEROVENTA сохраняет статью как инженерный архив и поисковый актив; отдельное алмазное бурение сегодня не является основной собственной услугой команды.',
    related:[
      ['От чего зависит стоимость бурения','/blog/detail/stoimost-almaznogo-bureniya-kak-rasschitat-tsenu/','Собрать исходные данные для расчёта.'],
      ['Алмазное бурение','/almaznoe-burenie/','Текущая партнёрская модель исполнения.'],
      ['Монтаж вентиляции','/montazh-ventiliacii/','Если проходки являются частью вентиляционного объекта.']
    ],
    ctaTitle:'Проходки — часть более крупной инженерной задачи?',
    ctaText:'Пришлите проект или узел. Если задача связана с вентиляцией, сначала увяжем проходку с трассой и составом монтажных работ, а не будем рассматривать отверстие отдельно от системы.'
  },

  '/blog/detail/stoimost-almaznogo-bureniya-kak-rasschitat-tsenu/': {
    kicker:'Практика / решение до заказа',
    signal:'Сохраняем логику расчёта, а не старый прайс',
    lede:'Цена алмазного бурения — не одна цифра «за отверстие». Даже если подрядчик считает проходку по сантиметрам, итог зависит от геометрии, материала, условий объекта и организационных затрат.',
    sourceNote:'Старая статья AEROVENTA была написана в период собственного выполнения буровых работ. Старые цены и заявления о текущей собственной бригаде намеренно не переносим.',
    verdictTitle:'Сначала сравнивайте исходные данные и состав работ — потом цену.',
    verdict:'Два одинаковых базовых тарифа могут давать разный итог: один включает выезд, защиту и сложный доступ, другой добавляет их позже. Поэтому полезный расчёт начинается с одинакового набора исходных данных.',
    sections:[
      { index:'01', title:'Геометрия', items:[
        'Диаметр отверстия.',
        'Толщина / глубина проходки.',
        'Количество отверстий.',
        'Направление или угол, если задача не стандартная.'
      ]},
      { index:'02', title:'Что именно бурим', items:[
        'Кирпич, бетон, железобетон или слоистая конструкция.',
        'Армирование и фактическое состояние материала.',
        'Неоднородные слои и неизвестные включения.'
      ]},
      { index:'03', title:'Условия объекта', items:[
        'Высота и доступ.',
        'Готовая отделка или действующее помещение.',
        'Защита поверхностей и сбор воды.',
        'Электричество / вода — когда они требуются выбранной технологии.',
        'Парковка, занос, логистика и разрешённые рабочие окна.'
      ]},
      { index:'04', title:'Почему «рублей за сантиметр» недостаточно', items:[
        'Минимальный выезд / мобилизация.',
        'Установка и крепление оборудования.',
        'Защита и уборка рабочей зоны.',
        'Сложный доступ и высота.',
        'Износ оснастки, расходники и сервис.',
        'Дополнительные операции по фактической конструкции.'
      ]},
      { index:'05', title:'Что прислать для осмысленного расчёта', items:[
        'Локацию объекта.',
        'Количество отверстий.',
        'Диаметры.',
        'Толщину / глубину.',
        'Материал конструкции.',
        'Высоту и доступ.',
        'Фото.',
        'Проект/чертёж, если отверстия относятся к вентиляции или другим инженерным системам.',
        'Стадию отделки и ограничения действующего объекта.'
      ]}
    ],
    historicalTitle:'Исторический контекст AEROVENTA.',
    historicalText:'Раньше AEROVENTA выполняла алмазное бурение собственной техникой, поэтому исходная статья опиралась на внутреннюю себестоимость: оснастку, сервис, крепёж, транспорт и труд. Сегодня прямое бурение не является основным направлением команды, но сама логика факторов цены остаётся полезной.',
    related:[
      ['Застряла коронка','/blog/detail/kak-vytashchit-zastryavshuyu-koronku-iz-betona/','Практический материал о причинах заклинивания.'],
      ['Отверстие под вентиляцию','/blog/detail/gorizontalnoe-almaznoe-burenie/','Какие исходные данные нужны именно для проходки под воздуховод.'],
      ['Алмазное бурение','/almaznoe-burenie/','Текущая модель исполнения заявок.']
    ],
    ctaTitle:'Нужна проходка как часть вентиляционного монтажа?',
    ctaText:'Тогда важнее сначала определить трассу и узел вентиляции. Для сметы по вентиляции пришлите проект или опишите объект — отверстия будут учтены в контексте общей задачи.'
  },

  '/blog/detail/gorizontalnoe-almaznoe-burenie/': {
    kicker:'Практика / проходка под вентиляцию',
    signal:'Исторический объект в старом фонде Санкт-Петербурга',
    lede:'Отверстие под вентиляцию — не самостоятельная цель. Оно должно совпасть с реальной трассой, габаритом узла и конструкцией стены. Ошибка в точке или геометрии прохода потом становится проблемой уже для монтажа воздуховода.',
    sourceNote:'Значения 110 мм и более 70 см ниже относятся только к историческому объекту из старой статьи AEROVENTA.',
    verdictTitle:'Сначала трасса и узел. Потом отверстие.',
    verdict:'До бурения нужно понять, что именно проходит через стену, где должна оказаться ось с обеих сторон, из чего состоит конструкция и что может находиться внутри неё. Покупать “отверстие” раньше вентиляционного решения — риск сделать проходку не там или не той геометрии.',
    sections:[
      { index:'01', title:'Что определить до проходки', items:[
        'Какой воздуховод / оборудование / соединение проходит через стену.',
        'Фактическую точку и ось с обеих сторон.',
        'Толщину и материал стены.',
        'Скрытые коммуникации и конструктивные ограничения.',
        'Что находится на фасадной или дальней стороне.',
        'Высоту, доступ и состояние отделки.'
      ]},
      { index:'02', title:'Исторический объект: толстая стена старого фонда', items:[
        'Старая кирпичная конструкция в Санкт-Петербурге.',
        'Толщина стены по архивному описанию — более 70 см.',
        'Итоговая проходка на том объекте — 110 мм.',
        'Из-за глубины применяли удлинитель рабочей оснастки.',
        'Использовалось бурение с подачей воды.'
      ], note:'Это факты одного исторического кейса, а не типовые параметры для любой стены старого фонда.'},
      { index:'03', title:'Почему крепление и геометрия важны', items:[
        'Стойка должна оставаться стабильной относительно оси.',
        'Ось проходки должна совпадать с реальным монтажным узлом.',
        'Проходную сторону нужно контролировать и защищать.',
        'В старых конструкциях заранее учитывают возможную неоднородность материала.'
      ]},
      { index:'04', title:'Что прислать до оценки', items:[
        'Фото стены изнутри.',
        'Фото или описание противоположной стороны.',
        'Толщину и материал, если известны.',
        'Диаметр/габарит вентиляционного соединения.',
        'Проект или план.',
        'Высоту и доступ.',
        'Ограничения по отделке и режиму объекта.'
      ]},
      { index:'05', title:'Когда проходку надо считать вместе с вентиляцией', copy:'Если задача — не просто сделать отверстие, а установить приточную/вытяжную систему, точку и геометрию проходки лучше определять из вентиляционного решения. Тогда смежное бурение подчиняется трассе, а не наоборот.'}
    ],
    historicalTitle:'Что не переносим из старого материала.',
    historicalText:'Не возвращаем старый прямой рекламный призыв, универсальные диаметры анкеров, режимы машины или обещание собственного бурового исполнения. Сохраняем реальный кейс, геометрическую логику и связь проходки с вентиляционным монтажом.',
    related:[
      ['Монтаж вентиляции','/montazh-ventiliacii/','Основная услуга AEROVENTA.'],
      ['От чего зависит цена бурения','/blog/detail/stoimost-almaznogo-bureniya-kak-rasschitat-tsenu/','Какие данные влияют на отдельную проходку.'],
      ['Алмазное бурение','/almaznoe-burenie/','Текущая партнёрская модель исполнения.']
    ],
    ctaTitle:'Нужно отверстие под конкретную вентиляционную трассу?',
    ctaText:'Есть проект — пришлите лист или узел. Проекта нет — покажите помещение, стену и задачу. Сначала определим исходные данные и место проходки в общей схеме.'
  }
};

const spec = specs[content.path];
if (!spec) throw new Error(`P0 article spec is missing for ${content.path}`);
---

<article class="p0-article">
  <header class="p0-hero">
    <div class="home-shell p0-hero__grid">
      <div>
        <p class="home-kicker">{spec.kicker}</p>
        <h1>{content.h1}</h1>
      </div>
      <div>
        <p class="p0-hero__signal">{spec.signal}</p>
        <p class="p0-hero__lede">{spec.lede}</p>
        <div class="p0-source-note"><strong>Источник и граница:</strong> {spec.sourceNote}</div>
      </div>
    </div>
  </header>

  <section class="p0-verdict" aria-labelledby="p0-verdict-title">
    <div class="home-shell p0-verdict__grid">
      <p class="section-index section-index--orange">Инженерный вывод</p>
      <div>
        <h2 id="p0-verdict-title">{spec.verdictTitle}</h2>
        <p>{spec.verdict}</p>
      </div>
    </div>
  </section>

  <div class="p0-sections">
    {spec.sections.map((section) => (
      <section class="p0-section">
        <div class="home-shell p0-section__grid">
          <div>
            <p class="section-index">{section.index}</p>
            <h2>{section.title}</h2>
          </div>
          <div class="p0-section__body">
            {section.copy && <p class="p0-section__copy">{section.copy}</p>}
            {section.items && (
              <ol class="p0-list">
                {section.items.map((item,index) => <li><span>{String(index+1).padStart(2,'0')}</span><p>{item}</p></li>)}
              </ol>
            )}
            {section.note && <aside class="p0-note"><strong>Важно:</strong> {section.note}</aside>}
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="p0-history" aria-labelledby="p0-history-title">
    <div class="home-shell p0-history__grid">
      <div>
        <p class="section-index section-index--orange">Исторический контекст</p>
        <h2 id="p0-history-title">{spec.historicalTitle}</h2>
      </div>
      <p>{spec.historicalText}</p>
    </div>
  </section>

  <section class="home-section p0-related" aria-labelledby="p0-related-title">
    <div class="home-shell">
      <p class="section-index">Связанные материалы</p>
      <h2 id="p0-related-title">Продолжить по задаче, а не по архивной рубрике.</h2>
      <div class="p0-related__grid">
        {spec.related.map(([title,href,text],index) => (
          <a href={href}><span>{String(index+1).padStart(2,'0')}</span><h3>{title}</h3><p>{text}</p><b>Открыть →</b></a>
        ))}
      </div>
    </div>
  </section>

  <section class="conversion-close" aria-labelledby="p0-close-title">
    <div class="home-shell">
      <p class="section-index section-index--orange">Текущая модель AEROVENTA</p>
      <h2 id="p0-close-title">{spec.ctaTitle}</h2>
      <p class="p0-close-copy">{spec.ctaText}</p>
      <div class="home-actions">
        <a class="button button--light" href="/contact/?intent=project">Есть проект →</a>
        <a class="button button--light" href="/contact/?intent=budget">Описать задачу →</a>
        <a class="button button--light" href="/almaznoe-burenie/">Отдельное бурение →</a>
      </div>
    </div>
  </section>
</article>
