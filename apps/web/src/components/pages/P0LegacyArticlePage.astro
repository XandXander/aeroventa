const spec = specs[content.path];
if (!spec) throw new Error(`P0 article spec is missing for ${content.path}`);

// Historical content belongs to the current published page, not an external SEO-only document.
// The source index is an archived text extract; never present it as byte-perfect original HTML.
const legacyPage = legacySources.find(row => row.path === content.path);
const verifiedOriginal = verifiedArchive.articles.find(item => item.route === content.path);
const verifiedArchiveHtml = verifiedOriginal
  ? verifiedOriginal.source_article_html_sanitized.replace(/<img\b[^>]*>/gi, '')
  : '';
const legacyExtract = (legacyPage?.legacy_text_excerpt || '').trim();
if (!legacyExtract) throw new Error(`Missing preserved legacy text for ${content.path}`);
const sentences = legacyExtract.split(/(?<=[.!?])\s+(?=[А-ЯЁA-Z])/u).filter(Boolean);
const legacyParagraphs: string[] = [];
let paragraph = '';
for (const sentence of sentences) {
  if (paragraph.length > 370 && paragraph) { legacyParagraphs.push(paragraph.trim()); paragraph = ''; }
  paragraph += (paragraph ? ' ' : '') + sentence;
}
if (paragraph) legacyParagraphs.push(paragraph.trim());
