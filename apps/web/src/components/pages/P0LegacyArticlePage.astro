        <p class="p0-hero__signal">Инженерная практика · архив AEROVENTA</p>
        <p class="p0-hero__lede">{spec.lede}</p>
        <p class="p0-source-note">{spec.sourceNote}</p>
      </div>
    </div>
  </header>

  <section class="p0-verdict" aria-labelledby="p0-verdict-title">
    <div class="home-shell p0-verdict__grid">
      <p class="section-index section-index--orange">Инженерный вывод</p>
      <div>
        <h2 id="p0-verdict-title">{spec.verdictTitle}</h2>
        <p>{spec.verdict}</p>
      </div>
    </div>
  </section>

  {content.path === '/blog/detail/kak-vytashchit-zastryavshuyu-koronku-iz-betona/' && (
    <section class="p0-authentic-photo home-section" aria-labelledby="p0-authentic-photo-title">
      <div class="home-shell p0-authentic-photo__layout">
        <figure>
          <img src="/upload/medialibrary/548/5488fb415056eee52ac63ff9d4850c63.jpg"
            width="800" height="600" loading="lazy" decoding="async"
            alt="Керн из бетона после алмазного бурения: подлинное изображение из исторической статьи AEROVENTA" />
          <figcaption>Оригинальный архивный снимок из этой статьи, сохранённый по исходному URL. Не отдельное подтверждение способа извлечения заклинившей коронки.</figcaption>
        </figure>
        <div>
          <p class="section-index section-index--orange">Фото из первоисточника</p>
          <h2 id="p0-authentic-photo-title">Что действительно находилось внутри бетонного основания.</h2>
          <p>Отколовшийся керн и попавшие в рез включения могут менять сопротивление коронки. На фото — реальный керн из исходной публикации; порядок работы при заклинивании определяется безопасной процедурой для конкретной установки.</p>
          <p>Историческая схема обратного молота остаётся отдельным материалом: её нельзя заменять чужим товарным изображением или искусственно созданным чертежом.</p>
        </div>
      </div>
    </section>
  )}

  <div class="p0-sections">
    {spec.sections.map((section) => (
      <section class="p0-section">
        <div class="home-shell p0-section__grid">
          <div>
            <p class="section-index">{section.index}</p>
            <h2>{section.title}</h2>
          </div>
          <div class="p0-section__body">
            {section.copy && <p class="p0-section__copy">{section.copy}</p>}
            {section.items && (
              <ol class="p0-list">
                {section.items.map((item,index) => <li><span>{String(index+1).padStart(2,'0')}</span><p>{item}</p></li>)}
              </ol>
            )}
            {section.note && <aside class="p0-note"><strong>Важно:</strong> {section.note}</aside>}
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="p0-historic-reading home-section" aria-labelledby="p0-archive-title">
    <div class="home-shell p0-historic-reading__layout">
      <div class="p0-historic-reading__aside">
        <p class="section-index section-index--orange">Из архива AEROVENTA</p>
