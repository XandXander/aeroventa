      <div class="case-story__grid">
        <div><span>Задача</span><h3>Что требовалось</h3><p>{spec.task}</p></div>
        <div><span>Монтаж</span><h3>Что смонтировано</h3><p>{spec.works}</p></div>
        <div><span>Результат</span><h3>Выполненные работы и сроки</h3><p>{spec.result}</p></div>
