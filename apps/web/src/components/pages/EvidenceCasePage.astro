---
import type { ContentRecord } from '@/lib/types';
interface Props { content: ContentRecord; fixture: boolean; }
const { content } = Astro.props;

type CaseSpec = {
  eyebrow: string;
  location: string;
  lede: string;
  facts: Array<[string,string]>;
  evidence: string[];
  media: Array<[string,string,string]>;
  proves: string[];
  limits: string[];
  related: Array<[string,string,string]>;
};

const specs: Record<string, CaseSpec> = {
  '/blog/detail/kak-my-sdali-7-domov/': {
    eyebrow:'Новостройки / жилой квартал',
