          {hasLetter && (
            <button type="button" class="ponsse-letter-preview" data-ponsse-open aria-haspopup="dialog" aria-controls="ponsse-letter-dialog" aria-label="Увеличить подлинное благодарственное письмо PONSSE">
              <img src={letterSrc} alt="Письмо PONSSE с датой 5 апреля 2022 года и подписью" width="1481" height="2048" loading="lazy" decoding="async" />
              <span>Посмотреть оригинал письма ↗</span>
            </button>
