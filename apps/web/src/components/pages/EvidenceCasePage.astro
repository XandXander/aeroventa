</article>

<script>
  const photos = [...document.querySelectorAll<HTMLButtonElement>('[data-case-photo]')];
  const viewer = document.getElementById('case-photo-viewer');
  if (viewer instanceof HTMLDialogElement && photos.length) {
    let activeIndex = 0;
    let activeTrigger: HTMLButtonElement | null = null;
    let savedPageScroll = 0;
    const restoreReaderPosition = () => {
      window.scrollTo({top:savedPageScroll,behavior:'instant'});
      activeTrigger?.focus({preventScroll:true});
    };
    const closeViewer = () => {
      if(viewer.open)viewer.close();
      restoreReaderPosition();
    };
    const large = viewer.querySelector<HTMLImageElement>('[data-photo-large]');
    const description = viewer.querySelector<HTMLElement>('[data-photo-description]');
    const counter = viewer.querySelector<HTMLElement>('[data-photo-count]');
    const frame = viewer.querySelector<HTMLElement>('.case-photo-dialog__figure');
    let zoom = 1;
    const fit = () => {
      zoom = 1;
      viewer.style.setProperty('--photo-zoom', '1');
      viewer.classList.remove('is-photo-zoomed');
      viewer.querySelector<HTMLButtonElement>('[data-photo-fit]')?.setAttribute('aria-pressed','true');
      frame?.scrollTo({left:0,top:0});
    };
    const changeZoom = (step: number) => {
      zoom = Math.min(3, Math.max(1, Math.round((zoom + step) * 10) / 10));
      viewer.style.setProperty('--photo-zoom', String(zoom));
      viewer.classList.toggle('is-photo-zoomed',zoom>1);
      viewer.querySelector<HTMLButtonElement>('[data-photo-fit]')?.setAttribute('aria-pressed',zoom===1?'true':'false');
    };
    viewer.querySelector('[data-photo-fit]')?.addEventListener('click',fit);
    viewer.querySelector('[data-photo-zoom-in]')?.addEventListener('click',()=>changeZoom(.5));
    viewer.querySelector('[data-photo-zoom-out]')?.addEventListener('click',()=>changeZoom(-.5));
    const show = (index: number) => {
      fit();
      activeIndex = (index + photos.length) % photos.length;
      const photo = photos[activeIndex];
      if (large) { large.src = photo.dataset.photoSrc || ''; large.alt = photo.dataset.photoAlt || ''; }
      if (description) description.textContent = photo.dataset.photoArchival === 'true' ? 'Исходная фотография монтажных работ' : (photo.dataset.photoCaption || photo.dataset.photoAlt || '');
      if (counter) counter.textContent = `${activeIndex + 1} / ${photos.length}`;
    };
    photos.forEach((button, index) => button.addEventListener('click', () => {
      activeTrigger = button;
      const previousScroll = window.scrollY;
      savedPageScroll = previousScroll;
      show(index);
      if (!viewer.open) viewer.showModal();
      viewer.querySelector<HTMLButtonElement>('[data-photo-close]')?.focus({preventScroll:true});
      if(Math.abs(window.scrollY-previousScroll)>1)window.scrollTo({top:previousScroll,behavior:'instant'});
    }));
    viewer.querySelector('[data-photo-close]')?.addEventListener('click', closeViewer);
    viewer.addEventListener('cancel',event=>{event.preventDefault();closeViewer()});
    viewer.querySelector('[data-photo-previous]')?.addEventListener('click', () => show(activeIndex - 1));
    viewer.querySelector('[data-photo-next]')?.addEventListener('click', () => show(activeIndex + 1));
    viewer.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); show(activeIndex - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); show(activeIndex + 1); }
    });
    viewer.addEventListener('click', event => { if (event.target === viewer) closeViewer(); });
    let startX: number | null = null;
    viewer.addEventListener('touchstart', event => { startX = event.changedTouches[0]?.clientX ?? null; }, { passive: true });
    viewer.addEventListener('touchend', event => {
      const endX = event.changedTouches[0]?.clientX;
      if (startX !== null && endX !== undefined && Math.abs(endX - startX) > 55) show(activeIndex + (endX < startX ? 1 : -1));
      startX = null;
    }, { passive: true });
    viewer.addEventListener('close', () => {
      fit();
      if (large) large.removeAttribute('src');
      restoreReaderPosition();
      requestAnimationFrame(restoreReaderPosition);
    });
  }
</script>

<style>
/* A quiet, full-viewport documentary viewer, controlled by side arrows and Escape. */
.case-photo-dialog{width:min(100vw,1600px);max-width:100vw;max-height:100dvh;height:100dvh;padding:0;border:0;background:rgba(8,17,24,.96);color:#fff;overflow:hidden}
.case-photo-dialog::backdrop{background:rgba(4,11,16,.92)}
.case-photo-dialog__panel{position:relative;width:100%;height:100%;display:grid;grid-template-rows:1fr}
.case-photo-dialog__top{position:absolute;inset:14px 16px auto;z-index:3;display:flex;align-items:center;justify-content:space-between;pointer-events:none}
.case-photo-dialog__top>span{font-size:.75rem;color:#e2e7eb;text-shadow:0 1px 3px #000}
.case-photo-dialog__close{pointer-events:auto;display:grid;place-items:center;width:42px;height:42px;border:0;border-radius:50%;background:rgba(18,34,45,.70);color:#fff;font:400 30px/1 inherit;cursor:pointer}
.case-photo-dialog__figure{margin:0;min-width:0;min-height:0;padding:58px clamp(20px,6vw,96px) 44px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12px}
.case-photo-dialog__figure img{display:block;width:auto;height:auto;max-width:100%;max-height:calc(100dvh - 140px);object-fit:contain}
.case-photo-dialog__figure figcaption{text-align:center;color:#c4d1d9;font-size:.8rem;line-height:1.35}
.case-photo-dialog__nav{position:absolute;inset:50% 12px auto;transform:translateY(-50%);display:flex;justify-content:space-between;pointer-events:none}
.case-photo-dialog__nav button{pointer-events:auto;display:grid;place-items:center;width:clamp(38px,4vw,54px);height:clamp(38px,4vw,54px);padding:0;border:0;border-radius:50%;background:rgba(28,47,61,.68);color:#fff;font-size:2.35rem;line-height:1;cursor:pointer}
