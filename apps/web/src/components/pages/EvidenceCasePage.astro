const spec=specs[content.path];
if(!spec) throw new Error('Case spec missing: '+content.path);
---

<article class="evidence-case">
  <header class="case-detail-hero">
    <div class="home-shell case-detail-hero__grid">
      <div>
        <p class="home-kicker">{spec.eyebrow}</p>
        <h1>{content.h1}</h1>
      </div>
      <div>
        <p class="case-detail-hero__location">{spec.location}</p>
        <p class="case-detail-hero__lede">{spec.lede}</p>
        <div class="home-actions">
          <a class="button button--primary" href="/contact/?intent=project">Показать похожий проект →</a>
          <a class="button button--ghost" href="/portfolio/">Все объекты</a>
        </div>
      </div>
    </div>
  </header>

  <section class="case-detail-facts" aria-labelledby="case-facts-title">
    <div class="home-shell">
      <p class="section-index">01 / Факты объекта</p>
      <h2 id="case-facts-title">Объект и выполненные работы.</h2>
      <dl class="case-detail-facts__grid">
        {spec.facts.map(([label,value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
      </dl>
    </div>
  </section>

  {content.path === '/blog/detail/montazh-ventilyatsii-v-karelii/' && (
    <section class="ponsse-recognition" aria-labelledby="ponsse-recognition-title">
      <div class="home-shell ponsse-recognition__grid">
        <div>
          <p class="section-index section-index--orange">02 / Отзыв о сотрудничестве</p>
          <h2 id="ponsse-recognition-title">Благодарность за работу и соблюдение сроков.</h2>
          <p>5 апреля 2022 года в адрес Евгения, Александра и команды AEROVENTA.RU поступило благодарственное письмо от представителя сервисного центра PONSSE в Питкяранте.</p>
          <p>В письме отмечены профессионализм, деловой подход и соблюдение сроков при совместной работе. Это отзыв о сотрудничестве, а не подтверждение неуказанных характеристик вентиляционной системы.</p>
        </div>
        <aside class="ponsse-recognition__citation">
          <span>LETTER OF APPRECIATION</span>
          <strong>05.04.2022</strong>
          <p>Благодарность команде AEROVENTA за работу, ответственность и выполнение задач в срок.</p>
          <p class="ponsse-recognition__signer">Petteri Teittinen<br/>Service support and development manager<br/>PONSSE service centre · Питкяранта</p>
        </aside>
      </div>
    </section>
  )}
  <section class="home-section case-story" aria-label="Задача, выполненные работы и результат">
    <div class="home-shell case-story__grid">
      <div><span>01 / Задача</span><h2>Что требовалось на объекте</h2><p>{spec.task}</p></div>
      <div><span>02 / Выполненные работы</span><h2>Что смонтировано</h2><p>{spec.works}</p></div>
      <div><span>03 / Результат</span><h2>Результат в документах</h2><p>{spec.result}</p></div>
    </div>
  </section>
  <section class="home-section case-gallery" aria-labelledby="case-gallery-title">
    <div class="home-shell">
      <p class="section-index section-index--orange">Реальные фотографии</p>
      <h2 id="case-gallery-title">Объект и выполненные работы</h2>
      <div class="case-gallery__grid">
        {spec.media.map(([src,alt,caption]) => (
          <figure class="case-gallery__item">
            <img src={src} alt={alt} width="800" height="520" loading="lazy" decoding="async" />
            <figcaption>{caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
  <section class="home-section case-detail-related" aria-labelledby="case-related-title">
    <div class="home-shell">
      <p class="section-index">04 / Продолжить</p>
      <h2 id="case-related-title">Перейти от доказательства к своей задаче.</h2>
      <div class="case-detail-related__grid">
        {spec.related.map(([title,href,text],index) => <a href={href}><span>{String(index+1).padStart(2,'0')}</span><h3>{title}</h3><p>{text}</p><b>Открыть →</b></a>)}
      </div>
    </div>
  </section>

  <section class="conversion-close">
    <div class="home-shell">
      <p class="section-index section-index--orange">05 / Ваш объект</p>
      <h2>Есть похожая задача — начните с исходных данных.</h2>
      <div class="home-actions">
        <a class="button button--light" href="/montazh-po-proektu/">Монтаж по готовому проекту →</a>
        <a class="button button--light" href="/obekt-bez-gotovogo-proekta/">Подготовка исходных данных</a>
      </div>
    </div>
  </section>
</article>
