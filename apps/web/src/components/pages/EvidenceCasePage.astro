const spec=specs[content.path];
if(!spec) throw new Error('Case spec missing: '+content.path);
---

<article class="evidence-case">
  <header class="case-detail-hero">
    <div class="home-shell case-detail-hero__grid">
      <div>
        <p class="home-kicker">{spec.eyebrow}</p>
        <h1>{content.h1}</h1>
      </div>
      <div>
        <p class="case-detail-hero__location">{spec.location}</p>
        <p class="case-detail-hero__lede">{spec.lede}</p>
        <div class="home-actions">
          <a class="button button--primary" href="/contact/?intent=project">Показать похожий проект →</a>
          <a class="button button--ghost" href="/portfolio/">Все объекты</a>
        </div>
      </div>
    </div>
  </header>

  <section class="case-detail-facts" aria-labelledby="case-facts-title">
    <div class="home-shell">
      <p class="section-index">01 / Факты объекта</p>
      <h2 id="case-facts-title">Что подтверждено исходной публикацией.</h2>
      <dl class="case-detail-facts__grid">
        {spec.facts.map(([label,value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="case-detail-evidence" aria-labelledby="case-evidence-title">
    <div class="home-shell case-detail-evidence__grid">
      <div>
        <p class="section-index section-index--orange">02 / Доказательства</p>
        <h2 id="case-evidence-title">Не достраиваем историю догадками.</h2>
      </div>
      <ol>
        {spec.evidence.map((item,index) => <li><span>{String(index+1).padStart(2,'0')}</span><p>{item}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="home-section case-detail-meaning" aria-labelledby="case-meaning-title">
    <div class="home-shell case-detail-meaning__grid">
      <div>
        <p class="section-index">03 / Что показывает кейс</p>
        <h2 id="case-meaning-title">Вывод только в пределах доказательств.</h2>
      </div>
      <div class="case-detail-meaning__list">
        {spec.proves.map((item,index) => <div><span>{String(index+1).padStart(2,'0')}</span><p>{item}</p></div>)}
      </div>
    </div>
  </section>

  <section class="case-detail-limits" aria-labelledby="case-limits-title">
    <div class="home-shell case-detail-limits__grid">
      <div>
        <p class="section-index section-index--orange">04 / Граница доказательств</p>
        <h2 id="case-limits-title">Чего на этой странице намеренно нет.</h2>
      </div>
      <div class="case-detail-limits__list">
        {spec.limits.map((item) => <div>{item}</div>)}
      </div>
    </div>
  </section>

  <section class="home-section case-detail-related" aria-labelledby="case-related-title">
    <div class="home-shell">
      <p class="section-index">05 / Продолжить</p>
      <h2 id="case-related-title">Перейти от доказательства к своей задаче.</h2>
      <div class="case-detail-related__grid">
        {spec.related.map(([title,href,text],index) => <a href={href}><span>{String(index+1).padStart(2,'0')}</span><h3>{title}</h3><p>{text}</p><b>Открыть →</b></a>)}
      </div>
    </div>
  </section>

  <section class="conversion-close">
    <div class="home-shell">
      <p class="section-index section-index--orange">06 / Ваш объект</p>
      <h2>Есть похожая задача — начните с исходных данных.</h2>
      <div class="home-actions">
        <a class="button button--light" href="/contact/?intent=project">Есть проект — запросить смету →</a>
        <a class="button button--light" href="/contact/?intent=budget">Проекта нет — описать объект</a>
      </div>
    </div>
  </section>
</article>
