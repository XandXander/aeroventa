          <div class="ponsse-recognition__person">
            {hasPortrait && (
              <figure class="ponsse-recognition__portrait">
                <img src={portraitSrc} alt="Портрет подписанта письма, предоставленный владельцем сайта" width="533" height="800" loading="lazy" decoding="async" />
              </figure>
            )}
            <p class="ponsse-recognition__signer">Petteri Teittinen<br/>Service support and development manager<br/>PONSSE service centre · Питкяранта</p>
          </div>
        </aside>
      </div>
