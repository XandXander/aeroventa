---

<article class="evidence-case">
  <header class="case-detail-hero">
    <div class="home-shell case-detail-hero__grid">
      <div>
        <p class="home-kicker">{spec.eyebrow}</p>
        <h1>{content.h1}</h1>
      </div>
      <div>
        <p class="case-detail-hero__location">{spec.location}</p>
        <p class="case-detail-hero__lede">{spec.lede}</p>
        <div class="home-actions">
          <button class="button button--primary" type="button" data-contact-open data-source="evidence_case" data-project-status="unknown">Обсудить похожую задачу →</button>
          <a class="button button--ghost" href="/portfolio/">Все объекты</a>
        </div>
      </div>
    </div>
  </header>

  <section class="home-section case-gallery case-gallery--lead" aria-labelledby="case-gallery-title">
    <div class="home-shell">
      <p class="section-index section-index--orange">Реальные фотографии</p>
      <h2 id="case-gallery-title">{documentary.gallery}</h2>
      <p class="case-gallery__intro">Фотографии объекта и выполненных работ.</p>
      <div class="case-gallery__grid case-gallery__grid--featured">
        {spec.media.map(([src, alt, caption]) => (
          <figure class="case-gallery__item">
            <button type="button" class="case-gallery__open" data-case-photo data-photo-src={src} data-photo-alt={alt} data-photo-caption={caption} aria-label={`Увеличить фотографию: ${caption}`}>
              <img src={src} alt={alt} width="800" height="520" loading="lazy" decoding="async" />
            </button>
            <figcaption>{caption}</figcaption>
          </figure>
        ))}
      </div>
      {Boolean(spec.archiveMedia?.length) && (
        <section class="case-gallery__archive" aria-labelledby="case-photo-archive-title">
          <h3 id="case-photo-archive-title">Все фотографии монтажных работ</h3>
          <div class="case-gallery__thumbs">
            {(spec.archiveMedia || []).map(([src, alt, caption]) => (
              <figure class="case-gallery__item case-gallery__item--thumb">
                <button type="button" class="case-gallery__open" data-case-photo data-photo-src={src} data-photo-alt={alt} data-photo-archival="true" data-photo-caption="Исходная фотография работ" aria-label={`Увеличить архивную фотографию: ${alt}`}>
                  <img src={src} alt={alt} width="460" height="300" loading="lazy" decoding="async" />
                </button>
              </figure>
            ))}
          </div>
          <p class="case-gallery__archive-note">Исходная фотодокументация монтажных работ. Нажмите на снимок, чтобы открыть его целиком; порядок фотографий сохранён.</p>
        </section>
      )}
      {fullOriginalGallery.length>0 && (
