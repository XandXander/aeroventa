<script>
  const photos = [...document.querySelectorAll<HTMLButtonElement>('[data-case-photo]')];
  const viewer = document.getElementById('case-photo-viewer');
  if (viewer instanceof HTMLDialogElement && photos.length) {
    let activeIndex = 0;
    let activeTrigger: HTMLButtonElement | null = null;
    const large = viewer.querySelector<HTMLImageElement>('[data-photo-large]');
    const description = viewer.querySelector<HTMLElement>('[data-photo-description]');
    const counter = viewer.querySelector<HTMLElement>('[data-photo-count]');
    const frame = viewer.querySelector<HTMLElement>('.case-photo-dialog__figure');
    let zoom = 1;
    const fit = () => {
      zoom = 1;
      viewer.style.setProperty('--photo-zoom', '1');
      viewer.classList.remove('is-photo-zoomed');
      viewer.querySelector<HTMLButtonElement>('[data-photo-fit]')?.setAttribute('aria-pressed','true');
      frame?.scrollTo({left:0,top:0});
    };
    const changeZoom = (step: number) => {
      zoom = Math.min(3, Math.max(1, Math.round((zoom + step) * 10) / 10));
      viewer.style.setProperty('--photo-zoom', String(zoom));
      viewer.classList.toggle('is-photo-zoomed',zoom>1);
      viewer.querySelector<HTMLButtonElement>('[data-photo-fit]')?.setAttribute('aria-pressed',zoom===1?'true':'false');
    };
    viewer.querySelector('[data-photo-fit]')?.addEventListener('click',fit);
    viewer.querySelector('[data-photo-zoom-in]')?.addEventListener('click',()=>changeZoom(.5));
    viewer.querySelector('[data-photo-zoom-out]')?.addEventListener('click',()=>changeZoom(-.5));
    const show = (index: number) => {
      fit();
      activeIndex = (index + photos.length) % photos.length;
      const photo = photos[activeIndex];
      if (large) { large.src = photo.dataset.photoSrc || ''; large.alt = photo.dataset.photoAlt || ''; }
      if (description) description.textContent = photo.dataset.photoArchival === 'true' ? 'Исходная фотография монтажных работ' : (photo.dataset.photoCaption || photo.dataset.photoAlt || '');
      if (counter) counter.textContent = `${activeIndex + 1} / ${photos.length}`;
    };
    photos.forEach((button, index) => button.addEventListener('click', () => {
      activeTrigger = button;
      show(index);
      if (!viewer.open) viewer.showModal();
    }));
    viewer.querySelector('[data-photo-close]')?.addEventListener('click', () => viewer.close());
    viewer.querySelector('[data-photo-previous]')?.addEventListener('click', () => show(activeIndex - 1));
    viewer.querySelector('[data-photo-next]')?.addEventListener('click', () => show(activeIndex + 1));
    viewer.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); show(activeIndex - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); show(activeIndex + 1); }
    });
    viewer.addEventListener('click', event => { if (event.target === viewer) viewer.close(); });
    let startX: number | null = null;
    viewer.addEventListener('touchstart', event => { startX = event.changedTouches[0]?.clientX ?? null; }, { passive: true });
    viewer.addEventListener('touchend', event => {
      const endX = event.changedTouches[0]?.clientX;
      if (startX !== null && endX !== undefined && Math.abs(endX - startX) > 55) show(activeIndex + (endX < startX ? 1 : -1));
      startX = null;
    }, { passive: true });
    viewer.addEventListener('close', () => {
      fit();
      if (large) large.removeAttribute('src');
      activeTrigger?.focus({ preventScroll: true });
    });
  }
</script>

