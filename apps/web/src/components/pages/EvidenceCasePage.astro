  )}
  {content.path === '/blog/detail/montazh-ventilyatsii-v-karelii/' && hasLetter && (
    <dialog class="ponsse-letter-dialog" id="ponsse-letter-dialog" data-document-viewer aria-label="Благодарственное письмо PONSSE от 5 апреля 2022 года">
  <div class="ponsse-letter-dialog__actions" role="toolbar" aria-label="Управление документом">
  <strong>Благодарность PONSSE · 05.04.2022</strong>
  <button type="button" class="ponsse-letter-dialog__close" data-document-close aria-label="Закрыть письмо">×</button>
</div>
  <div class="ponsse-letter-dialog__sheet" data-document-stage tabindex="0" aria-label="Документ: прокрутка увеличенного изображения">
    <img src="/evidence/karelia/ponsse-letter-20220405.png" width="1481" height="2048" alt="Оригинальное письмо PONSSE от 5 апреля 2022 года" decoding="async" />
  </div>
</dialog>
  )}
  {(verifiedOriginal || oldCaseExcerpt) && (
    <section class="case-original-record" aria-label="Подробное описание работ">
      <div class="home-shell">
        <details class="case-original-record__details">
          <summary>Подробности работ</summary>
          <div class="case-original-record__body">
            <p class="case-original-record__note">{verifiedOriginal ? 'Даты и объёмы относятся к указанному объекту.' : 'Сведения о работах относятся к периоду выполнения этого объекта.'}</p>
            {verifiedOriginal ? <div set:html={verifiedArchiveHtml} /> : <p>{oldCaseExcerpt}</p>}
          </div>
