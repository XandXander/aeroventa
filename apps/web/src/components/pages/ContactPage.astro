---
import { SITE } from '@/lib/site';
import ContactForm from '@/components/ContactForm.astro';
import type { ContentRecord } from '@/lib/types';
interface Props { content: ContentRecord; fixture: boolean; }
const { content } = Astro.props;
const tel = SITE.phone.replace(/[^+\d]/g, '');
---
<article class="contact-premium av-page av-contact">

  <div class="av-shell av-contact__grid">
    <div class="av-contact__direct">
  <header class="av-contact__header"><p class="av-kicker">Контакты</p><h1>Обсудим ваш объект</h1><p class="av-lead">Монтаж вентиляции в Санкт-Петербурге и Ленинградской области. Также берём объекты в Москве и Карелии.</p></header>
<p class="av-kicker">Напрямую команде</p><a href={`tel:${tel}`}><span>Позвонить</span><strong>{SITE.phone}</strong></a><a href={`mailto:${SITE.email}`}><span>Написать</span><strong>{SITE.email}</strong></a><div class="av-contact__materials"><h2>Материалы для первого разговора</h2><p>Проект, план, фотографии или описание задачи. Для первого обращения достаточно имеющихся материалов.</p><button type="button" class="av-text-button" data-project-open data-source="contact_project">Передать проект с файлами →</button><a class="av-contact__write" href="#contact-form">Написать сообщение →</a></div></div>
    <div class="av-contact__form" id="contact-form"><ContactForm idPrefix="contact-page" sourcePath={content.path} compact/></div>
  </div>
</article>
