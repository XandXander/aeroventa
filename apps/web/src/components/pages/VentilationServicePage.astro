---
import type { ContentRecord } from '@/lib/types';
interface Props { content: ContentRecord; fixture: boolean; }
const cases = [
  ['PONSSE · Питкяранта','Сервисно-образовательный центр','/blog/detail/montazh-ventilyatsii-v-karelii/','/evidence/karelia/archive/img-8306.webp'],
  ['НТФФ «Полисан»','Фармацевтический объект','/blog/detail/ntff-polisan/','/evidence/polisan/archive/20180601-133720.webp'],
  ['Леонтьевский Мыс','Ресторан · Санкт-Петербург','/blog/detail/restoran-v-zhk-leontevskiy-mys/','/evidence/leont/duct-installation-01.jpg'],
  ['Маршала Жукова','Квартира · Санкт-Петербург','/blog/detail/kvartira-na-zhukova/','/evidence/zhukov/duct-installation-01.jpg'],
];
---
<article class="service-premium av-page av-montage">
  <header class="av-hero av-hero--montage"><div class="av-shell av-hero__grid">
    <div class="av-hero__title"><p class="av-kicker">Основное направление AEROVENTA</p><h1>Монтаж вентиляции</h1><p class="av-hero__location">Санкт-Петербург и Ленинградская область</p></div>
    <figure class="av-hero__image"><img src="/evidence/hero/hiend-engineering-visual-owner-v43.webp" width="1100" height="640" alt="Художественная архитектурная визуализация интерьера с золотистыми инженерными трассами вентиляции" fetchpriority="high" decoding="async" /></figure>
    <div class="av-hero__body"><p class="av-lead">Воздуховоды и оборудование — в составе согласованной системы.</p><p>Оцениваем объём по документации и условиям площадки. До выхода монтажников уточняем доступ, последовательность работ и вопросы по проекту.</p><p class="av-geo">Также берём объекты в Москве и Карелии</p><a class="button button--primary" href="/montazh-po-proektu/" data-project-open data-source="montage_service" aria-haspopup="dialog" aria-controls="aeroventa-project-dialog">Передать проект →</a></div>
  </div></header>
  <section class="av-section av-montage-proof" aria-labelledby="service-cases-title"><div class="av-shell"><div class="av-heading"><div><p class="av-kicker">На выполненных объектах</p><h2 id="service-cases-title">Монтаж в разных условиях</h2></div><a class="av-link" href="/portfolio/">Все работы →</a></div><div class="av-work-grid">{cases.map(([title,meta,href,image],i)=><a class:list={['av-work',i<2&&'av-work--feature']} href={href}><img src={image} alt={`Вентиляция на объекте ${title}`} width="800" height="600" loading="lazy" decoding="async"/><div><span>{meta}</span><h3>{title}</h3><b>Смотреть работы ↗</b></div></a>)}</div></div></section>
  <section class="av-section av-montage-scope" aria-labelledby="scope-title"><div class="av-shell av-split"><div><p class="av-kicker">Состав работ</p><h2 id="scope-title">Что монтируем</h2><p class="av-lead">Конкретный перечень определяем по проекту и фиксируем в составе работ.</p></div><div><dl class="av-register av-register--large"><div><dt>Воздуховоды</dt><dd>Трассы, фасонные элементы и крепления с учётом геометрии и условий доступа.</dd></div><div><dt>Оборудование</dt><dd>Вентиляционные установки и элементы системы, предусмотренные согласованным объёмом.</dd></div><div><dt>Смежные работы</dt><dd>Проектирование, пусконаладка, автоматика и проходки обсуждаются отдельно. Алмазное бурение — с профильным исполнителем.</dd></div></dl></div></div></section>
  <section class="av-section av-price" aria-labelledby="drivers-title"><div class="av-shell"><div class="av-heading"><div><p class="av-kicker">Расчёт монтажа</p><h2 id="drivers-title">Из чего складывается стоимость</h2></div><p>Для расчёта нужны объёмы системы и условия её монтажа. Одинаковая площадь помещений может требовать разного состава работ.</p></div><div class="av-price__grid"><div><span>01</span><h3>Система</h3><p>Протяжённость и геометрия трасс, состав оборудования, монтажные узлы.</p></div><div><span>02</span><h3>Площадка</h3><p>Высота, доступ, состояние отделки, логистика и перемещение материалов.</p></div><div><span>03</span><h3>Организация</h3><p>Работа в действующем здании, доступное время и координация со смежными подрядчиками.</p></div></div><a class="av-link" href="/faq/">Как сопоставить состав двух смет →</a></div></section>
  <section class="av-section av-preparation" aria-labelledby="service-router-title"><div class="av-shell"><div class="av-heading"><div><p class="av-kicker">До начала монтажа</p><h2 id="service-router-title">На какой стадии ваш объект?</h2></div><p>Если документация расходится с условиями площадки, согласовываем решение до выполнения затронутых работ.</p></div><div class="av-choices"><a href="/montazh-po-proektu/"><span>Есть документация</span><h3>Монтаж по проекту</h3><p>Рабочие чертежи, спецификация и условия площадки — для оценки объёма.</p><b>Как передать проект ↗</b></a><a href="/obekt-bez-gotovogo-proekta/"><span>Пока есть задача</span><h3>Объект без проекта</h3><p>Начнём с плана, фотографий или описания. Уточним, какие данные нужны дальше.</p><b>С чего начать ↗</b></a></div></div></section>
</article>
