---
import LeadCTA from '@/components/LeadCTA.astro';
import CmsContentBlocks from '@/components/CmsContentBlocks.astro';
import type { ContentRecord } from '@/lib/types';
interface Props { content: ContentRecord; fixture: boolean; }
const { content, fixture } = Astro.props;
---
<article class="page project-page">
  <header class="project-header">
    <div class="container prose">
      <p class="eyebrow">Реализованный объект</p>
      <h1>{content.h1}</h1>
      {content.excerpt && <p class="lede">{content.excerpt}</p>}
    </div>
  </header>
  <div class="container prose project-body">
    {content.cms_blocks?.some(block => block.type !== 'dom_fields') ? <CmsContentBlocks blocks={content.cms_blocks.filter(block => block.type !== 'dom_fields')} /> : <Fragment set:html={content.body_html} />}
    <LeadCTA intent="VENTILATION_PROJECT" title="Обсудить похожий объект" />
  </div>
</article>
