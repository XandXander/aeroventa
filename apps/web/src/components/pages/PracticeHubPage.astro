---
import type { ContentRecord } from '@/lib/types';
interface Props { content: ContentRecord; fixture: boolean; }
const { content } = Astro.props;

const p0 = [
  { tag:'Полевой опыт', title:'Как вытащить застрявшую алмазную коронку из бетона', text:'Почему коронку заклинивает, что делать сначала и где заканчивается универсальный совет.', href:'/blog/detail/kak-vytashchit-zastryavshuyu-koronku-iz-betona/', image:'/upload/medialibrary/548/5488fb415056eee52ac63ff9d4850c63.jpg', imageAlt:'Керн после алмазного бурения бетона — оригинальная фотография из статьи' },
  { tag:'Реальный объект', title:'Бурение в стяжке под стояки отопления', text:'Слоистое перекрытие, крепление установки, готовая отделка и исходные данные.', href:'/blog/detail/almaznoe-burenie-v-styazhke-pod-stoyaki-otopleniya/', image:'/upload/medialibrary/0a2/0a2f0d1be2900e0a1fe74bcd9604e3f8.jpg', imageAlt:'Бурение отверстий в стяжке под отопление — исходная фотография из статьи' },
  { tag:'Стоимость', title:'От чего зависит стоимость алмазного бурения', text:'Диаметр — только один фактор. Разбираем геометрию, материал, доступ и состав работ.', href:'/blog/detail/stoimost-almaznogo-bureniya-kak-rasschitat-tsenu/', image:'/upload/medialibrary/fb3/fb3d693282a8085971dd4e2fe87bf28e.jpg', imageAlt:'Алмазное бурение отверстий — оригинальная фотография к статье о расчёте стоимости' },
  { tag:'Вентиляция + проходка', title:'Алмазное бурение стены под вентиляцию', text:'Почему сначала определяют трассу и узел, а уже потом точку и геометрию отверстия.', href:'/blog/detail/gorizontalnoe-almaznoe-burenie/', image:'/upload/medialibrary/e1c/e1cd51110183f9c6b2e704b70664eba1.jpg', imageAlt:'Разметка отверстия под вентиляцию — оригинальная фотография из статьи' },
];

const cases = [
  {tag:'Жилой комплекс',title:'ЖК «Аквилон» · Янино',meta:'Ленинградская область · монтаж вентиляции',image:'/evidence/owner-portfolio/akvilon-yanino/cover.webp',imageAlt:'Реальное строящееся здание ЖК «Аквилон» в Янино',href:'/portfolio/obekt/akvilon-yanino/'},
  {tag:'Ресторан',title:'ЖК «Леонтьевский Мыс»',image:'/evidence/leont/owner-cover-v43.webp',imageAlt:'Выполненный объект AEROVENTA — ресторан в ЖК Леонтьевский Мыс',meta:'Санкт-Петербург · приточно-вытяжная вентиляция + оборудование',href:'/blog/detail/restoran-v-zhk-leontevskiy-mys/'},
  {tag:'Производство',title:'НТФФ «Полисан»',meta:'Санкт-Петербург · монтаж на фармацевтическом объекте',image:'/evidence/polisan/owner-cover-v43.webp',imageAlt:'Общий вид фармацевтического предприятия НТФФ «Полисан»',href:'/blog/detail/ntff-polisan/'},
  {tag:'Квартира',title:'Маршала Жукова',image:'/evidence/zhukov/owner-cover-v43.webp',imageAlt:'Архитектурный вид дома на Маршала Жукова',meta:'Санкт-Петербург · приточно-вытяжная вентиляция',href:'/blog/detail/kvartira-na-zhukova/'},
  {tag:'Карелия',title:'Питкяранта / PONSSE',meta:'Сервисно-образовательный центр · вентиляция + оборудование',image:'/evidence/karelia/owner-cover-v43.webp',imageAlt:'Фотография сервисного центра PONSSE в Питкяранте',href:'/blog/detail/montazh-ventilyatsii-v-karelii/'},
  {tag:'Кафе',title:'Римского-Корсакова, 3',image:'/evidence/cafe/owner-cover-v43.webp',imageAlt:'Выполненный объект AEROVENTA — кафе на Римского-Корсакова, 3',meta:'Санкт-Петербург · приточно-вытяжная вентиляция + оборудование',href:'/blog/detail/kafe-rimskogo-korsakova-3/'},
];

const leadingCase = cases.find(item => item.href === '/blog/detail/ntff-polisan/')!;
const isRoot = content.path === '/blog/';
const isPractical = content.path === '/blog/poleznye-stati/';
const isStories = content.path === '/blog/istorii-proektov/';
---

{isRoot ? (
  <article class="practice-hub av-page av-journal">
    <section class="av-journal-opening" aria-label="Статьи и главный материал"><header class="av-journal-intro av-shell"><div><p class="av-kicker">Материалы AEROVENTA</p><h1>Статьи</h1></div><p class="av-lead">Монтаж вентиляции на реальных объектах: задачи, технические решения и фотографии работ.</p></header>
    <section class="av-journal-lead" aria-label="Главный материал"><div class="av-shell"><a href={leadingCase.href} class="av-journal-lead__link"><figure><img src={leadingCase.image} alt={leadingCase.imageAlt} width="800" height="600" loading="eager" decoding="async"/></figure><div><p class="av-kicker">Вентиляция · выполненный объект</p><h2>НТФФ «Полисан»: монтаж вентиляции</h2><p>Вентиляционное оборудование и трассы на фармацевтическом объекте. Состав работ и фотографии площадки.</p><b>Читать историю объекта ↗</b></div></a></div></section>
    </section>
    <section class="av-section av-journal-stories" aria-labelledby="practice-featured-title"><div class="av-shell"><div class="av-heading"><div><p class="av-kicker">Монтаж вентиляции</p><h2 id="practice-featured-title">Истории объектов</h2></div><a class="av-link" href="/blog/istorii-proektov/">Все истории →</a></div><div class="av-story-grid">{cases.filter(item=>item.href!==leadingCase.href).slice(0,4).map(item=><a href={item.href}><img src={item.image} alt={item.imageAlt} width="800" height="520" loading="lazy" decoding="async"/><span>{item.tag}</span><h3>{item.title}</h3><p>{item.meta}</p><b>Смотреть объект ↗</b></a>)}</div></div></section>
    <section class="av-section av-journal-articles" aria-labelledby="article-index-title"><div class="av-shell"><div class="av-heading"><div><p class="av-kicker">Технические материалы</p><h2 id="article-index-title">Условия, решения, стоимость</h2></div><a class="av-link" href="/blog/poleznye-stati/">Все полезные материалы →</a></div><div class="av-article-grid">{p0.map(item=><a href={item.href}><figure><img src={item.image} alt={item.imageAlt} width="720" height="480" loading="lazy" decoding="async"/></figure><span>{item.tag}</span><h3>{item.title}</h3><p>{item.text}</p><b>Читать статью ↗</b></a>)}</div><a class="av-journal-archive" href="/blog/detail/novoe-almaznoe-burenie/"><span>Ещё один материал</span><strong>Новое алмазное бурение</strong><b aria-hidden="true">↗</b></a></div></section>
  </article>
) : isPractical ? (
  <article class="practice-hub av-page av-journal-secondary">
    <section class="av-journal-opening" aria-label="Практические материалы и главный материал">
      <header class="av-journal-intro av-shell"><div><p class="av-kicker">Статьи / полезные материалы</p><h1>Практические материалы</h1></div><p class="av-lead">Проходки, материалы стен и условия работы. Технический опыт, полезный при подготовке монтажа вентиляции.</p></header>
      <section class="av-journal-lead" aria-label="Главный материал"><div class="av-shell"><a href={p0[0].href} class="av-journal-lead__link"><figure><img src={p0[0].image} alt={p0[0].imageAlt} width="800" height="600" loading="eager" decoding="async"/></figure><div><p class="av-kicker">Алмазное бурение · из практики</p><h2>{p0[0].title}</h2><p>{p0[0].text}</p><b>Читать статью ↗</b></div></a></div></section>
    </section>

    <section class="home-section practical-index">
      <div class="home-shell"><p class="section-index">01 / Практические статьи</p><h2>Алмазное бурение: практика и стоимость</h2>
        <div class="practical-index__grid">
          {p0.slice(1).map((item,index) => <a href={item.href}><img class="practical-index__photo" src={item.image} alt={item.imageAlt} width="720" height="480" loading="lazy" decoding="async"/><div class="practical-index__top"><span>{String(index+1).padStart(2,'0')}</span><b>{item.tag}</b></div><h3>{item.title}</h3><p>{item.text}</p><strong>Читать материал →</strong></a>)}
        </div>
      </div>
    </section>

    <section class="practical-rules">
      <div class="home-shell practical-rules__grid">
        <div><p class="section-index section-index--orange">02 / Подготовка к монтажу</p><h2>Какие вопросы стоит решить до начала работ.</h2></div>
        <div class="practical-rules__list">
          <div><span>01</span><p>Что известно о назначении помещений, режиме работы и требуемой системе.</p></div>
          <div><span>02</span><p>Какие планы, чертежи и фотографии объекта уже доступны.</p></div>
          <div><span>03</span><p>Где могут возникнуть сложности с трассами, доступом или существующей отделкой.</p></div>
          <div><span>04</span><p>Какие вопросы необходимо согласовать до выхода монтажников.</p></div>
        </div>
      </div>
    </section>

    <section class="home-section practical-next">
      <div class="home-shell practical-next__grid">
        <a href="/faq/"><span>До монтажа</span><h3>Вопросы до начала монтажа</h3><p>Документы, состав работ, смета и приёмка — ответы на частые вопросы.</p><b>Открыть FAQ →</b></a>
        <a href="/blog/istorii-proektov/"><span>Объекты</span><h3>Истории реальных объектов</h3><p>Выполненные работы, инженерные задачи и фотографии объектов.</p><b>Смотреть объекты →</b></a>
      </div>
    </section>
  </article>
) : isStories ? (
  <article class="practice-hub av-page av-journal-secondary">
    <section class="av-journal-opening" aria-label="Истории объектов и ведущий кейс">
      <header class="av-journal-intro av-shell"><div><p class="av-kicker">Статьи / истории объектов</p><h1>Истории объектов</h1></div><p class="av-lead">Задачи и выполненные работы: квартиры, жилые комплексы, рестораны и производство.</p></header>
      <section class="av-journal-lead" aria-label="Ведущий кейс"><div class="av-shell"><a href={cases[0].href} class="av-journal-lead__link"><figure><img src={cases[0].image} alt={cases[0].imageAlt} width="1200" height="900" loading="eager" decoding="async"/></figure><div><p class="av-kicker">Монтаж вентиляции · жилой комплекс</p><h2>{cases[0].title}</h2><p>{cases[0].meta}. Виды здания и фотографии монтажных работ.</p><b>Смотреть объект ↗</b></div></a></div></section>
    </section>

    <section class="home-section story-index">
      <div class="home-shell"><p class="section-index">01 / Выполненные объекты</p><h2>Квартиры, жилые дома, кафе и производство.</h2>
        <div class="story-index__grid">
          {cases.slice(1).map((item,index) => <a href={item.href}>{item.image && <img class="story-index__photo" src={item.image} alt={item.imageAlt} width="800" height="450" loading="lazy" decoding="async" />}<div><span>{String(index+1).padStart(2,'0')}</span><b>{item.tag}</b></div><h3>{item.title}</h3><p>{item.meta}</p><strong>Смотреть объект →</strong></a>)}
        </div>
      </div>
    </section>

    <section class="av-close"><div class="av-shell av-close__grid"><div><p class="av-kicker">Похожая задача</p><h2>Обсудим монтаж на вашем объекте</h2></div><a class="button button--primary" href="/contact/" data-contact-open data-source="stories_final" aria-haspopup="dialog">Связаться с командой →</a></div></section>
  </article>
) : null}

<style>
.practical-index__photo{display:block;width:100%;height:auto;aspect-ratio:1.65;object-fit:contain;margin-bottom:18px;filter:saturate(.9)}
.practical-index__grid a{overflow:hidden}
.story-index__photo{object-fit:cover}
</style>
