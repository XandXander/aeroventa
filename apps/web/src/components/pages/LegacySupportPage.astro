---
import { SITE } from '@/lib/site';
import type { ContentRecord } from '@/lib/types';
interface Props { content: ContentRecord; fixture: boolean; }
const { content } = Astro.props;

type Card = { tag:string; title:string; text:string; href:string };
type Spec = {
  eyebrow:string;
  lede:string;
  state:string;
  stateText:string;
  sections?: Array<{index:string;title:string;text:string;items?:string[]}>;
  cards?: Card[];
  closeTitle:string;
  closeText:string;
  closeHref:string;
  closeLabel:string;
};

const p0Cards: Card[] = [
  {tag:'Полевой опыт',title:'Застрявшая алмазная коронка',text:'Причины заклинивания, безопасная последовательность и исторический field note.',href:'/blog/detail/kak-vytashchit-zastryavshuyu-koronku-iz-betona/'},
  {tag:'Реальный объект',title:'Бурение в стяжке под стояки',text:'Слоистое перекрытие, крепление, отделка и исходные данные.',href:'/blog/detail/almaznoe-burenie-v-styazhke-pod-stoyaki-otopleniya/'},
  {tag:'Стоимость',title:'От чего зависит цена бурения',text:'Геометрия, материал, доступ, защита и состав работ — без старого прайса.',href:'/blog/detail/stoimost-almaznogo-bureniya-kak-rasschitat-tsenu/'},
  {tag:'Вентиляция',title:'Проходка стены под вентиляцию',text:'Почему сначала определяют трассу и узел, а уже потом отверстие.',href:'/blog/detail/gorizontalnoe-almaznoe-burenie/'},
];

const caseCards: Card[] = [
  {tag:'2020',title:'7 PARK',text:'7 домов · Павловск · монтаж приточно-вытяжной вентиляции.',href:'/blog/detail/kak-my-sdali-7-domov/'},
  {tag:'2021',title:'Ресторан в ЖК «Леонтьевский Мыс»',text:'Приточно-вытяжная вентиляция + оборудование.',href:'/blog/detail/restoran-v-zhk-leontevskiy-mys/'},
  {tag:'2017–2018',title:'НТФФ «Полисан»',text:'Фармацевтический объект · вентиляция + оборудование.',href:'/blog/detail/ntff-polisan/'},
  {tag:'2019',title:'Квартира на Маршала Жукова',text:'Жилой объект · приточно-вытяжная вентиляция.',href:'/blog/detail/kvartira-na-zhukova/'},
  {tag:'2022',title:'Питкяранта / Карелия',text:'Сервисно-образовательный центр · вентиляция + оборудование.',href:'/blog/detail/montazh-ventilyatsii-v-karelii/'},
];

const specs: Record<string, Spec> = {
  '/almaznoe-burenie/': {
    eyebrow:'Смежная работа / практический архив',
    lede:'Алмазное бурение остаётся частью инженерной базы AEROVENTA, но сегодня это не основное направление собственной монтажной команды. Отдельные буровые задачи рассматриваем как смежные и при необходимости координируем с профильными исполнителями.',
    state:'Текущая модель',
    stateText:'Основная собственная услуга AEROVENTA — монтаж вентиляции. Алмазное бурение рассматриваем как смежную работу и при необходимости координируем с профильным исполнителем.',
    sections:[
      {index:'01',title:'Когда проходка связана с вентиляцией',text:'Если отверстие нужно под воздуховод, оборудование или вентиляционный узел, сначала определяем трассу и геометрию системы. Иначе можно качественно пробурить отверстие, которое окажется не там или не того размера.',items:['Проект / узел вентиляции, если есть.','Материал и толщина конструкции.','Требуемый диаметр / габарит соединения.','Фото обеих сторон, высота и доступ.']},
      {index:'02',title:'Когда задача только про бурение',text:'Такую заявку не выдаём за собственный основной сервис. Можно передать исходные данные, после чего определим, можем ли скоординировать профильного исполнителя.',items:['Количество отверстий.','Диаметры и глубина.','Материал конструкции.','Локация и условия доступа.']},
      {index:'03',title:'Почему старые статьи остаются',text:'В истории AEROVENTA был период собственного алмазного бурения. Поэтому сохранился реальный полевой материал — он полезен и сейчас, если отделить практическую механику от старых цен и коммерческих заявлений.'}
    ],
    cards:p0Cards,
    closeTitle:'Нужна проходка именно под вентиляцию?',
    closeText:'По готовой документации пришлите узел или лист. На ранней стадии покажите конструкцию и задачу — сначала определим, что должно пройти через отверстие.',
    closeHref:'/contact/?intent=project',
    closeLabel:'Показать задачу →'
  },
  '/blog/detail/novoe-almaznoe-burenie/': {
    eyebrow:'История AEROVENTA / алмазное бурение',
    lede:'Эта retained-страница относится к историческому периоду, когда AEROVENTA развивала собственное направление алмазного бурения. Сохраняем контекст и ссылочную ценность, но не превращаем старую историю в текущую услугу.',
    state:'Исторический материал',
    stateText:'Старое утверждение “новое направление” больше не описывает текущую структуру бизнеса. Сегодня основное собственное направление — монтаж вентиляции; отдельное бурение относится к смежным работам с профильным исполнителем.',
    sections:[
      {index:'01',title:'Что сохраняем',text:'Сам факт исторического собственного опыта и практическую базу, которая дала сильные практические статьи о конкретных проблемах.',items:['Полевой опыт с коронками и установками.','Понимание факторов стоимости и условий объекта.','Связь проходок с вентиляционными трассами.']},
      {index:'02',title:'Что не переносим',text:'Не возвращаем старые цены, старый продающий призыв и формулировку, будто алмазное бурение сейчас является приоритетным прямым направлением AEROVENTA.'},
      {index:'03',title:'Что полезно сегодня',text:'Исторический опыт остаётся полезным там, где бурение является частью вентиляционной задачи: сначала трасса и узел, затем проходка.'}
    ],
    cards:p0Cards,
    closeTitle:'Ищете текущую услугу?',
    closeText:'Для отдельного бурения смотрите текущую модель смежной работы. Для вентиляционного объекта — начинайте с проекта или описания задачи.',
    closeHref:'/almaznoe-burenie/',
    closeLabel:'Алмазное бурение сегодня →'
  },
  '/vakansii/': {
    eyebrow:'Работа / сотрудничество',
    lede:'Актуальные вакансии публикуем только тогда, когда конкретная позиция действительно открыта. Не сохраняем старые объявления как будто они всё ещё действуют.',
    state:'Только актуальная информация',
    stateText:'Сейчас эта страница не подтверждает наличие открытой штатной вакансии. Она остаётся retained route для актуальных предложений о работе и сотрудничестве.',
    sections:[
      {index:'01',title:'Кого имеет смысл писать',text:'Если вы работаете с монтажом вентиляции и хотите предложить сотрудничество, можно коротко прислать опыт и географию работы.',items:['Какие системы и объекты монтировали.','Опыт с воздуховодами / оборудованием / крупными объектами.','Город и готовность к выездам.','Контакт для связи.']},
      {index:'02',title:'Чего мы не обещаем на этой странице',text:'Не публикуем неактуальные зарплаты, графики и условия из старого Bitrix. Конкретные условия обсуждаются только под реально открытую роль или задачу.'}
    ],
    closeTitle:'Хотите предложить сотрудничество?',
    closeText:'Отправьте краткое описание опыта на общий e-mail AEROVENTA. Это не обещание открытой вакансии, а нормальный канал для профессионального контакта.',
    closeHref:`mailto:${SITE.email}?subject=${encodeURIComponent('AEROVENTA — предложение о сотрудничестве')}`,
    closeLabel:'Написать на e-mail →'
  },
  '/news/': {
    eyebrow:'Архив / история компании',
    lede:'Сохранённый URL старого раздела новостей. Новый сайт не будет имитировать постоянный “новостной поток” ради активности: сюда попадают только проверяемые материалы о компании и объектах.',
    state:'Тихий архив',
    stateText:'Главные текущие источники — Практика, реальные объекты и страницы услуг. Маршрут /news/ сохраняется как архив старого URL.',
    cards:[
      {tag:'История',title:'История компании',text:'Фактическая линия через подтверждённые объекты, без рекламных счётчиков.',href:'/news/istoriya-kompanii/'},
      {tag:'Объекты',title:'Истории объектов',text:'Канонические кейсы AEROVENTA без дублирования страниц.',href:'/blog/istorii-proektov/'},
      {tag:'Практика',title:'Практические материалы',text:'Инженерные вопросы и практический опыт решения задач.',href:'/blog/'},
      {tag:'Архив',title:'Значимые события',text:'Только то, что можно связать с подтверждённым фактом или объектом.',href:'/news/znachimye-sobytiya/'}
    ],
    closeTitle:'Нужна текущая информация?',
    closeText:'Для текущего состава работ и объектов используйте Услуги, Практику и Портфолио.',
    closeHref:'/services/',
    closeLabel:'Текущие услуги →'
  },
  '/news/korporativnaya-zhizn/': {
    eyebrow:'Архив компании',
    lede:'У этой архивной страницы нет достаточно содержательного старого текста, чтобы честно «восстановить» прежнюю корпоративную страницу. Поэтому не придумываем офисные новости, праздники и командные истории.',
    state:'Минимальная архивная страница',
    stateText:'Маршрут сохраняется для URL continuity. Реальную культуру компании показываем через способ работы, объекты и подтверждённую историю — не через искусственный корпоративный контент.',
    cards:[
      {tag:'Как работаем',title:'Команда и принцип работы',text:'Постоянное ядро + проверенное усиление под объект.',href:'/about/'},
      {tag:'Проекты',title:'Реальные объекты',text:'Факты вместо корпоративной витрины.',href:'/portfolio/'},
      {tag:'Практика',title:'Материалы с площадки',text:'Полевой опыт и инженерные решения.',href:'/blog/'}
    ],
    closeTitle:'Что сейчас важнее корпоративных новостей.',
    closeText:'Текущая работа AEROVENTA лучше видна по проектам и практическим материалам.',
    closeHref:'/portfolio/',
    closeLabel:'Смотреть объекты →'
  },
  '/news/istoriya-kompanii/': {
    eyebrow:'История AEROVENTA',
    lede:'Не собираем историю компании из неподтверждённых цифр и старых рекламных счётчиков. Используем только объекты и даты, которые сохранились в собственных источниках.',
    state:'Фактическая линия',
    stateText:'История здесь — не “мы на рынке N лет”, а последовательность конкретных работ, которые можно открыть и проверить.',
    cards:caseCards,
    closeTitle:'Продолжить по объектам.',
    closeText:'Каждая точка этой линии ведёт на существующий канонический кейс, а не на новый пересказ.',
    closeHref:'/portfolio/',
    closeLabel:'Все объекты →'
  },
  '/news/znachimye-sobytiya/': {
    eyebrow:'Архив / значимые события',
    lede:'Старый URL сохраняется, но значимым событием считаем только то, что можно подтвердить объектом, датой или другим собственным источником. Не переносим старые health/news заявления как текущую экспертную позицию.',
    state:'Архив по подтверждённым фактам',
    stateText:'Вместо абстрактных достижений — несколько доказанных вех из истории объектов.',
    cards:[
      {tag:'2017–2018',title:'НТФФ «Полисан»',text:'Длительный производственный / фармацевтический объект.',href:'/blog/detail/ntff-polisan/'},
      {tag:'2020',title:'7 PARK',text:'Интенсивная фаза монтажа в семи домах Павловска.',href:'/blog/detail/kak-my-sdali-7-domov/'},
      {tag:'2021',title:'Ресторан в «Леонтьевском Мысе»',text:'Подтверждённый ресторанный объект в Санкт-Петербурге.',href:'/blog/detail/restoran-v-zhk-leontevskiy-mys/'},
      {tag:'2022',title:'Питкяранта, Карелия',text:'Подтверждённая работа за пределами основной географии.',href:'/blog/detail/montazh-ventilyatsii-v-karelii/'}
    ],
    closeTitle:'Факты подробнее — в кейсах.',
    closeText:'Не используем архивную страницу для новых рекламных заявлений.',
    closeHref:'/portfolio/',
    closeLabel:'Раздел доказательств →'
  },
  '/blog/obzory-i-intervyu/': {
    eyebrow:'Практика / архивный раздел',
    lede:'Старое название рубрики сохраняется в адресе страницы, но не заставляет новый сайт выдумывать интервью и обзоры. Используем маршрут как дополнительный вход к сильным практическим материалам.',
    state:'Архивный раздел',
    stateText:'Содержательная ценность — в конкретных статьях, а не в старом названии категории.',
    cards:p0Cards,
    closeTitle:'Перейти в текущую Практику.',
    closeText:'Все новые материалы проходят единую редакционную проверку доказательств.',
    closeHref:'/blog/',
    closeLabel:'Практика →'
  }
};

const spec=specs[content.path];
if(!spec) throw new Error('Support spec missing: '+content.path);
---

<article class="support-page">
  <header class="support-hero">
    <div class="home-shell support-hero__grid">
      <div><p class="home-kicker">{spec.eyebrow}</p><h1>{content.h1}</h1></div>
      <div><p class="support-hero__lede">{spec.lede}</p><div class="support-state"><span>{spec.state}</span><p>{spec.stateText}</p></div></div>
    </div>
  </header>

  {spec.sections && (
    <div class="support-sections">
      {spec.sections.map((section) => (
        <section class="support-section">
          <div class="home-shell support-section__grid">
            <div><p class="section-index">{section.index}</p><h2>{section.title}</h2></div>
            <div><p class="support-section__text">{section.text}</p>{section.items && <ul>{section.items.map(item => <li>{item}</li>)}</ul>}</div>
          </div>
        </section>
      ))}
    </div>
  )}

  {spec.cards && (
    <section class="home-section support-cards">
      <div class="home-shell">
        <p class="section-index">Материалы и факты</p>
        <h2 class="sr-only">Материалы и факты</h2>
        <div class="support-cards__grid">
          {spec.cards.map((item,index) => <a href={item.href}><span>{String(index+1).padStart(2,'0')} / {item.tag}</span><h3>{item.title}</h3><p>{item.text}</p><b>Открыть →</b></a>)}
        </div>
      </div>
    </section>
  )}

  <section class="conversion-close">
    <div class="home-shell">
      <p class="section-index section-index--orange">Следующий шаг</p>
      <h2>{spec.closeTitle}</h2>
      <p class="support-close-copy">{spec.closeText}</p>
      <a class="button button--light" href={spec.closeHref}>{spec.closeLabel}</a>
    </div>
  </section>
</article>
