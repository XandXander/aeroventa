---
import { SITE } from '@/lib/site';
import verifiedArchive from '../../../../../migration/bitrix-verified-articles-20260817.json';
import type { ContentRecord } from '@/lib/types';
interface Props { content: ContentRecord; fixture: boolean; }
const { content } = Astro.props;
const originalArticle=content.path==='/blog/detail/novoe-almaznoe-burenie/'
 ? verifiedArchive.articles.find(article=>article.route===content.path) : undefined;
if(content.path==='/blog/detail/novoe-almaznoe-burenie/'&&!originalArticle)throw new Error('Verified historical article source is required');

type Card = { tag:string; title:string; text:string; href:string };
type Spec = {
  eyebrow:string;
  lede:string;
  state:string;
  stateText:string;
  sections?: Array<{index:string;title:string;text:string;items?:string[]}>;
  cards?: Card[];
  closeTitle:string;
  closeText:string;
  closeHref:string;
  closeLabel:string;
};

const p0Cards: Card[] = [
  {tag:'Полевой опыт',title:'Застрявшая алмазная коронка',text:'Причины заклинивания, безопасная последовательность действий.',href:'/blog/detail/kak-vytashchit-zastryavshuyu-koronku-iz-betona/'},
  {tag:'Реальный объект',title:'Бурение в стяжке под стояки',text:'Слоистое перекрытие, крепление, отделка и исходные данные.',href:'/blog/detail/almaznoe-burenie-v-styazhke-pod-stoyaki-otopleniya/'},
  {tag:'Стоимость',title:'От чего зависит цена бурения',text:'Геометрия, материал, доступ, защита и состав работ — с учётом условий объекта.',href:'/blog/detail/stoimost-almaznogo-bureniya-kak-rasschitat-tsenu/'},
  {tag:'Вентиляция',title:'Проходка стены под вентиляцию',text:'Почему сначала определяют трассу и узел, а уже потом отверстие.',href:'/blog/detail/gorizontalnoe-almaznoe-burenie/'},
];

const caseCards: Card[] = [
  {tag:'2020',title:'7 PARK',text:'7 домов · Павловск · монтаж приточно-вытяжной вентиляции.',href:'/blog/detail/kak-my-sdali-7-domov/'},
  {tag:'2021',title:'Ресторан в ЖК «Леонтьевский Мыс»',text:'Приточно-вытяжная вентиляция + оборудование.',href:'/blog/detail/restoran-v-zhk-leontevskiy-mys/'},
  {tag:'2017–2018',title:'НТФФ «Полисан»',text:'Фармацевтический объект · вентиляция + оборудование.',href:'/blog/detail/ntff-polisan/'},
  {tag:'2019',title:'Квартира на Маршала Жукова',text:'Жилой объект · приточно-вытяжная вентиляция.',href:'/blog/detail/kvartira-na-zhukova/'},
  {tag:'2022',title:'Питкяранта / Карелия',text:'Сервисно-образовательный центр · вентиляция + оборудование.',href:'/blog/detail/montazh-ventilyatsii-v-karelii/'},
].sort((a,b)=>Number.parseInt(a.tag)-Number.parseInt(b.tag));

const specs: Record<string, Spec> = {
  '/almaznoe-burenie/': {
    eyebrow:'Алмазное бурение / смежные работы',
    lede:'Алмазное бурение остаётся частью инженерной базы AEROVENTA, но сегодня это не основное направление собственной монтажной команды. Отдельные буровые задачи рассматриваем как смежные и при необходимости координируем с профильными исполнителями.',
    state:'Смежные работы',
    stateText:'Основная собственная услуга AEROVENTA — монтаж вентиляции. Алмазное бурение рассматриваем как смежную работу и при необходимости координируем с профильным исполнителем.',
    sections:[
      {index:'01',title:'Когда проходка связана с вентиляцией',text:'Если отверстие нужно под воздуховод, оборудование или вентиляционный узел, сначала определяем трассу и геометрию системы. Иначе можно качественно пробурить отверстие, которое окажется не там или не того размера.',items:['Проект / узел вентиляции, если есть.','Материал и толщина конструкции.','Требуемый диаметр / габарит соединения.','Фото обеих сторон, высота и доступ.']},
      {index:'02',title:'Когда задача только про бурение',text:'Пришлите исходные данные по проходкам — уточним объём и возможность подключения профильного исполнителя.',items:['Количество отверстий.','Диаметры и глубина.','Материал конструкции.','Локация и условия доступа.']},
      {index:'03',title:'Практический опыт',text:'Ранее AEROVENTA выполняла алмазное бурение собственными силами. Технические материалы по оборудованию и проходкам помогают оценивать смежные работы при монтаже вентиляции.'}
    ],
    cards:p0Cards,
    closeTitle:'Нужна проходка именно под вентиляцию?',
    closeText:'По готовой документации пришлите узел или лист. На ранней стадии покажите конструкцию и задачу — сначала определим, что должно пройти через отверстие.',
    closeHref:'/contact/?intent=project',
    closeLabel:'Показать задачу →'
  },
  '/blog/detail/novoe-almaznoe-burenie/': {
    eyebrow:'История AEROVENTA / алмазное бурение',
    lede:'В прошлом AEROVENTA выполняла алмазное бурение собственными силами. Сегодня основное направление команды — монтаж вентиляции; необходимые проходки рассматриваем как смежную задачу с профильным исполнителем.',
    state:'Из практики компании',
    stateText:'Алмазное бурение ранее выполняли собственными силами. Сегодня основная работа команды — монтаж вентиляции; проходки при необходимости согласуем с профильным исполнителем.',
    sections:[
      {index:'01',title:'Практический опыт алмазного бурения',text:'Работа с алмазными коронками и буровыми установками дала практический опыт проходок в конструкциях здания.',items:['Полевой опыт с коронками и установками.','Понимание факторов стоимости и условий объекта.','Связь проходок с вентиляционными трассами.']},
      {index:'02',title:'Направление работы сегодня',text:'Основная услуга AEROVENTA — монтаж вентиляции. Отдельные буровые работы согласуем индивидуально с учётом возможностей профильного исполнителя.'},
      {index:'03',title:'Что полезно сегодня',text:'Исторический опыт остаётся полезным там, где бурение является частью вентиляционной задачи: сначала трасса и узел, затем проходка.'}
    ],
    cards:p0Cards,
    closeTitle:'Ищете текущую услугу?',
    closeText:'Для отдельного бурения смотрите текущую модель смежной работы. Для вентиляционного объекта — начинайте с проекта или описания задачи.',
    closeHref:'/almaznoe-burenie/',
    closeLabel:'Алмазное бурение сегодня →'
  },
  '/vakansii/': {
    eyebrow:'Работа / сотрудничество',
    lede:'Рассматриваем предложения о сотрудничестве от специалистов и монтажных бригад с опытом работы на вентиляционных объектах.',
    state:'Только актуальная информация',
    stateText:'Открытые штатные вакансии сейчас не заявлены. Специалисты и монтажные бригады могут направить предложение о сотрудничестве.',
    sections:[
      {index:'01',title:'Что рассказать о себе',text:'Если вы работаете с монтажом вентиляции и хотите предложить сотрудничество, коротко опишите опыт и географию работы.',items:['Какие системы и объекты монтировали.','Опыт с воздуховодами, оборудованием и крупными объектами.','Город и готовность к выездам.','Контакт для связи.']},
      {index:'02',title:'Формат сотрудничества',text:'Открытые задачи и условия сотрудничества обсуждаем с учётом вида работ, сроков и объёма.'}
    ],
    closeTitle:'Хотите предложить сотрудничество?',
    closeText:'Напишите на корпоративную почту: ваш опыт, примеры выполненных работ, город и контакт для ответа.',
    closeHref:`mailto:${SITE.email}?subject=${encodeURIComponent('AEROVENTA — предложение о сотрудничестве')}`,
    closeLabel:'Написать на e-mail →'
  },
  '/news/': {
    eyebrow:'AEROVENTA / история компании',
    lede:'История AEROVENTA через выполненные проекты, инженерные задачи и развитие направления монтажа вентиляции.',
    state:'История компании',
    stateText:'Посмотрите выполненные проекты, принципы нашей работы и технические статьи.',
    cards:[
      {tag:'История',title:'История компании',text:'Проекты компании и основные этапы работы.',href:'/news/istoriya-kompanii/'},
      {tag:'Объекты',title:'Истории объектов',text:'Объекты, монтажные задачи и фотографии.',href:'/blog/istorii-proektov/'},
      {tag:'Практика',title:'Практические материалы',text:'Инженерные вопросы и практический опыт решения задач.',href:'/blog/'},
      {tag:'История',title:'Значимые события',text:'Работы и события в разные годы.',href:'/news/znachimye-sobytiya/'}
    ],
    closeTitle:'Нужна текущая информация?',
    closeText:'Для текущего состава работ и объектов используйте Услуги, Практику и Портфолио.',
    closeHref:'/services/',
    closeLabel:'Текущие услуги →'
  },
  '/news/korporativnaya-zhizn/': {
    eyebrow:'Компания / команда и проекты',
    lede:'Работу AEROVENTA показываем через выполненные объекты, инженерные задачи и команду.',
    state:'Люди и проекты',
    stateText:'Познакомьтесь с командой, нашим подходом к монтажу и объектами, на которых работали специалисты AEROVENTA.',
    cards:[
      {tag:'Как работаем',title:'Команда и принцип работы',text:'Постоянное ядро + проверенное усиление под объект.',href:'/about/'},
      {tag:'Проекты',title:'Реальные объекты',text:'Фотографии объектов и состав выполненных работ.',href:'/portfolio/'},
      {tag:'Практика',title:'Материалы с площадки',text:'Полевой опыт и инженерные решения.',href:'/blog/'}
    ],
    closeTitle:'Узнайте больше о наших проектах',
    closeText:'Текущая работа AEROVENTA лучше видна по проектам и практическим материалам.',
    closeHref:'/portfolio/',
    closeLabel:'Смотреть объекты →'
  },
  '/news/istoriya-kompanii/': {
    eyebrow:'История AEROVENTA',
    lede:'В истории компании — монтаж вентиляции в жилых домах, коммерческих помещениях и на производственных площадках.',
    state:'Хронология работ',
    stateText:'Основные этапы представлены через объекты с известными периодами выполнения работ.',
    cards:caseCards,
    closeTitle:'Продолжить по объектам.',
    closeText:'Изучите фотографии и состав работ в разделе портфолио.',
    closeHref:'/portfolio/',
    closeLabel:'Все объекты →'
  },
  '/news/znachimye-sobytiya/': {
    eyebrow:'История компании / проекты',
    lede:'Несколько проектов из истории AEROVENTA: промышленная вентиляция, жилые здания, ресторан и объект в Карелии.',
    state:'Проекты разных лет',
    stateText:'Посмотрите подробности выполненных работ и фотографии по каждому объекту.',
    cards:[
      {tag:'2017–2018',title:'НТФФ «Полисан»',text:'Длительный производственный / фармацевтический объект.',href:'/blog/detail/ntff-polisan/'},
      {tag:'2020',title:'7 PARK',text:'Интенсивная фаза монтажа в семи домах Павловска.',href:'/blog/detail/kak-my-sdali-7-domov/'},
      {tag:'2021',title:'Ресторан в «Леонтьевском Мысе»',text:'Монтаж вентиляции ресторана в Санкт-Петербурге.',href:'/blog/detail/restoran-v-zhk-leontevskiy-mys/'},
      {tag:'2022',title:'Питкяранта, Карелия',text:'Монтаж систем вентиляции в Карелии.',href:'/blog/detail/montazh-ventilyatsii-v-karelii/'}
    ],
    closeTitle:'Подробнее о проектах',
    closeText:'Подробности по объектам представлены в портфолио.',
    closeHref:'/portfolio/',
    closeLabel:'Смотреть объекты →'
  },
  '/blog/obzory-i-intervyu/': {
    eyebrow:'Технические статьи',
    lede:'Практические материалы о проходках, буровом оборудовании и инженерных задачах на объектах.',
    state:'Практические материалы',
    stateText:'Статьи о реальных технических ситуациях, подготовке и выполнении работ.',
    cards:p0Cards,
    closeTitle:'Все технические статьи',
    closeText:'Откройте другие материалы и истории выполненных объектов.',
    closeHref:'/blog/',
    closeLabel:'Практика →'
  }
};

const cardPhotos: Record<string, string> = {
  '/blog/detail/kak-my-sdali-7-domov/':'/evidence/7park/object-exterior-day.jpg',
  '/blog/detail/restoran-v-zhk-leontevskiy-mys/':'/evidence/leont/owner-cover-v43.webp',
  '/blog/detail/ntff-polisan/':'/evidence/polisan/owner-cover-v43.webp',
  '/blog/detail/kvartira-na-zhukova/':'/evidence/zhukov/owner-cover-v43.webp',
  '/blog/detail/montazh-ventilyatsii-v-karelii/':'/evidence/karelia/object-exterior.jpg',
  '/blog/detail/kak-vytashchit-zastryavshuyu-koronku-iz-betona/':'/upload/medialibrary/548/5488fb415056eee52ac63ff9d4850c63.jpg',
  '/blog/detail/almaznoe-burenie-v-styazhke-pod-stoyaki-otopleniya/':'/upload/medialibrary/0a2/0a2f0d1be2900e0a1fe74bcd9604e3f8.jpg',
  '/blog/detail/stoimost-almaznogo-bureniya-kak-rasschitat-tsenu/':'/upload/medialibrary/fb3/fb3d693282a8085971dd4e2fe87bf28e.jpg',
  '/blog/detail/gorizontalnoe-almaznoe-burenie/':'/upload/medialibrary/e1c/e1cd51110183f9c6b2e704b70664eba1.jpg',
};
const isHistoryIndex = content.path === '/news/';
const spec=specs[content.path];
if(!spec) throw new Error('Support spec missing: '+content.path);
---

<article class:list={["support-page av-page av-support", {"av-support--history": isHistoryIndex}]}>
  <header class="support-hero">
    <div class="home-shell support-hero__grid">
      <div><p class="home-kicker">{spec.eyebrow}</p><h1>{content.h1}</h1></div>
      <div><p class="support-hero__lede">{spec.lede}</p>{!originalArticle && !isHistoryIndex && <div class="support-state"><span>{spec.state}</span><p>{spec.stateText}</p></div>}</div>
      {isHistoryIndex && <a class="support-history-feature" href="/blog/detail/montazh-ventilyatsii-v-karelii/">
        <figure><img src="/evidence/karelia/owner-cover-v43.webp" width="1200" height="800" alt="Сервисно-образовательный центр PONSSE в Питкяранте — выполненный объект AEROVENTA" loading="eager" decoding="async" /></figure>
        <div><p class="home-kicker">Из истории компании · 2022</p><h2>Монтаж вентиляции в Карелии</h2><p>Сервисно-образовательный центр PONSSE в Питкяранте. Фотографии работ и благодарственное письмо заказчика.</p><b>Читать историю объекта →</b></div>
      </a>}
    </div>
  </header>

  {originalArticle && <section class="home-section support-original" aria-labelledby="support-original-title">
    <div class="home-shell"><p class="section-index">Из истории компании</p><h2 id="support-original-title">Как появилось направление алмазного бурения</h2>
    <div class="prose" set:html={originalArticle.source_article_html_sanitized}/></div>
  </section>}

  {spec.sections && !originalArticle && (
    <div class="support-sections">
      {spec.sections.map((section) => (
        <section class="support-section">
          <div class="home-shell support-section__grid">
            <div><p class="section-index">{section.index}</p><h2>{section.title}</h2></div>
            <div><p class="support-section__text">{section.text}</p>{section.items && <ul>{section.items.map(item => <li>{item}</li>)}</ul>}</div>
          </div>
        </section>
      ))}
    </div>
  )}

  {spec.cards && (
    <section class="home-section support-cards">
      <div class="home-shell">
        <p class="section-index">Материалы по теме</p>
        <h2 class="sr-only">Материалы по теме</h2>
        <div class="support-cards__grid" data-card-count={spec.cards.length}>
          {spec.cards.map((item,index) => <a href={item.href}>{cardPhotos[item.href] && <img src={cardPhotos[item.href]} alt={item.title} width="800" height="450" loading="lazy" decoding="async" />}<span>{String(index+1).padStart(2,'0')} / {item.tag}</span><h3>{item.title}</h3><p>{item.text}</p><b>Открыть →</b></a>)}
        </div>
      </div>
    </section>
  )}

  <section class="conversion-close">
    <div class="home-shell">
      <p class="section-index section-index--orange">Следующий шаг</p>
      <h2>{spec.closeTitle}</h2>
      <p class="support-close-copy">{spec.closeText}</p>
      <a class="button button--light" href={spec.closeHref}>{spec.closeLabel}</a>
    </div>
  </section>
</article>

<style>
.av-support--history .support-hero__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:24px 64px;align-items:center;min-height:0}
.av-support--history .support-hero__grid>div{grid-column:1;min-width:0}
.av-support--history .support-hero__grid>div:first-child{align-self:end}.av-support--history .support-hero__grid>div:nth-child(2){align-self:start}
.support-history-feature{grid-column:2;grid-row:1/3;min-width:0;display:block;text-decoration:none;color:inherit}
.support-history-feature figure{margin:0 0 20px}.support-history-feature img{display:block;width:100%;height:clamp(180px,34svh,340px);object-fit:contain}
.support-history-feature h2{font-size:clamp(1.3rem,2.2vw,2rem);line-height:1.2;margin:10px 0 12px}.support-history-feature p:not(.home-kicker){font-size:.9rem;line-height:1.6;max-width:53ch}.support-history-feature b{display:inline-block;margin-top:14px;font-size:.85rem;font-weight:550}.support-history-feature:focus-visible{outline:2px solid #9d4329;outline-offset:5px}
@media(max-width:760px){.av-support--history .support-hero__grid{display:block}.av-support--history .support-hero{padding-block:26px 34px}.av-support--history .support-hero__lede{margin-block:18px 26px}.support-history-feature{margin-top:26px}.support-history-feature figure{margin-bottom:18px}.support-history-feature img{height:clamp(180px,29svh,250px)}.support-history-feature h2{font-size:1.45rem}}

.support-page .support-hero h1{font-size:clamp(2.15rem,4.1vw,3.8rem);line-height:1.12;max-width:24ch}
.support-original{background:#fff;color:#203a49}
.support-original>.home-shell{max-width:1180px}
.support-original .prose{max-width:74ch;margin-top:26px;font-size:1rem;line-height:1.8}
.support-original .prose :global(h2){font-size:clamp(1.2rem,2.3vw,1.65rem);line-height:1.45;max-width:48ch;margin-block:1.5em 1em;font-weight:550;letter-spacing:-.015em}
.support-original .prose :global(a){color:#245570;text-underline-offset:4px}
.support-original .prose :global(:is(b,i,u)){font:inherit;text-decoration:inherit}
</style>
