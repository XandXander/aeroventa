---
---
<header class="site-header">
  <div class="home-shell site-header__inner">
    <a class="brand" href="/" aria-label="AEROVENTA.RU — главная">
      <img class="brand-mark-locked" src="/brand/aeroventa-mark.svg" width="82" height="57" alt="" aria-hidden="true" />
      <span class="baseline-wordmark"><span class="brand-wordmark-tail">EROVENTA</span><span class="brand-domain">.RU</span></span>
    </a>

    <nav class="nav nav--desktop" aria-label="Основная навигация">
      <a href="/services/">Услуги</a>
      <a href="/portfolio/">Наши работы</a>
      <a href="/blog/">Статьи</a>
      <a href="/about/">О компании</a>
      <a href="/contact/">Контакты</a>
    </nav>
    <a class="header-project" href="/contact/" data-contact-open data-source="header" aria-haspopup="dialog">Обсудить задачу <span aria-hidden="true">→</span></a>
    <button type="button" class="consultant-launcher consultant-launcher--header" data-consultant-open data-source="persistent_launcher" aria-haspopup="dialog" aria-controls="aeroventa-consultant-dialog" aria-label="Открыть консультанта AEROVENTA">
  <span class="consultant-launcher__symbol" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11.5a8.5 8.5 0 0 1-8.5 8.5 9 9 0 0 1-4.1-1L3 20l1.1-4.1A8.5 8.5 0 1 1 20 11.5Z"/><path d="M8 11.5h8M8 14.5h5"/></svg></span>
  <span class="consultant-launcher__label">Консультант AEROVENTA</span>
</button>
    <details class="mobile-menu" data-mobile-menu>
      <summary aria-label="Открыть меню" aria-controls="aeroventa-mobile-nav"><span></span><span></span><span></span></summary>
      <nav id="aeroventa-mobile-nav" aria-label="Мобильная навигация">
        <a href="/services/">Услуги</a>
        <a href="/portfolio/">Наши работы</a>
        <a href="/blog/">Статьи</a>
        <a href="/about/">О компании</a>
        <a href="/contact/">Контакты</a>
        <a class="button button--primary" href="/contact/" data-contact-open data-source="mobile_menu" aria-haspopup="dialog">Обсудить задачу</a>
      </nav>
    </details>
  </div>
</header>

<script>
  const menu=document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  if(menu){
    const toggle=menu.querySelector<HTMLElement>('summary');
    const nav=menu.querySelector<HTMLElement>('nav');
    const sync=()=>{document.documentElement.classList.toggle('av-mobile-menu-open',menu.open);toggle?.setAttribute('aria-expanded',String(menu.open));toggle?.setAttribute('aria-label',menu.open?'Закрыть меню':'Открыть меню');if(menu.open)nav?.querySelector<HTMLElement>('a')?.focus({preventScroll:true})};
    menu.addEventListener('toggle',sync);
    document.addEventListener('keydown',e=>{if(e.key==='Escape'&&menu.open){e.preventDefault();menu.open=false;toggle?.focus({preventScroll:true})}});
    document.addEventListener('click',e=>{if(!menu.open||!(e.target instanceof Element))return;if(!menu.closest('header')?.contains(e.target))menu.open=false;else if(e.target.closest('[data-consultant-open]')){menu.open=false;}else if(e.target.closest('nav a')){menu.open=false;toggle?.focus({preventScroll:true})}});
    window.addEventListener('resize',()=>{if(window.innerWidth>1050&&menu.open)menu.open=false});
    sync();
  }
</script>
