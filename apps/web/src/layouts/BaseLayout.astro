---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import AirflowTracePulse from '@/components/AirflowTracePulse.astro';
import Telemetry from '@/components/Telemetry.astro';
import PremiumExperience from '@/components/PremiumExperience.astro';
import { canonicalUrl, jsonLd, robotsValue, serializeJsonLd } from '@/lib/seo';
import type { ContentRecord } from '@/lib/types';
import globalCssUrl from '@/styles/global.css?url';
import experienceCssUrl from '@/styles/experience.css?url';

interface Props { content: ContentRecord; }
const { content } = Astro.props;
const preview = import.meta.env.AEROVENTA_RELEASE_MODE === 'preview';
const canonical = canonicalUrl(content.path, content.canonical_override);
const robots = preview ? 'noindex,nofollow,noarchive,nosnippet' : robotsValue(content);
const schema = preview ? null : jsonLd(content);
// Controlled fallbacks for five historical HTML-200 routes. Approved Directus copy wins.
const retainedDescriptionFallback: Record<string, string> = {
  '/blog/detail/kak-vytashchit-zastryavshuyu-koronku-iz-betona/':
    'Застрявшая алмазная коронка в бетоне: причины заклинивания, безопасный порядок действий и архивный практический опыт AEROVENTA.',
  '/vakansii/':
    'Сотрудничество с AEROVENTA для специалистов по монтажу вентиляции: какой опыт сообщить и как связаться с командой. Актуальные вакансии уточняйте.',
  '/news/korporativnaya-zhizn/':
    'Архив корпоративных материалов AEROVENTA. Для знакомства с актуальными направлениями монтажа вентиляции и реальными объектами смотрите портфолио.',
  '/news/istoriya-kompanii/':
    'История AEROVENTA через архивные материалы, развитие направления вентиляции и ссылки на подтверждённые выполненные объекты.',
  '/faq/':
    'Ответы о монтаже вентиляции: подготовка проекта, сравнение смет, оборудование, воздуховоды, условия объекта, согласование изменений и приёмка.',
};
const seoDescription = content.seo_description?.trim() || retainedDescriptionFallback[content.path] || '';
const ogTitle = content.og_title || content.seo_title || content.title;
const ogDescription = content.og_description?.trim() || seoDescription;
const editorialOgFallback: Record<string, string> = {
  '/': '/evidence/hero/owner-luxury-airflow-20261010.png',
  '/services/': '/evidence/hero/engineering-ductwork.jpg',
  '/montazh-ventiliacii/': '/evidence/hero/hiend-engineering-visual-owner-v43.webp',
  '/portfolio/': '/evidence/7park/object-exterior-day.jpg',
  '/blog/detail/kak-my-sdali-7-domov/': '/evidence/7park/object-exterior-day.jpg',
  '/blog/detail/restoran-v-zhk-leontevskiy-mys/': '/evidence/leont/duct-installation-01.jpg',
  '/blog/detail/ntff-polisan/': '/evidence/polisan/duct-installation-01.jpg',
  '/blog/detail/kvartira-na-zhukova/': '/evidence/zhukov/duct-installation-01.jpg',
  '/blog/detail/montazh-ventilyatsii-v-karelii/': '/evidence/karelia/object-exterior.jpg',
  '/blog/detail/kafe-rimskogo-korsakova-3/': '/evidence/cafe/duct-installation-01.jpg',
};
const ogImageSource = content.og_image || editorialOgFallback[content.path];
const ogImage = ogImageSource ? new URL(ogImageSource, 'https://aeroventa.ru').toString() : null;
const yandexVerification = (import.meta.env.PUBLIC_YANDEX_WEBMASTER_VERIFICATION || '').trim();
const googleVerification = (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || '').trim();
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/onest-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={globalCssUrl} />
    <link rel="stylesheet" href={experienceCssUrl} />
    <title>{content.seo_title || content.title}</title>
    {seoDescription && <meta name="description" content={seoDescription} />}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {yandexVerification && <meta name="yandex-verification" content={yandexVerification} />}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <meta property="og:title" content={ogTitle} />
    {ogDescription && <meta property="og:description" content={ogDescription} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={['article', 'news'].includes(content.content_type) ? 'article' : 'website'} />
    <meta property="og:site_name" content="AEROVENTA" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={ogTitle} />
    {ogDescription && <meta name="twitter:description" content={ogDescription} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {schema && <script type="application/ld+json" set:html={serializeJsonLd(schema)}></script>}
  </head>
  <body class={preview ? 'draft-preview' : undefined}>
    <a class="skip-link" href="#main-content">К основному содержанию</a>
    {preview && (
      <div class="preview-banner" data-aeroventa-preview="draft" role="status">
        <strong>AEROVENTA DRAFT PREVIEW</strong>
        <span>Черновик из Directus. Не опубликован, не одобрен Owner и закрыт от индексации.</span>
      </div>
    )}
    <Telemetry />
    <Header />
    <AirflowTracePulse />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <PremiumExperience pagePath={content.path} />
  </body>
</html>
