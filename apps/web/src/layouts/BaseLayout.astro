---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { canonicalUrl, jsonLd, robotsValue, serializeJsonLd } from '@/lib/seo';
import type { ContentRecord } from '@/lib/types';
import '@/styles/global.css';

interface Props { content: ContentRecord; }
const { content } = Astro.props;
const canonical = canonicalUrl(content.path, content.canonical_override);
const robots = robotsValue(content);
const schema = jsonLd(content);
const ogTitle = content.og_title || content.seo_title || content.title;
const ogDescription = content.og_description || content.seo_description;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{content.seo_title || content.title}</title>
    {content.seo_description && <meta name="description" content={content.seo_description} />}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={ogTitle} />
    {ogDescription && <meta property="og:description" content={ogDescription} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={['article', 'news'].includes(content.content_type) ? 'article' : 'website'} />
    <meta property="og:site_name" content="AEROVENTA" />
    <script type="application/ld+json" set:html={serializeJsonLd(schema)}></script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
