---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import AirflowTracePulse from '@/components/AirflowTracePulse.astro';
import Telemetry from '@/components/Telemetry.astro';
import PremiumExperience from '@/components/PremiumExperience.astro';
import PonsseDocumentExperience from '@/components/PonsseDocumentExperience.astro';
import { canonicalUrl, jsonLd, robotsValue, serializeJsonLd } from '@/lib/seo';
import type { ContentRecord } from '@/lib/types';
import globalCssUrl from '@/styles/global.css?url';
import experienceCssUrl from '@/styles/experience.css?url';
import artCssUrl from '@/styles/sitewide-art-direction.css?url';

interface Props { content: ContentRecord; }
const { content } = Astro.props;
const preview = import.meta.env.AEROVENTA_RELEASE_MODE === 'preview';
const canonical = canonicalUrl(content.path, content.canonical_override);
// Staging sharing must point at staging assets, while the migration canonical
// remains the approved production URL. No arbitrary hosts or credentials.
const socialOrigin = (import.meta.env.PUBLIC_SOCIAL_ORIGIN || 'https://aeroventa.ru').trim();
if (!['https://aeroventa.ru', 'https://staging.aeroventa.ru'].includes(socialOrigin)) {
  throw new Error('PUBLIC_SOCIAL_ORIGIN must be an approved AEROVENTA HTTPS origin');
}
const socialUrl = new URL(new URL(canonical).pathname, socialOrigin).toString();
const sourceSha = import.meta.env.AEROVENTA_SOURCE_SHA?.trim();
if (sourceSha && !/^[0-9a-f]{40}$/.test(sourceSha)) throw new Error('Invalid AEROVENTA_SOURCE_SHA');
const robots = preview ? 'noindex,nofollow,noarchive,nosnippet' : robotsValue(content);
const schema = preview ? null : jsonLd(content);
// Controlled fallbacks for five historical HTML-200 routes. Approved Directus copy wins.
const retainedDescriptionFallback: Record<string, string> = {
  '/blog/detail/kak-vytashchit-zastryavshuyu-koronku-iz-betona/':
    'Застрявшая алмазная коронка в бетоне: причины заклинивания и последовательность действий из практики.',
  '/vakansii/':
    'Сотрудничество с AEROVENTA для специалистов по монтажу вентиляции: какой опыт сообщить и как связаться с командой. Актуальные вакансии уточняйте.',
  '/news/korporativnaya-zhizn/':
    'Команда и выполненные работы AEROVENTA: реальные объекты, особенности монтажа и инженерная практика.',
  '/news/istoriya-kompanii/':
    'История AEROVENTA: монтаж вентиляции на жилых, коммерческих и производственных объектах.',
  '/faq/':
    'Ответы о монтаже вентиляции: подготовка проекта, сравнение смет, оборудование, воздуховоды, условия объекта, согласование изменений и приёмка.',
};
const cleanPublicSummary = (text: string) => text.replace(/Исторический источник/gi,'Материал').replace(/Архивная публикация/gi,'Статья').replace(/Тихий архив/gi,'История компании').trim();
const seoDescription = cleanPublicSummary(content.seo_description?.trim() || retainedDescriptionFallback[content.path] || '');
const approvedSocial = content.status === 'published' && Boolean(content.owner_approved_at);
const ogTitle = (approvedSocial && content.og_title) || content.seo_title || content.title;
const ogDescription = cleanPublicSummary((approvedSocial && content.og_description?.trim()) || seoDescription);
const editorialOgFallback: Record<string, string> = {
  '/': '/evidence/hero/owner-luxury-airflow-20261010.png',
  '/services/': '/evidence/hero/services-owner-editorial-1774.webp',
  '/montazh-ventiliacii/': '/evidence/hero/hiend-engineering-visual-owner-v43.webp',
  '/portfolio/': '/evidence/leont/owner-cover-v43.webp',
  '/about/': '/evidence/team/owner-team-group-20261015.webp',
  '/montazh-po-proektu/': '/evidence/polisan/archive/20180601-133711.webp',
  '/obekty/proizvodstvo/': '/evidence/polisan/archive/20180601-133711.webp',
  '/obekty/kvartiry-i-doma/': '/evidence/residential/owner-neva-facade-20261016.jpg',
  '/obekty/restorany-i-kafe/': '/evidence/cafe/owner-interior-v43.webp',
  '/blog/': '/evidence/polisan/archive/20180601-133711.webp',
  '/blog/istorii-proektov/': '/evidence/leont/owner-cover-v43.webp',
  '/blog/poleznye-stati/': '/upload/medialibrary/548/5488fb415056eee52ac63ff9d4850c63.jpg',
  '/blog/obzory-i-intervyu/': '/evidence/polisan/archive/20180601-133720.webp',
  '/blog/detail/kak-vytashchit-zastryavshuyu-koronku-iz-betona/': '/upload/medialibrary/548/5488fb415056eee52ac63ff9d4850c63.jpg',
  '/blog/detail/almaznoe-burenie-v-styazhke-pod-stoyaki-otopleniya/': '/upload/medialibrary/0a2/0a2f0d1be2900e0a1fe74bcd9604e3f8.jpg',
  '/blog/detail/stoimost-almaznogo-bureniya-kak-rasschitat-tsenu/': '/upload/medialibrary/fb3/fb3d693282a8085971dd4e2fe87bf28e.jpg',
  '/blog/detail/gorizontalnoe-almaznoe-burenie/': '/upload/medialibrary/e1c/e1cd51110183f9c6b2e704b70664eba1.jpg',
  '/blog/detail/novoe-almaznoe-burenie/': '/upload/medialibrary/0a2/0a2f0d1be2900e0a1fe74bcd9604e3f8.jpg',
  '/almaznoe-burenie/': '/upload/medialibrary/e1c/e1cd51110183f9c6b2e704b70664eba1.jpg',
  '/contact/': '/evidence/team/owner-team-group-20261015.webp',
  '/faq/': '/evidence/hero/services-owner-editorial-1774.webp',
  '/privacy/': '/evidence/hero/owner-luxury-airflow-20261010.png',
  '/vakansii/': '/evidence/team/owner-team-group-20261015.webp',
  '/news/': '/evidence/team/owner-team-group-20261015.webp',
  '/news/istoriya-kompanii/': '/evidence/team/owner-team-group-20261015.webp',
  '/news/korporativnaya-zhizn/': '/evidence/team/owner-team-group-20261015.webp',
  '/news/znachimye-sobytiya/': '/evidence/polisan/archive/20180601-133711.webp',
  '/obekt-bez-gotovogo-proekta/': '/evidence/hero/project-not-ready-owner-concept-1672.webp',
  '/obekty/': '/evidence/leont/owner-cover-v43.webp',
  '/obekty/novostroyki/': '/evidence/owner-portfolio/akvilon-yanino/cover.webp',
  '/obekty/ofisy-i-kommerciya/': '/evidence/owner-portfolio/apart-hotel/cover.webp',
  '/obekty/sklady/': '/evidence/hero/services-owner-editorial-1774.webp',
  '/obekty/magaziny-i-sklady/': '/evidence/hero/services-owner-editorial-1774.webp',
  '/obekty/ofisy-i-kommercheskie-pomeshcheniya/': '/evidence/owner-portfolio/apart-hotel/cover.webp',
  '/obekty/novostroyki-i-zhilye-kompleksy/': '/evidence/owner-portfolio/akvilon-yanino/cover.webp',
  '/covid-pritochnaya-ventilacia/': '/evidence/hero/services-owner-editorial-1774.webp',
  '/blog/detail/kak-my-sdali-7-domov/': '/evidence/7park/object-exterior-day.jpg',
  '/blog/detail/restoran-v-zhk-leontevskiy-mys/': '/evidence/leont/owner-cover-v43.webp',
  '/blog/detail/ntff-polisan/': '/evidence/polisan/owner-cover-v43.webp',
  '/blog/detail/kvartira-na-zhukova/': '/evidence/zhukov/owner-cover-v43.webp',
  '/blog/detail/montazh-ventilyatsii-v-karelii/': '/evidence/karelia/object-exterior.jpg',
  '/blog/detail/kafe-rimskogo-korsakova-3/': '/evidence/cafe/owner-interior-v43.webp',
};
// Keep approved Directus social imagery, but never permit the rejected cafe
// visual back into the generic services link preview, even via older content.
const brandedShareCards: Record<string, string> = {
  '/':'home','/services/':'services','/montazh-ventiliacii/':'ventilation',
  '/portfolio/':'portfolio','/about/':'about','/contact/':'about',
  '/montazh-po-proektu/':'project','/blog/':'ventilation',
  '/blog/istorii-proektov/':'portfolio','/blog/detail/ntff-polisan/':'polisan',
  '/blog/detail/kak-my-sdali-7-domov/':'sevenpark',
  '/blog/detail/restoran-v-zhk-leontevskiy-mys/':'leont',
  '/blog/detail/montazh-ventilyatsii-v-karelii/':'ponsse',
  '/blog/detail/kvartira-na-zhukova/':'zhukov',
  '/blog/detail/kafe-rimskogo-korsakova-3/':'cafe',
  '/obekty/proizvodstvo/':'polisan','/obekty/kvartiry-i-doma/':'neva',
  '/obekty/novostroyki/':'akvilon','/obekty/novostroyki-i-zhilye-kompleksy/':'akvilon','/obekty/restorany-i-kafe/':'leont',
  '/obekty/':'portfolio',
  '/obekt-bez-gotovogo-proekta/':'discovery',
  '/portfolio/obekt/apart-hotel/':'apart-hotel',
  '/portfolio/obekt/eurospar-vo/':'eurospar-vo',
  '/portfolio/obekt/eurospar-sestroretsk/':'eurospar-sestroretsk',
  '/portfolio/obekt/college-obvodny/':'college',
  '/portfolio/obekt/novatech/':'novatech',
  '/portfolio/obekt/akvilon-yanino/':'akvilon',
  '/portfolio/obekt/himprom/':'himprom',
  '/portfolio/obekt/na-izluchine-nevy/':'neva',
  '/almaznoe-burenie/':'drill-horizontal',
  '/blog/poleznye-stati/':'articles','/blog/obzory-i-intervyu/':'project',
  '/blog/detail/kak-vytashchit-zastryavshuyu-koronku-iz-betona/':'drill-crown',
  '/blog/detail/almaznoe-burenie-v-styazhke-pod-stoyaki-otopleniya/':'drill-screed',
  '/blog/detail/stoimost-almaznogo-bureniya-kak-rasschitat-tsenu/':'drill-cost',
  '/blog/detail/gorizontalnoe-almaznoe-burenie/':'drill-horizontal',
  '/blog/detail/novoe-almaznoe-burenie/':'drill-screed',
  '/obekty/ofisy-i-kommerciya/':'apart-hotel',
  '/obekty/ofisy-i-kommercheskie-pomeshcheniya/':'apart-hotel',
  '/obekty/sklady/':'services','/obekty/magaziny-i-sklady/':'services',
  '/faq/':'services','/covid-pritochnaya-ventilacia/':'services',
  '/news/':'about','/news/istoriya-kompanii/':'about',
  '/news/korporativnaya-zhizn/':'about','/news/znachimye-sobytiya/':'project',
  '/vakansii/':'about','/privacy/':'home',
};
const brandedShareImage = brandedShareCards[content.path] ? '/share/' + brandedShareCards[content.path] + '.jpg' : null;
const rejectedServicesImage = content.path === '/services/' &&
  ['/evidence/cafe/owner-cover-v43.webp',
   'https://aeroventa.ru/evidence/cafe/owner-cover-v43.webp'].includes(content.og_image || '');
// Publicly approved Directus imagery wins unless it is the explicitly rejected services cover.
// Static fallback cards are deterministic 1200×630 images generated only from repository media.
const ogImageSource = rejectedServicesImage
  ? (brandedShareImage || editorialOgFallback['/services/'])
  : ((approvedSocial && content.og_image) || brandedShareImage || editorialOgFallback[content.path] || '/evidence/hero/services-owner-editorial-1774.webp');
const ogImageUrl = ogImageSource ? new URL(ogImageSource, 'https://aeroventa.ru') : null;
if (ogImageUrl && ['https://aeroventa.ru', 'https://staging.aeroventa.ru'].includes(ogImageUrl.origin)) {
  ogImageUrl.protocol = new URL(socialOrigin).protocol;
  ogImageUrl.host = new URL(socialOrigin).host;
}
const ogImage = ogImageUrl?.toString() || null;
const ogImageType = ogImage ? (/\.png(?:$|\?)/i.test(ogImage) ? 'image/png' : /\.jpe?g(?:$|\?)/i.test(ogImage) ? 'image/jpeg' : /\.webp(?:$|\?)/i.test(ogImage) ? 'image/webp' : null) : null;
const ogImageAlt = `AEROVENTA — ${content.h1 || content.title}`;
const yandexVerification = (import.meta.env.PUBLIC_YANDEX_WEBMASTER_VERIFICATION || '').trim();
const googleVerification = (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || '').trim();
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#ffffff" />
    {sourceSha && <meta name="aeroventa-source-sha" content={sourceSha} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/onest-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={globalCssUrl} />
    <link rel="stylesheet" href={experienceCssUrl} />
    <link rel="stylesheet" href={artCssUrl} />
    <title>{content.seo_title || content.title}</title>
    {seoDescription && <meta name="description" content={seoDescription} />}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {yandexVerification && <meta name="yandex-verification" content={yandexVerification} />}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <meta property="og:title" content={ogTitle} />
    {ogDescription && <meta property="og:description" content={ogDescription} />}
    <meta property="og:url" content={socialUrl} />
    <meta property="og:type" content={['article', 'news'].includes(content.content_type) ? 'article' : 'website'} />
    <meta property="og:site_name" content="AEROVENTA" />
    <meta property="og:locale" content="ru_RU" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:secure_url" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    {brandedShareImage && ogImageSource === brandedShareImage && <meta property="og:image:width" content="1200" />}
    {brandedShareImage && ogImageSource === brandedShareImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={ogTitle} />
    {ogDescription && <meta name="twitter:description" content={ogDescription} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={ogImageAlt} />}
    {schema && <script type="application/ld+json" set:html={serializeJsonLd(schema)}></script>}
  </head>
  <body class={preview ? 'draft-preview' : undefined}>
    <a class="skip-link" href="#main-content">К основному содержанию</a>
    {preview && (
      <div class="preview-banner" data-aeroventa-preview="draft" role="status">
        <strong>AEROVENTA DRAFT PREVIEW</strong>
        <span>Черновик из Directus. Не опубликован, не одобрен Owner и закрыт от индексации.</span>
      </div>
    )}
    <Telemetry />
    <Header />
    <AirflowTracePulse />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <PremiumExperience pagePath={content.path} />
    <PonsseDocumentExperience />
<script>
  // Native modality makes the page inert; wrap both Tab directions inside the
  // visible controls as well, including after dynamic consultant responses.
  document.querySelectorAll<HTMLDialogElement>('dialog').forEach(dialog => {
    dialog.addEventListener('keydown', event => {
      if (event.key !== 'Tab' || event.defaultPrevented || !dialog.open) return;
      const controls = Array.from(dialog.querySelectorAll<HTMLElement>(
        'a[href],button:not([disabled]),input:not([disabled]):not([type="hidden"]),select:not([disabled]),textarea:not([disabled]),summary,[tabindex]:not([tabindex="-1"])'
      )).filter(el => el.tabIndex >= 0 && el.getClientRects().length > 0 && getComputedStyle(el).visibility !== 'hidden');
      const first = controls[0], last = controls.at(-1);
      if (!first || !last) { event.preventDefault(); return; }
      if (!dialog.contains(document.activeElement) || (event.shiftKey ? document.activeElement === first : document.activeElement === last)) {
        event.preventDefault();
        (event.shiftKey ? last : first).focus();
      }
    });
  });
</script>
  </body>
</html>
