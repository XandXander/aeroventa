{
  "name": "aeroventa-platform",
  "private": true,
  "version": "0.1.0-implementation-t2",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "validate": "node scripts/validate-implementation.mjs && node scripts/generate-directus-import-plan.mjs && node scripts/validate-directus-readiness.mjs && node scripts/generate-directus-native-target-v11.mjs && node scripts/validate-directus-native-target-v11.mjs",
    "generate:hosting-rules": "node scripts/generate-hosting-rules.mjs",
    "build:web": "npm --workspace @aeroventa/web run build",
    "dev:web": "npm --workspace @aeroventa/web run dev",
    "validate:dist": "node scripts/validate-built-site.mjs",
    "directus:plan:generate": "node scripts/generate-directus-import-plan.mjs",
    "directus:plan:validate": "node scripts/validate-directus-readiness.mjs",
    "directus:preflight:local": "npm run directus:plan:generate && npm run directus:plan:validate",
    "directus:snapshot:readonly": "node scripts/directus-schema-readonly.mjs",
    "directus:snapshot:inspect": "node scripts/directus-schema-inspect-readonly.mjs",
    "directus:diff:readonly": "node scripts/directus-schema-diff-readonly.mjs",
    "directus:target:generate": "node scripts/generate-directus-native-target-v11.mjs",
    "directus:target:validate": "node scripts/validate-directus-native-target-v11.mjs"
  }
}
