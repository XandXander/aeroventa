  "invariants": [
    "content.path is unique and normalized",
    "production content requires status=published and owner_approved_at non-null",
    "sitemap_include implies robots_index=true and production-publishable state",
    "redirect source_path cannot collide with published content.path",
    "301 target_path must resolve to a retained 200 route",
    "LEGACY_ACQUISITION does not imply direct_execution=true",
    "/almaznoe-burenie/ service_details.direct_execution=false and fulfillment_model=partner",
    "/montazh-ventiliacii/ is PRIMARY_COMMERCIAL"
